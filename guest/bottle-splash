#!/usr/bin/env bash
# bottle-splash: a "please wait" card in the Portalistic window while Steam isn't there yet (an
# update of the Linux system, the work before Steam starts: copying game prefixes, moving games
# into a drive, setting games to Proton, DXVK), so the window isn't just black. The card is the
# Mac app's own (a notice of kind 2 through the screen server: the next one replaces the text,
# "-" takes it down); it goes when Steam's own window is up, or after 15 minutes.
#
#   bottle-splash show TEXT     the card with TEXT (again: just the new TEXT)
#   bottle-splash text TEXT     the same (kept for older callers)
#   bottle-splash until-steam   closes it once a Steam window appears (at most 15 minutes)
#   bottle-splash close
#
# BOTTLE_SPLASH=0 turns it off. (Until Oct 22 this was a zenity window on the VM's screen; the
# Mac app's card looks like the rest of the app, and shows even before the VM's desktop is up.)
set -u
D="${HOME}/.cache/steamos-bottle"
N="$D/notices"
PID="$D/splash.pid"
export DISPLAY="${DISPLAY:-:1}"
[[ "${BOTTLE_SPLASH:-1}" == 0 ]] && exit 0
mkdir -p "$N"

card() {  # $1 = text ("-": down). One file; a newer text replaces one the screen server hasn't read yet.
  local f="$N/splash.txt"
  printf '2 600\n%s\n' "$1" > "$f.tmp" && mv -f "$f.tmp" "$f"
}
steam_window() {  # Steam's own window is mapped (Big Picture or its desktop windows)
  command -v wmctrl >/dev/null || return 1
  wmctrl -lx 2>/dev/null | grep -qiE ' steamwebhelper\.| steam\.steam |Steam Big Picture Mode'
}
watcher_running() { local p; p="$(cat "$PID" 2>/dev/null)"; [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; }

case "${1:-}" in
  show|text)
    card "${2:-Starting Steam…}"
    # a watcher takes the card down when Steam's window is up, or after 15 minutes, whatever the caller does
    if ! watcher_running; then
      setsid -f bash -c '
        PID="$1"; echo $$ > "$PID"
        for i in $(seq 1 900); do
          sleep 1
          [ "$(cat "$PID" 2>/dev/null)" = "$$" ] || exit 0
          "$2" _steam-up && { sleep 2; "$2" close; exit 0; }
        done
        "$2" close' _ "$PID" "$0" </dev/null >/dev/null 2>&1
    fi
    ;;
  until-steam)
    :   # (the watcher started by show does this)
    ;;
  _steam-up)
    steam_window
    ;;
  close)
    card "-"
    rm -f "$PID"
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
