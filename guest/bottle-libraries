#!/usr/bin/env python3
"""bottle-libraries: Portalistic's game folders as Steam libraries.

Games can live outside the VM's disk: in a folder on the Mac (~/Games/Portalistic by default) or
on an external drive, as normal files there. The Mac shares each folder with the VM (a writable
Lima mount at /mnt/portalistic/NAME, set up when the VM starts), and this script makes each one a
Steam library. Steam then sees that drive's real free space, and an uninstalled game gives its
space straight back to the Mac.

  bottle-libraries sync      Steam must not be running (steam-arm64 runs this before it starts
                             Steam; Steam keeps these files in memory and writes them back when
                             it quits). For every shared folder:
                               * a steamapps folder, its libraryfolder.vdf, and an entry in
                                 Steam's libraryfolders.vdf, labelled as on the Mac;
                               * Steam's own tools found there (Proton, the Steam Linux Runtimes,
                                 FEX, redistributables) move to the VM's disk: they need a Linux
                                 file system (the Mac's ignores upper/lower case, and the
                                 runtimes have files that differ only in case);
                               * Proton's game prefixes (steamapps/compatdata: each game's
                                 Windows folder, thousands of small files) stay on the VM's disk:
                                 ~/.local/share/steamos-bottle/compatdata/NAME is mounted over the
                                 folder's steamapps/compatdata (until the VM stops; every Steam
                                 start does it again). Prefixes already in the folder are copied
                                 there first; the originals stay in the folder on the Mac, hidden
                                 under the mount. Writing them through the Mac share was slow (a
                                 first start took 9 minutes on a 2020 M1 MacBook Pro) and, on that
                                 Mac, some requests got lost and Proton waited forever (Oct 22).
                                 BOTTLE_LOCAL_PREFIXES=0 turns it off;
                             entries for folders the Mac no longer lists go (their games stay
                             in the folder); and the default library for new games (Steam's
                             "Make Default", LastInstallFolderIndex in each user's
                             localconfig.vdf) is the Mac's choice, unless it was changed in Steam
                             since then. A folder whose drive isn't connected keeps its entry
                             (Steam shows it as unavailable); while it's away, the Mac folder
                             (else the VM's disk) is the default.
  bottle-libraries status [--json]
                             each Steam library: where, free space, games, the default
  bottle-libraries tidy [--free NAME=BYTES ...]
                             the drives (see below): unused space given back to the Mac, the file
                             system sized to the Mac's free space (the watcher runs it)

Since Oct 22 a game folder is a drive: the Mac puts a sparse image "Portalistic Games.img" in the
folder and attaches it to the VM (Lima disk pg-NAME; the folder itself is shared at
/mnt/portalistic-folders/NAME). sync formats it btrfs once (label portalistic-NAME), mounts it at
/mnt/portalistic/NAME, keeps its file system at what's in it plus the Mac's free space minus 2 GB
(so Steam can't start a download the Mac can't hold), and moves the games the folder itself holds
into it once (rsync per game, three tries; the folder's copy goes once the game is in). On a 2020
M1 MacBook Pro the folder's share (virtio-fs) sometimes never answered a request and games hung;
a drive goes through virtio-blk, which never did. The Mac's libraries.json says "disk": true and
"free": BYTES per folder.

The Mac's list (written by `bottle library` on the Mac): ~/.config/steamos-bottle/libraries.json
  {"default": "mac", "stamp": "1791826000",
   "folders": [{"name": "mac", "label": "Mac", "path": "/Users/me/Games/Portalistic"}]}
"default" may also be "vm" (the VM's disk). "stamp" changes each time the default is chosen on
the Mac, which is how a choice made since then in Steam is told apart from an old one.
"""
import argparse
import json
import os
import random
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
STEAM = Path(os.environ.get("BOTTLE_STEAM_DIR", HOME / ".local/share/Steam"))
MOUNT_ROOT = Path(os.environ.get("BOTTLE_LIBRARY_ROOT", "/mnt/portalistic"))
FOLDER_ROOT = Path(os.environ.get("BOTTLE_FOLDER_ROOT", "/mnt/portalistic-folders"))   # the folders themselves, once they're drives
DISK_HEADER = b"PORTALISTIC-GAMES "   # the first bytes of a drive image the Mac made and the VM hasn't formatted yet
DISK_RESERVE = 2 * 10 ** 9             # the Mac keeps this much: the drive's file system is shrunk to the Mac's free space minus it
CONF = HOME / ".config/steamos-bottle/libraries.json"
STATE = HOME / ".config/steamos-bottle/libraries-state.json"
TESTING = os.environ.get("BOTTLE_LIBRARIES_TEST") == "1"   # folders count as shared without a mount
PREFIX_ROOT = Path(os.environ.get("BOTTLE_PREFIX_ROOT", HOME / ".local/share/steamos-bottle/compatdata"))
PREFIX_COPY_SECS = 120           # copying one game's prefix off the share (a lost request ends it)
PREFIX_BUDGET = 240              # all of it, before Steam starts: the rest waits for the next start
PREFIX_FAILS = HOME / ".config/steamos-bottle/prefix-copy-failed.json"   # app ID -> failed copies
PREFIX_ROOM = 2 * 10 ** 9        # what stays free on the VM's disk after the copies (its low-space banner starts under 3 GB)

# Steam's own tools, runtimes and redistributables (as in bottle-steamplay).
TOOL_APPIDS = {
    "228980",                                     # Steamworks Common Redistributables
    "1070560", "1391110", "1628350", "4185400",   # Steam Linux Runtime 1.0 / 2.0 / 3.0 / 4.0
    "1493710", "2180100",                         # Proton Experimental, Proton Hotfix
    "858280", "930400", "961940", "996510", "1054830", "1113280", "1245040", "1420170",
    "1580130", "1887720", "2348590", "2805730", "3658110",  # Proton 3.7 ... 10.0
    "250820", "1826330", "1161040",               # SteamVR, Proton EasyAntiCheat / BattlEye Runtime
    "3127680", "4183110",                         # FEX (the ARM64 client's x86 translator)
}
SKIP_NAMES = re.compile(r"^(proton|steam linux runtime|steamworks common redistributables|steamvr|fex)", re.I)


def say(*a):
    print(*a, flush=True)


# ------------------------------------------------------------------ VDF (Steam's text format)

def vdf_tokens(text):
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n":
            i += 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j + 1
        elif c in "{}":
            yield c
            i += 1
        elif c == '"':
            # kept exactly as written (escapes included): what isn't changed goes back as it was
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            yield text[i + 1:j]
            i = j + 1
        else:
            j = i
            while j < n and text[j] not in ' \t\r\n{}"':
                j += 1
            yield text[i:j]
            i = j


def vdf_parse(text):
    """A list of [key, value] pairs; a value is a string or another such list."""
    toks = list(vdf_tokens(text))
    pos = 0

    def block():
        nonlocal pos
        items = []
        while pos < len(toks):
            k = toks[pos]
            if k == "}":
                pos += 1
                return items
            pos += 1
            if pos < len(toks) and toks[pos] == "{":
                pos += 1
                items.append([k, block()])
            elif pos < len(toks):
                items.append([k, toks[pos]])
                pos += 1
        return items

    return block()


def vdf_esc(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')


def vdf_dump(items, depth=0):
    out, tab = [], "\t" * depth
    for k, v in items:
        if isinstance(v, list):
            out.append(f'{tab}"{k}"\n{tab}{{\n{vdf_dump(v, depth + 1)}{tab}}}\n')
        else:
            out.append(f'{tab}"{k}"\t\t"{v}"\n')
    return "".join(out)


def vdf_get(items, key):
    for k, v in items:
        if k.lower() == key.lower() and isinstance(v, list):
            return v
    return None


def vdf_value(items, key):
    for k, v in items or []:
        if k.lower() == key.lower() and isinstance(v, str):
            return v
    return None


def vdf_set(items, key, value):
    for kv in items:
        if kv[0].lower() == key.lower():
            kv[1] = value
            return
    items.append([key, value])


# ------------------------------------------------------------------ helpers

def steam_running():
    if TESTING:
        return os.environ.get("BOTTLE_LIBRARIES_TEST_STEAM") == "1"
    r = subprocess.run(["pgrep", "-f", "[s]teamrtarm64/steam( |$)"], capture_output=True)
    return r.returncode == 0


def shared(p):
    """The Mac shares this folder with the VM right now (its drive is there), or its drive is mounted."""
    if TESTING:
        return p.is_dir() and ((p / ".test-mounted").exists() or (p / ".test-disk-mounted").exists())
    return os.path.ismount(p)


def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_atomic(path, text, backup_suffix=None):
    if backup_suffix and path.is_file():
        b = path.with_name(path.name + backup_suffix)
        if not b.exists():
            shutil.copy2(path, b)
    tmp = path.with_name(path.name + ".bottle-tmp")
    tmp.write_text(text, encoding="utf-8", errors="surrogateescape")
    os.replace(tmp, path)


def gb(n):
    return f"{n / 1e9:.1f} GB"


def acf_info(acf):
    try:
        st = vdf_get(vdf_parse(acf.read_text(errors="replace")), "AppState") or []
    except OSError:
        return None
    return {"appid": vdf_value(st, "appid") or "", "name": vdf_value(st, "name") or "?",
            "installdir": vdf_value(st, "installdir") or "",
            "size": int(vdf_value(st, "SizeOnDisk") or 0)}


def is_tool(info, common):
    d = common / info["installdir"] if info["installdir"] else None
    return (info["appid"] in TOOL_APPIDS or bool(SKIP_NAMES.match(info["name"]))
            or (d is not None and ((d / "toolmanifest.vdf").is_file()
                                   or (d / "compatibilitytool.vdf").is_file())))


# ------------------------------------------------------------------ Steam's library list

class Libraries:
    """steamapps/libraryfolders.vdf (and its copy in config/, which Steam keeps the same)."""

    def __init__(self):
        self.main = STEAM / "steamapps/libraryfolders.vdf"
        self.copy = STEAM / "config/libraryfolders.vdf"
        src = self.main if self.main.is_file() else self.copy
        text = src.read_text(errors="replace") if src.is_file() else ""
        self.root = vdf_parse(text) if text else []
        self.block = vdf_get(self.root, "libraryfolders")
        if self.block is None:
            self.block = []
            self.root.append(["libraryfolders", self.block])
        self.before = vdf_dump(self.root)

    def entries(self):
        """[(index, block)] in order: the numbered entries."""
        return [(int(k), v) for k, v in self.block if k.isdigit() and isinstance(v, list)]

    def path_of(self, e):
        return vdf_value(e, "path") or ""

    def find(self, path):
        want = os.path.realpath(str(path))
        for i, e in self.entries():
            if os.path.realpath(self.path_of(e) or "/nonexistent") == want:
                return i, e
        return None, None

    def add(self, path, label, contentid):
        n = max([i for i, _ in self.entries()] + [-1]) + 1
        e = [["path", str(path)], ["label", vdf_esc(label)], ["contentid", contentid],
             ["totalsize", "0"], ["update_clean_bytes_tally", "0"],
             ["time_last_update_verified", "0"], ["apps", []]]
        self.block.append([str(n), e])
        return n

    def remove(self, index):
        self.block[:] = [kv for kv in self.block if kv[0] != str(index)]

    def renumber(self):
        """Steam numbers its libraries 0, 1, 2...: after a removal, close the gap.
        Returns {old index: new index}."""
        mapping, n = {}, 0
        for kv in self.block:
            if kv[0].isdigit() and isinstance(kv[1], list):
                mapping[int(kv[0])] = n
                kv[0] = str(n)
                n += 1
        return mapping

    def save(self):
        text = vdf_dump(self.root)
        if text == self.before:
            return False
        for f in (self.main, self.copy):
            if f.parent.is_dir():
                write_atomic(f, text, ".bottle-before-libraries")
        self.before = text
        return True


# ------------------------------------------------------------------ the default for new games

LIC_RE = re.compile(r'^\t"LastInstallFolderIndex"\t\t"(-?\d+)"\s*$')


def localconfigs():
    out = []
    for f in sorted((STEAM / "userdata").glob("*/config/localconfig.vdf")):
        out.append((f.parts[-3], f))
    return out


def read_default(path):
    """LastInstallFolderIndex at the top level of a localconfig.vdf (None: not set = 0)."""
    try:
        for line in path.read_text(encoding="utf-8", errors="surrogateescape").split("\n"):
            m = LIC_RE.match(line)
            if m:
                return int(m.group(1))
    except OSError:
        pass
    return None


def write_default(path, index):
    lines = path.read_text(encoding="utf-8", errors="surrogateescape").split("\n")
    new = f'\t"LastInstallFolderIndex"\t\t"{index}"'
    for i, line in enumerate(lines):
        if LIC_RE.match(line):
            if lines[i] == new:
                return False
            lines[i] = new
            break
    else:
        # right inside "UserLocalConfigStore" { (the top level)
        for i, line in enumerate(lines):
            if line.strip() == '"UserLocalConfigStore"':
                j = i + 1
                while j < len(lines) and lines[j].strip() != "{":
                    j += 1
                if j >= len(lines):
                    return False
                lines.insert(j + 1, new)
                break
        else:
            return False
    write_atomic(path, "\n".join(lines), ".bottle-before-libraries")
    return True


# ------------------------------------------------------------------ sync

def ensure_library_folder(root, label):
    """steamapps/ and libraryfolder.vdf in a shared folder; returns its contentid."""
    (root / "steamapps").mkdir(parents=True, exist_ok=True)
    lf = root / "libraryfolder.vdf"
    cid = None
    if lf.is_file():
        cid = vdf_value(vdf_get(vdf_parse(lf.read_text(errors="replace")), "libraryfolder") or [], "contentid")
    if not cid:
        cid = str(random.randrange(10 ** 18, 9 * 10 ** 18))
        write_atomic(lf, vdf_dump([["libraryfolder", [["contentid", cid], ["label", vdf_esc(label)]]]]))
    return cid


def move_tools(libs, root):
    """Steam's tools installed in a shared folder go to the VM's disk (library 0)."""
    src_apps, dst_apps = root / "steamapps", STEAM / "steamapps"
    moved = 0
    for acf in sorted(src_apps.glob("appmanifest_*.acf")):
        info = acf_info(acf)
        if not info or not is_tool(info, src_apps / "common"):
            continue
        name = f"{info['name']} ({info['appid']})"
        if (dst_apps / acf.name).exists():
            say(f"  {name} is in {root} and on the VM's disk; leaving the copy in {root} to Steam")
            continue
        need = info["size"] * 1.1 + 1e9
        if shutil.disk_usage(dst_apps).free < need:
            say(f"  {name}: not enough room on the VM's disk to move it there ({gb(need)})")
            continue
        say(f"  {name}: moving it from {root} to the VM's disk (Steam's tools need a Linux file system)…")
        try:
            if info["installdir"] and (src_apps / "common" / info["installdir"]).exists():
                (dst_apps / "common").mkdir(exist_ok=True)
                shutil.move(str(src_apps / "common" / info["installdir"]),
                            str(dst_apps / "common" / info["installdir"]))
            dl = src_apps / "downloading" / info["appid"]
            if dl.exists():
                (dst_apps / "downloading").mkdir(exist_ok=True)
                shutil.move(str(dl), str(dst_apps / "downloading" / info["appid"]))
            shutil.move(str(acf), str(dst_apps / acf.name))
        except OSError as e:
            say(f"  {name}: couldn't move it ({e}); Steam may install it again")
            continue
        moved += 1
        # Steam's cached app lists: from that library to the VM's disk
        apps = vdf_get(libs.find(root)[1] or [], "apps")
        if apps is not None:
            apps[:] = [kv for kv in apps if kv[0] != info["appid"]]
        apps = vdf_get(libs.find(STEAM)[1] or [], "apps")
        if apps is not None and not any(k == info["appid"] for k, _ in apps):
            apps.append([info["appid"], str(info["size"])])
    return moved


def bound(target):
    """Our mount is over this compatdata folder already."""
    if TESTING:
        return (target / ".test-bound").exists()
    return os.path.ismount(target)


def bind(src, target):
    if TESTING:
        if os.environ.get("BOTTLE_LIBRARIES_TEST_BINDFAIL") == "1":
            return False
        (target / ".test-bound").write_text(str(src))
        return True
    try:
        r = subprocess.run(["sudo", "-n", "mount", "--bind", str(src), str(target)],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and os.path.ismount(target)


def splash(text):
    """The text of bottle-splash's "please wait" window, if it's on."""
    if TESTING or not shutil.which("bottle-splash"):
        return
    try:
        subprocess.run(["bottle-splash", "text", text], timeout=5, capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        pass


def run_limited(cmd, secs):
    """A command on the share, killed if it doesn't finish (a lost request would hold it forever)."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=secs)
        return r.returncode, r.stdout
    except subprocess.TimeoutExpired:
        return None, ""
    except OSError:
        return 1, ""


def local_prefixes(mp, name, label):
    """Proton's prefixes for the games in a shared folder: on the VM's own disk (see the top)."""
    if os.environ.get("BOTTLE_LOCAL_PREFIXES", "1") == "0":
        return
    target = mp / "steamapps/compatdata"
    local = PREFIX_ROOT / name
    if disk_mounted(mp):
        # the folder is a drive (no lost requests there): prefixes live in it. Ones copied to the
        # VM's own disk by 0.7.0.8 go back into it, once.
        if local.is_dir() and any(local.iterdir()):
            target.mkdir(parents=True, exist_ok=True)
            rc, _ = sh(["rsync", "-a", "--", str(local) + "/", str(target) + "/"], 1800)
            if rc == 0:
                shutil.rmtree(local, ignore_errors=True)
                say(f"{label}: the games' prefixes are back in the game folder's drive")
        return
    if target.is_dir() and bound(target):
        return
    try:
        local.mkdir(parents=True, exist_ok=True)
        target.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        say(f"{label}: can't set up the prefix folders ({e}); prefixes stay in the folder this time")
        return
    rc, out = run_limited(["ls", "-1A", "--", str(target)], 20)
    if rc != 0:
        say(f"{label}: the folder's prefixes couldn't be listed; they stay there this time")
        return
    todo = [e for e in out.splitlines() if e and not e.startswith(".") and not (local / e).exists()]
    copied = []
    if todo:
        rc, out = run_limited(["du", "-sb", "--"] + [str(target / e) for e in todo], 60)
        size = sum(int(l.split()[0]) for l in out.splitlines() if l.split() and l.split()[0].isdigit()) if rc == 0 else None
        if size is None:
            say(f"{label}: the folder's prefixes couldn't be measured; they stay there this time")
            return
        if shutil.disk_usage(local).free < size * 1.1 + PREFIX_ROOM:
            say(f"{label}: not enough room on the VM's disk for the games' prefixes ({gb(size)}); they stay in the folder")
            return
        say(f"{label}: copying {len(todo)} game prefix(es) ({gb(size)}) to the VM's disk (once)…")
        splash(f"Moving your games' Windows folders to the Linux disk, once ({gb(size)})…")
        t0 = time.time()
        staging = local / ".copying"
        shutil.rmtree(staging, ignore_errors=True)
        staging.mkdir()
        fails = load_json(PREFIX_FAILS, {})
        done, given_up, late = [], [], False
        for e in todo:
            if time.time() - t0 > PREFIX_BUDGET:
                late = True     # the rest at the next Steam start; Steam shouldn't wait longer
                break
            if TESTING and e == os.environ.get("BOTTLE_LIBRARIES_TEST_COPYFAIL"):
                rc = None
            else:
                rc, _ = run_limited(["cp", "-a", "--", str(target / e), str(staging / e)], PREFIX_COPY_SECS)
            if rc == 0:
                done.append(e)
                continue
            shutil.rmtree(staging / e, ignore_errors=True)
            key = f"{name}/{e}"
            fails[key] = int(fails.get(key, 0)) + 1
            if fails[key] < 2:
                say(f"{label}: copying the prefix {e} didn't finish; trying again at the next Steam start")
                late = True
                break
            # the second time: Proton sets that game up anew on the VM's disk (the old prefix stays
            # in the Mac folder, under the mount); Steam Cloud brings saves back for most games
            say(f"{label}: the prefix {e} couldn't be copied twice; Proton sets it up again (the old one stays in the folder on the Mac)")
            given_up.append(e)
        if PREFIX_FAILS.parent.is_dir():
            write_atomic(PREFIX_FAILS, json.dumps({k: v for k, v in fails.items()
                                                   if k.split("/", 1)[-1] not in done}))
        if late and any(e not in done and e not in given_up for e in todo):
            # not all copied: no mount this time (the folder's prefixes stay the ones in use, so
            # copies made now could go stale); all of it again at the next Steam start
            shutil.rmtree(staging, ignore_errors=True)
            say(f"{label}: some prefixes are still to copy; they stay in the folder until the next Steam start")
            return
        for e in done:
            os.rename(staging / e, local / e)
            copied.append(e)
        shutil.rmtree(staging, ignore_errors=True)
    if not bind(local, target):
        for e in copied:             # not in use: the folder's own copies stay the ones Proton uses
            shutil.rmtree(local / e, ignore_errors=True)
        say(f"{label}: couldn't mount the VM-disk prefixes over the folder's; prefixes stay in the folder this time")
        return
    say(f"{label}: Proton's game prefixes are on the VM's disk" + (f" ({len(copied)} copied there)" if copied else ""))


# ------------------------------------------------------------------ game folders as drives (Oct 22)

def sh(cmd, secs=60, sudo=False):
    """A command's (rc, stdout); rc None when it ran out of time (a lost request on a Mac share)."""
    if sudo:
        cmd = ["sudo", "-n"] + list(cmd)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=secs)
        return r.returncode, r.stdout
    except subprocess.TimeoutExpired:
        return None, ""
    except OSError:
        return 1, ""


def block_devices():
    """[(path, label, fstype)] of the whole disks the VM has (not partitions)."""
    out = []
    rc, text = sh(["lsblk", "-J", "-o", "NAME,TYPE,LABEL,FSTYPE,SIZE"])
    if rc != 0:
        return out
    try:
        for d in json.loads(text).get("blockdevices", []):
            if d.get("type") == "disk":
                out.append((Path("/dev") / d["name"], d.get("label") or "", d.get("fstype") or ""))
    except (ValueError, KeyError):
        pass
    return out


def disk_for(name):
    """The drive the Mac attached for the game folder NAME: formatted (label portalistic-NAME) or
    still raw with the Mac's header. (path, formatted) or (None, False)."""
    if TESTING:
        d = MOUNT_ROOT / name / ".test-disk"
        return (d, True) if d.exists() else (None, False)
    for dev, label, fstype in block_devices():
        if label == f"portalistic-{name}" and fstype == "btrfs":
            return dev, True
    for dev, label, fstype in block_devices():
        if fstype or label:
            continue
        rc, head = sh(["dd", f"if={dev}", "bs=64", "count=1", "status=none"], 10, sudo=True)
        if rc != 0:
            continue
        if head.startswith(DISK_HEADER.decode()) and head[len(DISK_HEADER):].split("\n")[0] == name:
            return dev, False
    return None, False


def disk_mounted(mp):
    if TESTING:
        return (mp / ".test-disk-mounted").exists()
    rc, out = sh(["findmnt", "-n", "-o", "FSTYPE", "--", str(mp)], 10)
    return rc == 0 and out.strip() == "btrfs"


def mount_disk(name, label, want_free):
    """Format (once), mount and size the drive for the game folder NAME at /mnt/portalistic/NAME."""
    mp = MOUNT_ROOT / name
    if disk_mounted(mp):
        return True
    dev, formatted = disk_for(name)
    if dev is None:
        return False
    if TESTING:
        mp.mkdir(parents=True, exist_ok=True)
        (mp / ".test-disk-mounted").write_text("")
        return True
    if not formatted:
        say(f"{label}: making the file system on its drive (once)…")
        rc, _ = sh(["mkfs.btrfs", "-q", "-f", "-L", f"portalistic-{name}", str(dev)], 300, sudo=True)
        if rc != 0:
            say(f"{label}: couldn't make the file system on its drive; the folder itself is used")
            return False
    rc, _ = sh(["mkdir", "-p", str(mp)], 10, sudo=True)
    rc, _ = sh(["mount", "-o", "noatime,discard=async", str(dev), str(mp)], 60, sudo=True)
    if rc != 0:
        # the image file's size can differ by a few KB from the size btrfs noted (Lima trims it):
        # btrfs refuses such a device until its size note is fixed
        sh(["btrfs", "rescue", "fix-device-size", str(dev)], 120, sudo=True)
        rc, _ = sh(["mount", "-o", "noatime,discard=async", str(dev), str(mp)], 60, sudo=True)
    if rc != 0:
        say(f"{label}: couldn't mount its drive; the folder itself is used")
        return False
    sh(["chown", f"{os.getuid()}:{os.getgid()}", str(mp)], 10, sudo=True)
    resize_disk(mp, label, want_free)
    return True


def resize_disk(mp, label, want_free):
    """Steam takes the drive's free space for real: the file system is kept at what's in it plus
    what the Mac has free (minus a reserve), so Steam doesn't start a download the Mac can't hold."""
    if TESTING or not want_free:
        return
    try:
        du = shutil.disk_usage(mp)
    except OSError:
        return
    target = du.used + max(want_free - DISK_RESERVE, 5 * 10 ** 9)
    target = max(target, 10 * 10 ** 9)
    if abs(target - du.total) < max(du.total // 20, 2 * 10 ** 9):
        return
    rc, out = sh(["btrfs", "filesystem", "resize", f"{target // 1024 // 1024}m", str(mp)], 120, sudo=True)
    if rc == 0:
        say(f"{label}: Steam sees {gb(target)} on the drive ({gb(want_free)} free on the Mac)")


def rsync_with_progress(srcdir, dstdir, name, size, secs):
    """rsync -a --partial src/ dst/, the splash window told how far it is every few seconds."""
    try:
        # (--timeout: a lost request on the share stalls rsync for good; after 2 minutes without
        # progress it gives up and the next try carries on from the partial file)
        proc = subprocess.Popen(["rsync", "-a", "--partial", "--timeout=120", "--", str(srcdir) + "/", str(dstdir) + "/"],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return 1
    t0 = time.time()
    while True:
        try:
            return proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        if time.time() - t0 > secs:
            proc.kill()
            proc.wait()
            return None
        rc, out = sh(["du", "-sb", "--", str(dstdir)], 20)
        done = int(out.split()[0]) if rc == 0 and out.split() and out.split()[0].isdigit() else 0
        pct = min(99, done * 100 // size) if size else 0
        splash(f"Moving {name} into the drive: {pct}% of {gb(size)} ({int(time.time() - t0) // 60} min so far)…")


def move_games_in(src, mp, label):
    """Games Steam had in the folder itself (the old share) go into the drive, once: each game's
    folder with rsync (resumable; a lost request on the share ends a try, three tries each), then
    its manifest; the folder's copy is deleted once it's in. compatdata/shadercache come along."""
    sa, da = src / "steamapps", mp / "steamapps"
    rc, out = sh(["ls", "-1A", "--", str(sa)], 20)
    if rc != 0:
        if rc is None:
            say(f"{label}: the folder didn't answer; its games are moved into the drive at a later start")
        return
    entries = set(out.split())
    if not entries:
        return
    da.mkdir(parents=True, exist_ok=True)
    (da / "common").mkdir(exist_ok=True)
    lf = src / "libraryfolder.vdf"
    if lf.is_file() and not (mp / "libraryfolder.vdf").exists():
        sh(["cp", "-p", "--", str(lf), str(mp / "libraryfolder.vdf")], 20)
    manifests = sorted(e for e in entries if e.startswith("appmanifest_") and e.endswith(".acf"))
    moved, failed = 0, []
    for m in manifests:
        info = acf_info(sa / m)
        if not info:
            continue
        gamedir = info["installdir"]
        srcdir, dstdir = sa / "common" / gamedir, da / "common" / gamedir
        ok = not gamedir or not srcdir.is_dir()
        for attempt in range(5):
            if ok:
                break
            say(f"{label}: moving {info['name']} ({gb(info['size'])}) into the drive" + (f", try {attempt + 1}" if attempt else "") + "…")
            rc = rsync_with_progress(srcdir, dstdir, info["name"], info["size"], 3600)
            ok = rc == 0
        if not ok:
            failed.append(info["name"])
            continue
        for extra in ("compatdata", "shadercache"):
            e = sa / extra / info["appid"]
            if e.is_dir():
                (da / extra).mkdir(exist_ok=True)
                rc, _ = sh(["rsync", "-a", "--partial", "--timeout=120", "--", str(e) + "/", str(da / extra / info["appid"]) + "/"], 1800)
                if rc == 0:
                    sh(["rm", "-rf", "--", str(e)], 600)
        rc, _ = sh(["cp", "-p", "--", str(sa / m), str(da / m)], 20)
        if rc != 0:
            failed.append(info["name"])
            continue
        if gamedir and srcdir.is_dir():
            sh(["rm", "-rf", "--", str(srcdir)], 1800)
        sh(["rm", "-f", "--", str(sa / m)], 20)
        moved += 1
    # anything else that stayed (downloads in progress, tools): the games that moved are in; what
    # didn't move is left for a later start
    if moved:
        say(f"{label}: {moved} game(s) moved into the drive")
    for n in failed:
        say(f"{label}: {n} couldn't be moved into the drive (the folder didn't answer); again at the next Steam start, or Steam downloads it again")


def wanted_default(conf, libs):
    """The library index new games should go to, from the Mac's choice and what's there now."""
    order = [conf.get("default") or "mac", "mac"]
    for name in order:
        if name == "vm":
            return 0, "the VM's disk"
        f = next((f for f in conf.get("folders", []) if f.get("name") == name), None)
        if not f:
            continue
        mp = MOUNT_ROOT / name
        i, _ = libs.find(mp)
        if i is not None and shared(mp):
            return i, f.get("label") or name
    return 0, "the VM's disk"


def cmd_sync(args):
    if steam_running() and not args.force:
        say("bottle-libraries: Steam is running (it would write its own list back when it quits); not changing anything.")
        return 2
    if not STEAM.is_dir():
        say("bottle-libraries: no Steam folder yet.")
        return 0
    conf = load_json(CONF, {"folders": []})
    state = load_json(STATE, {})
    folders = [f for f in conf.get("folders", []) if re.fullmatch(r"[a-z0-9][a-z0-9-]*", f.get("name", ""))]
    names = {f["name"] for f in folders}
    libs = Libraries()

    # folders the Mac no longer lists: their entries go (the games stay in the folder)
    for i, e in libs.entries():
        p = Path(libs.path_of(e))
        if p.parent == MOUNT_ROOT and p.name not in names:
            libs.remove(i)
            say(f"Steam library {p} removed from Steam's list (its games stay in the folder on the Mac)")
    mapping = libs.renumber()

    # shared folders: a Steam library each
    for f in folders:
        mp = MOUNT_ROOT / f["name"]
        label = f.get("label") or f["name"]
        src = FOLDER_ROOT / f["name"]
        if f.get("disk") and shared(src):
            # the folder is a drive now: the VM mounts it itself (the folder's share stays for the games
            # already in it, which move into the drive once)
            if not mount_disk(f["name"], label, int(f.get("free") or 0)):
                say(f"{label}: no drive for it yet; Steam gets the folder itself this time")
                if libs.find(mp)[0] is None:
                    continue
            else:
                move_games_in(src, mp, label)
        if not shared(mp):
            if libs.find(mp)[0] is not None:
                say(f"{label} ({f.get('path', '?')}): not connected; Steam shows it as unavailable until it's back")
            continue
        try:
            cid = ensure_library_folder(mp, label)
        except OSError as e:
            say(f"{label}: can't write to {mp} ({e}); not a Steam library this time")
            continue
        i, e = libs.find(mp)
        if e is None:
            i = libs.add(mp, label, cid)
            say(f"Steam library {i}: {label} ({f.get('path', mp)}) added")
        else:
            vdf_set(e, "label", vdf_esc(label))
            vdf_set(e, "contentid", cid)
        move_tools(libs, mp)
        local_prefixes(mp, f["name"], label)
    libs.save()

    # The default for new games. Portalistic sets it when the Mac's choice is new (its stamp
    # changed), when the user's value is still the one it wrote last (so a drive coming back
    # gets its default back), or when the value points at a library that went. A default
    # picked in Steam since then stays.
    if not CONF.is_file():
        return 0
    want, want_label = wanted_default(conf, libs)
    stamp = str(conf.get("stamp", ""))
    # (indexes from before the renumbering above, in today's numbers; gone: None)
    written = {u: mapping.get(v) for u, v in state.get("written", {}).items() if isinstance(v, int)}
    out, told = {}, False
    for user, path in localconfigs():
        cur = read_default(path)
        cur_n = mapping.get(cur) if cur is not None else 0
        mine = cur is None or cur_n is None or stamp != state.get("stamp") or written.get(user) == cur_n
        target = want if mine else cur_n
        if (cur is None and target != 0) or (cur is not None and cur != target):
            if write_default(path, target) and mine and not told:
                say(f"New games install to {want_label} by default (Steam > Settings > Storage changes it)")
                told = True
        out[user] = target if mine else written.get(user)
    state = {"stamp": stamp, "written": {u: v for u, v in out.items() if v is not None}}
    STATE.parent.mkdir(parents=True, exist_ok=True)
    write_atomic(STATE, json.dumps(state))
    return 0


# ------------------------------------------------------------------ status

def library_rows():
    conf = load_json(CONF, {"folders": []})
    labels = {MOUNT_ROOT / f.get("name", ""): (f.get("label") or f.get("name"), f.get("path", ""))
              for f in conf.get("folders", [])}
    libs = Libraries()
    defaults = [read_default(p) for _, p in localconfigs() if p.parts[-3] != "0"] or \
               [read_default(p) for _, p in localconfigs()]
    default = next((d for d in defaults if d is not None), 0)
    rows = []
    for i, e in libs.entries():
        p = Path(libs.path_of(e))
        kind = "vm" if p.resolve() == STEAM.resolve() else ("mac" if p.parent == MOUNT_ROOT else "other")
        label, mac_path = labels.get(p, (None, ""))
        here = shared(p) if kind == "mac" else p.is_dir()
        row = {"index": i, "path": str(p), "kind": kind, "connected": here, "default": i == default,
               "label": label or ("VM disk" if kind == "vm" else vdf_value(e, "label") or p.name),
               "mac_path": mac_path, "games": 0, "games_bytes": 0, "tools": 0}
        if here:
            du = shutil.disk_usage(p)
            row.update(free=du.free, total=du.total)
            apps = p / "steamapps"
            for acf in apps.glob("appmanifest_*.acf"):
                info = acf_info(acf)
                if not info:
                    continue
                if is_tool(info, apps / "common"):
                    row["tools"] += 1
                else:
                    row["games"] += 1
                    row["games_bytes"] += info["size"]
        rows.append(row)
    return rows


def cmd_status(args):
    if not STEAM.is_dir():
        say("No Steam folder yet.")
        return 0
    rows = library_rows()
    if args.json:
        print(json.dumps(rows))
        return 0
    say("Steam's libraries in the VM:")
    for r in rows:
        where = r["mac_path"] or r["path"]
        if not r["connected"]:
            space = "not connected (its drive isn't there, or the VM started before it was)"
        elif r["kind"] == "vm":
            space = "on the VM's disk"
        else:
            space = f"{gb(r['free'])} free of {gb(r['total'])}"
        games = f"{r['games']} game{'s' if r['games'] != 1 else ''}" + (f", {gb(r['games_bytes'])}" if r["games"] else "")
        say(f"  {r['index']}  {r['label']}{'  (default for new games)' if r['default'] else ''}")
        say(f"       {where}: {space}; {games}" + (f"; {r['tools']} Steam tools" if r["tools"] else ""))
    return 0


def cmd_tidy(args):
    """The drives: unused space given back to the Mac (fstrim), the file system sized to what the
    Mac has free (--free NAME=BYTES, from the Mac). The watcher runs it now and then, not during a game."""
    conf = load_json(CONF, {"folders": []})
    free = {}
    for kv in args.free or []:
        n, _, b = kv.partition("=")
        if b.isdigit():
            free[n] = int(b)
    for f in conf.get("folders", []):
        name = f.get("name", "")
        mp = MOUNT_ROOT / name
        if not name or not disk_mounted(mp):
            continue
        sh(["fstrim", "--", str(mp)], 600, sudo=True)
        if name in free:
            resize_disk(mp, f.get("label") or name, free[name])
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("sync")
    s.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("tidy")
    s.add_argument("--free", action="append", metavar="NAME=BYTES")
    args = ap.parse_args()
    return {"sync": cmd_sync, "status": cmd_status, "tidy": cmd_tidy}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
