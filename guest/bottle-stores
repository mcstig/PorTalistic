def epic_launch_args(app):
    """The arguments an Epic game is started with beyond its program: its own, and the sign-in (a token
    that works once). -> (list, a note for the log, which never holds the token)."""
    if not EPIC_APP.fullmatch(app):
        return [], f"{app!r} isn't a game name: started without Epic's sign-in"
    err = ""
    for extra in ([], ["--offline"]):         # (offline: no token, for when Epic can't be reached)
        code, out, err = legendary_run(["launch", app, "--json", "--skip-version-check", "--no-wine"] + extra,
                                       timeout=90)
        data = lgd_json(out)
        if code == 0 and isinstance(data, dict):
            found = [str(a) for key in ("game_parameters", "user_parameters", "egl_parameters")
                     for a in data.get(key) or []]
            return found, ("Epic's sign-in added" if not extra else "no sign-in with Epic: started offline")
    return [], f"Legendary gave no launch arguments ({lgd_why(err)}): started without Epic's sign-in"


# ------------------------------------------------------------------ Comet: the Galaxy client's service

def port_listening(port):
    """Is something listening on 127.0.0.1:port? Read from the kernel's table, so no connection is
    made (Comet would count one as a game)."""
    want = f"{port:04X}"
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            lines = Path(table).read_text().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            f = line.split()
            if len(f) > 3 and f[3] == "0A" and f[1].rsplit(":", 1)[-1] == want:
                return True
    return False


def log_note(path, msg):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a") as f:
            f.write(f"[bottle-stores {time.strftime('%H:%M:%S')}] {msg}\n")
    except OSError:
        pass


def comet_note(msg):
    log_note(COMET_LOG, msg)


def _comet_dies_with_us():
    """(in the new process) Comet gets Ctrl-C, which it shuts down on, if this tool is killed."""
    try:
        import ctypes
        ctypes.CDLL(None, use_errno=True).prctl(1, int(signal.SIGINT))   # PR_SET_PDEATHSIG
    except Exception:
        pass


def comet_start():
    """Make sure Comet is up for a game about to start. -> (the process if this call started it, a note
    for the log). Never raises for the ordinary reasons it can't (no Comet, not signed in)."""
    if port_listening(COMET_PORT):
        return None, "Comet is already running"
    if not COMET_BIN.is_file():
        return None, "Comet isn't installed in this VM (Bottle > Update the Bottle)"
    if not AUTH.is_file():
        return None, "not signed in to GOG, so the game gets no Galaxy sign-in"
    saved = {k: os.environ.pop(k) for k in ("LD_PRELOAD", "LD_LIBRARY_PATH") if k in os.environ}
    try:
        if gog_token() is None:             # gogdl renews an old token and saves it
            return None, "GOG didn't confirm the sign-in; sign in again in Portalistic"
    finally:
        os.environ.update(saved)
    link_dir = COMET_CFG / "heroic/gog_store"           # (Comet looks for Heroic's file name)
    link_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(COMET_CFG, 0o700)
    link = link_dir / "auth.json"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(AUTH)
    name = read_json(USER).get("username") or "gog"
    env = {k: v for k, v in os.environ.items() if k not in ("LD_PRELOAD", "LD_LIBRARY_PATH")}
    env["XDG_CONFIG_PATH"] = str(COMET_CFG)
    env.setdefault("COMET_LOG", "info")
    COMET_LOG.parent.mkdir(parents=True, exist_ok=True)
    if COMET_LOG.is_file() and COMET_LOG.stat().st_size > (1 << 20):
        COMET_LOG.write_text("")
    with open(COMET_LOG, "ab") as log:
        proc = subprocess.Popen([str(COMET_BIN), "--from-heroic", "--username", name], env=env,
                                stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                start_new_session=True, preexec_fn=_comet_dies_with_us)
    for _ in range(40):                                 # up to 10 s to start listening
        if port_listening(COMET_PORT):
            break
        if proc.poll() is not None:
            return None, f"Comet stopped at once (exit {proc.returncode}); see {COMET_LOG}"
        time.sleep(0.25)
    if not COMET_PEER_DONE.is_file():                   # first time: Comet fetches GOG's Galaxy files
        say("Fetching the Galaxy files this game needs from GOG (once, about 30 MB)…")
        for _ in range(240):                            # up to 2 minutes
            if COMET_PEER_DONE.is_file() or proc.poll() is not None:
                break
            time.sleep(0.5)
        if not COMET_PEER_DONE.is_file():
            return proc, "Comet is up, but the Galaxy files didn't finish downloading"
    return proc, "Comet started"


def comet_stop(proc):
    if proc is None or proc.poll() is not None:
        return
    proc.send_signal(signal.SIGINT)                     # (it finishes what it's saving, then exits)
    try:
        proc.wait(10)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


def cmd_run(args):
    cmd = list(args.command or [])
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    if not cmd:
        die("usage: bottle-stores run [--epic ID] -- COMMAND [ARGUMENTS...]")
    comet, extra = None, []
    if args.epic:
        try:
            extra, note = epic_launch_args(args.epic)
            log_note(EPIC_LOG, f"{args.epic}: {note}")
        except (Exception, SystemExit) as e:            # whatever goes wrong, the game still starts
            log_note(EPIC_LOG, f"{args.epic}: couldn't get Epic's launch arguments: {e!r}")
    else:
        try:
            comet, note = comet_start()
            comet_note(note)
        except (Exception, SystemExit) as e:
            comet_note(f"couldn't start Comet: {e!r}")
    try:
        child = subprocess.Popen(cmd + extra)
    except OSError as e:
        comet_stop(comet)
        say(f"error: can't run {cmd[0]}: {e}")
        return 127

    def forward(sig, _frame):
        try:
            child.send_signal(sig)
        except ProcessLookupError:
            pass
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT, signal.SIGUSR1, signal.SIGUSR2):
        signal.signal(s, forward)
    rc = child.wait()
    comet_stop(comet)
    return 128 - rc if rc < 0 else rc


def steam_libraries():
    out = [STEAM / "steamapps"]
