def epic_login(args):
    code = epic_extract_code(args.code)
    if not code:
        die("I couldn't find an Epic code in that. After you sign in, Epic's page shows some text that "
            "contains \"authorizationCode\"; copy all of that text and paste it.")
    private_dirs()
    user_file = LGD_CONFIG / "user.json"
    old = user_file.read_bytes() if user_file.is_file() else None
    user_file.unlink(missing_ok=True)          # (with a sign-in on file Legendary would keep it and ignore the code)
    legendary_run(["auth", "--code", code], timeout=120)
    user = epic_user()
    if not user:
        user_file.unlink(missing_ok=True)
        if old is not None:
            user_file.write_bytes(old)
            os.chmod(user_file, 0o600)
        die("Epic didn't accept that code. A code works once and expires within a minute or so: "
            "sign in again and paste the new text straight away.")
    os.chmod(user_file, 0o600)
    EPIC_LIBCACHE.unlink(missing_ok=True)
    name = user.get("displayName") or ""
    say(f"Signed in to Epic Games{' as ' + name if name else ''}.")
    return 0


