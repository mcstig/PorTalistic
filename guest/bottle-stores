    return 0


def epic_images(meta):
    """The pictures Epic lists for a game (its catalog entry's keyImages): {cover, hero, logo, icon: address}
    (None for one it hasn't got)."""
    by_type = {}
    for im in (meta or {}).get("keyImages") or []:
        if isinstance(im, dict) and isinstance(im.get("url"), str) and im["url"].startswith(("https://", "http://")):
            by_type.setdefault(im.get("type"), im["url"])

    def pick(*types):
        return next((by_type[t] for t in types if t in by_type), None)

    return {"cover": pick("DieselGameBoxTall", "OfferImageTall", "DieselStoreFrontTall"),
            "hero": pick("DieselGameBox", "DieselStoreFrontWide", "OfferImageWide"),
            "logo": pick("DieselGameBoxLogo", "ProductLogo"),
            "icon": pick("Thumbnail")}


def epic_art_links(app):
    """Epic's pictures for an installed game, from the catalog entry Legendary saved: (links, complete)."""
    meta = read_json(LGD_CONFIG / "metadata" / f"{app}.json").get("metadata")
    if not isinstance(meta, dict):
        return {}, False                          # (not saved yet: the next try finds it)
    return epic_images(meta), True


def epic_rows(raw):
    """The games Legendary lists, as {id, title, version, image}: those with a Windows version it can
    install itself (not the ones Epic hands on to Ubisoft Connect or EA), by title."""
    rows = []
    for g in raw if isinstance(raw, list) else []:
        if not isinstance(g, dict) or not g.get("app_name"):
            continue
        meta = g.get("metadata") if isinstance(g.get("metadata"), dict) else {}
        version = ((g.get("asset_infos") or {}).get("Windows") or {}).get("build_version")
        attrs = meta.get("customAttributes") if isinstance(meta.get("customAttributes"), dict) else {}
        third_party = any(isinstance(attrs.get(k), dict) and attrs[k].get("value")
                          for k in ("ThirdPartyManagedApp", "ThirdPartyManagedProvider"))
        addon = any(isinstance(c, dict) and c.get("path") == "addons/launchable" for c in meta.get("categories") or [])
        if not version or third_party or addon:
            continue
        rows.append({"id": str(g["app_name"]), "title": (g.get("app_title") or str(g["app_name"])).strip(),
                     "version": str(version), "image": epic_images(meta).get("cover") or "",
                     "ns": str(meta.get("namespace") or ""), "item": str(meta.get("id") or "")})
    rows.sort(key=lambda r: r["title"].lower())
    return rows


EPIC_OFFERS_QUERY = ("query($ns: String!) { Catalog { catalogOffers(namespace: $ns, params: {count: 100}) "
                     "{ elements { id releaseDate pcReleaseDate items { id } } } } }")


def epic_release_year(ns, item):
    """The year the game (its catalog item in the namespace) came out on PC, from Epic's public store: the
    earliest of its offers' PC release dates, else of their store dates. 0: the store gives none.
    OSError / ValueError when the store can't be reached or answers oddly."""
    req = urllib.request.Request(
        EPIC_GRAPHQL, data=json.dumps({"query": EPIC_OFFERS_QUERY, "variables": {"ns": ns}}).encode(),
        headers={"User-Agent": "Portalistic/1 (bottle-stores)", "Accept": "application/json",
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.loads(r.read().decode("utf-8", "replace"))
    catalog = (data.get("data") or {}).get("Catalog") if isinstance(data, dict) else None
    offers = ((catalog or {}).get("catalogOffers") or {}).get("elements")
    if not isinstance(offers, list):
        raise ValueError("Epic's store gave no offers")
    pc, store = [], []
    for o in offers:
        if not isinstance(o, dict) or item not in {i.get("id") for i in o.get("items") or [] if isinstance(i, dict)}:
            continue
        for key, found in (("pcReleaseDate", pc), ("releaseDate", store)):
            y = year_of(o.get(key))
            if y:
                found.append(y)
    return min(pc or store or [0])


def epic_years(games, budget=25.0):
    """The release year of each game in `games` ([{id, ns, item}]) -> {id: year}, from what is kept in EPIC_YEARS.
    Asks Epic's store, for up to `budget` seconds, about the games not kept yet (a few at a time); a year
    that is found is kept for good, "no year" is asked again after a week, and when the store can't be
    reached it isn't asked again for an hour. The games not reached stay for the next call."""
    data = read_json(EPIC_YEARS)
    kept = data.get("years") if isinstance(data.get("years"), dict) else {}
    now = time.time()

    def wanted(g):
        k = kept.get(g["id"])
        if not (g.get("ns") and g.get("item")):
            return False
        return not isinstance(k, dict) or (not k.get("y") and now - k.get("t", 0) > EPIC_YEAR_UNKNOWN_RETRY)

    todo = [g for g in games if wanted(g)]
    if todo and now - data.get("failed", 0) > EPIC_YEARS_RETRY:
        deadline = time.monotonic() + budget
        trouble = {"n": 0}

        def ask(g):
            if trouble["n"] >= 4 or time.monotonic() > deadline:
                return g["id"], None
            try:
                year = epic_release_year(g["ns"], g["item"])
            except (OSError, ValueError):
                trouble["n"] += 1
                return g["id"], None
            trouble["n"] = 0
            return g["id"], year

        pool = concurrent.futures.ThreadPoolExecutor(6)
        try:
            for gid, year in pool.map(ask, todo):
                if year is not None:
                    kept[gid] = {"y": year, "t": now}
        finally:
            pool.shutdown(wait=True)
        out = {"v": 1, "years": kept}
        if trouble["n"] >= 4:
            out["failed"] = now
        write_json(EPIC_YEARS, out)
    return {g["id"]: int((kept.get(g["id"]) or {}).get("y") or 0) for g in games}


def epic_library(refresh=False):
    cache = read_json(EPIC_LIBCACHE)
    fresh = (cache.get("games") and cache.get("v") == LIBRARY_VERSION
             and time.time() - cache.get("fetched", 0) < LIBRARY_MAX_AGE)
    if fresh and not refresh:
        return cache["games"]
    if not epic_user():
        if cache.get("games"):
            return cache["games"]
        die("You're not signed in to Epic Games (or the sign-in expired). Sign in again.")
    code, out, err = legendary_run(["list", "--json", "--platform", "Windows"], timeout=900)
    data = lgd_json(out)
    if code != 0 or not isinstance(data, list):
        if cache.get("games"):
            say(f"(couldn't reach Epic: {lgd_why(err)}; showing the list from before)")
            return cache["games"]
        die(f"couldn't get your Epic games: {lgd_why(err)}")
    games = epic_rows(data)
    write_json(EPIC_LIBCACHE, {"fetched": time.time(), "v": LIBRARY_VERSION, "games": games})
    return games


