def epic_install(args):
    app = str(args.id)
    if not EPIC_APP.fullmatch(app):
        die("usage: bottle-stores epic install GAME_ID (the name from the games list)")
    if not epic_user():
        die("You're not signed in to Epic Games (or the sign-in expired).")
    cache = {g["id"]: g for g in read_json(EPIC_LIBCACHE).get("games") or []}
    have = installed("epic")
    title = (have.get(app) or cache.get(app) or {}).get("title") or f"Epic game {app}"
    choice = choose_folder(args.folder, have.get(app))
    base = Path(choice["path"]) / "Epic Games"
    base.mkdir(parents=True, exist_ok=True)
    say(f"Downloading {title} to {choice['label']} / Epic Games")
    # (one at a time: Legendary keeps a single lock on its list of installed games)
    with locked("epic"):
        code, tail = run_download(
            legendary_cmd() + ["-y", "install", app, "--base-path", str(base), "--platform", "Windows",
                               "--skip-dlcs", "--skip-sdl", "--max-shared-memory", "512"],
            legendary_env(), EPIC_PROGRESS)
        if code != 0:
            die(f"the download stopped ({lgd_why(chr(10).join(tail))}). Starting it again picks up what's done.")
        igame = read_json(LGD_CONFIG / "installed.json").get(app)
        if not isinstance(igame, dict) or not igame.get("install_path"):
            die(f"Epic didn't install {title} ({lgd_why(chr(10).join(tail))}). "
                "A game that comes from another store (EA, Ubisoft) has to be installed there.")
        install_dir = Path(igame["install_path"])
        rel = str(igame.get("executable") or "").replace("\\", "/").lstrip("/")
        exe = find_nocase(install_dir, rel) if rel else None
        if exe is None or not exe.is_file():
            die(f"{title} downloaded to {install_dir}, but I couldn't find the program that starts it "
                f"({rel or 'Epic lists none'}). Add it to Steam by hand from that folder.")
        old = have.get(app) or {}
        size = int(igame.get("install_size") or 0) or sum(f.stat().st_size for f in install_dir.rglob("*") if f.is_file())
        title = igame.get("title") or title
        rec = {"id": app, "store": "epic", "title": title, "dir": str(install_dir), "exe": str(exe), "args": "",
               "startdir": str(exe.parent), "folder": choice["name"], "size": size, "installed": int(time.time()),
               "version": str(igame.get("version") or ""), "icon": old.get("icon", "")}
        rec["appid"] = old.get("appid") or shortcut_appid(f'"{exe}"', title)
        rec["art"], rec["art_try"] = old.get("art", 0), old.get("art_try", 0)
        if rec["art"] < ART_VERSION:
            fetch_art(rec)
        update_installed("epic", app, rec)
    say(f"@@done {app}")
    say(f"Installed {title}. It shows in Steam (collection “{STORES['epic']}”) after Steam restarts.")
    return 0


