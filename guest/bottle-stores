# ------------------------------------------------------------------ small files

def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {} if default is None else default


def write_json(path, value, mode=None):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=1, sort_keys=True) + "\n")
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


class locked:
    """One at a time: a game's install or removal ("gog-ID"), or a change to games.json ("games")."""
    def __init__(self, name):
        self.name = name

    def __enter__(self):
        STATE.mkdir(parents=True, exist_ok=True)
        self.f = open(STATE / f"lock-{self.name}", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        self.f.close()


def installed(store="gog"):
    games = read_json(GAMES).get(store)
    return games if isinstance(games, dict) else {}


def update_installed(store, gid, rec):
    """Add or replace one game's record (rec None: take it out), without losing another install's."""
    with locked("games"):
        games = installed(store)
        if rec is None:
            games.pop(gid, None)
        else:
            games[gid] = rec
        all_games = read_json(GAMES)
        all_games[store] = games
        write_json(GAMES, all_games)


def all_installed():
    """Every installed game of every store: {"gog:ID": rec, "epic:NAME": rec}, each rec with its "store"."""
    out = {}
    for store in STORES:
        for gid, rec in installed(store).items():
            if isinstance(rec, dict):
                rec["store"] = store
                out[f"{store}:{gid}"] = rec
    return out


def art_key(rec):
    """What a game's picture files in our art folder start with: GOG's ID as it always was, or store-NAME."""
    store = rec.get("store", "gog")
    return str(rec["id"]) if store == "gog" else f"{store}-{rec['id']}"


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1000


# ------------------------------------------------------------------ Steam's binary shortcuts.vdf

def bvdf_load(data):
    """shortcuts.vdf: a dict of dicts; a value is a dict or (type byte, value). Anything we don't
    understand raises ValueError, and the file is then left alone."""
    pos, n = 0, len(data)

    def cstr():
        nonlocal pos
        end = data.index(b"\0", pos)
        s = data[pos:end].decode("utf-8", "replace")
        pos = end + 1
        return s

    def node():
        nonlocal pos
        out = {}
        while pos < n:
            t = data[pos]
            pos += 1
            if t == 8:
                return out
            key = cstr()
            if t == 0:
                out[key] = node()
            elif t == 1:
                out[key] = (1, cstr())
            elif t == 2:
                out[key] = (2, struct.unpack_from("<I", data, pos)[0])
                pos += 4
            elif t in (3, 4, 6):
                out[key] = (t, data[pos:pos + 4])
                pos += 4
            elif t == 7:
                out[key] = (t, data[pos:pos + 8])
                pos += 8
            else:
                raise ValueError(f"unknown type {t}")
        return out

    return node()


def bvdf_dump(d):
    out = bytearray()
    for k, v in d.items():
        kb = k.encode() + b"\0"
        if isinstance(v, dict):
            out += b"\0" + kb + bvdf_dump(v)
        elif v[0] == 1:
            out += b"\1" + kb + v[1].encode() + b"\0"
        elif v[0] == 2:
            out += b"\2" + kb + struct.pack("<I", v[1] & 0xFFFFFFFF)
        else:
            out += bytes([v[0]]) + kb + v[1]
    out += b"\x08"
    return bytes(out)


def shortcut_appid(exe, name):
    """The app ID Steam gives a non-Steam game: a CRC of its quoted program path and name, with
    the top bit set (it names the Steam Play setting and the artwork)."""
    return (zlib.crc32((exe + name).encode("utf-8")) & 0xFFFFFFFF) | 0x80000000


def sval(entry, key, default=""):
    v = entry.get(key)
    return v[1] if isinstance(v, tuple) and v[0] == 1 else default


def ival(entry, key, default=0):
    v = entry.get(key)
    return v[1] if isinstance(v, tuple) and v[0] == 2 else default


def uses_galaxy(game_dir, max_depth=4):
    """Does the game carry GOG's Galaxy SDK (Galaxy.dll / Galaxy64.dll near its top)? True or False;
    None when the folder isn't there to look in (a drive that isn't connected)."""
    base = Path(game_dir)
    if not base.is_dir():
        return None
    try:
        for root, dirs, files in os.walk(base):
            if any(f.lower() in GALAXY_DLLS for f in files):
                return True
            if len(Path(root).relative_to(base).parts) >= max_depth:
                dirs[:] = []
    except OSError:
        pass
    return False


def launch_options(rec):
    """What goes in the shortcut's launch options: the game's own arguments, and for a game that uses
    the Galaxy SDK also `bottle-stores run -- %command%`, which starts Comet beside it (an Epic game:
    `bottle-stores run --epic ID -- %command%`, which adds Epic's sign-in to its arguments)."""
    args = (rec.get("args") or "").strip()
    if rec.get("store") == "epic":
        return f"{EPIC_RUN} {shlex.quote(str(rec['id']))} -- %command% {args}".strip()
    if rec.get("galaxy"):
        return f"{COMET_RUN} %command% {args}".strip()
    return args


def make_entry(rec, old=None):
    """The shortcut for an installed game; an existing entry keeps what Steam stored in it."""
    e = dict(old) if old else {}
    exe, start = f'"{rec["exe"]}"', f'"{rec["startdir"]}"'
    e["appid"] = (2, int(rec["appid"]))
    e["AppName"] = (1, rec["title"])
    e["Exe"] = (1, exe)
    e["StartDir"] = (1, start)
    e["icon"] = (1, rec.get("icon") or sval(e, "icon"))
    e["ShortcutPath"] = (1, f"{MARK}{rec.get('store', 'gog')}:{rec['id']}")
    e["LaunchOptions"] = (1, launch_options(rec))
    for key, val in (("IsHidden", 0), ("AllowDesktopConfig", 1), ("AllowOverlay", 1), ("OpenVR", 0),
                     ("Devkit", 0), ("DevkitOverrideAppID", 0), ("LastPlayTime", 0)):
        e[key] = (2, ival(e, key, val))
    for key in ("DevkitGameID", "FlatpakAppID"):
        e[key] = (1, sval(e, key))
    e["tags"] = {"0": (1, STORES[rec.get("store", "gog")])}
    return e


def steam_user_dirs():
    base = STEAM / "userdata"
    try:
        return sorted(d for d in base.iterdir() if d.name.isdigit() and d.name != "0" and d.is_dir())
    except OSError:
        return []


def steam_running():
    # (BOTTLE_STEAM_PROC: what the self-test points elsewhere, so a Steam running in the VM doesn't count there)
    pat = os.environ.get("BOTTLE_STEAM_PROC", "[s]teamrtarm64/steam( |$)")
    return subprocess.run(["pgrep", "-f", pat], capture_output=True).returncode == 0


def sync_user(udir, games):
    """Make udir's shortcuts.vdf hold exactly our games among its own. Returns (added, removed, updated)."""
    cfg = udir / "config"
    path = cfg / "shortcuts.vdf"
    try:
        data = bvdf_load(path.read_bytes()) if path.is_file() else {}
    except (ValueError, struct.error, OSError) as e:
        say(f"  {udir.name}: shortcuts.vdf isn't in a form I understand ({e}); left alone")
        return 0, 0, 0
    top_key = next((k for k in data if k.lower() == "shortcuts"), "shortcuts")
    shortcuts = data.get(top_key) if isinstance(data.get(top_key), dict) else {}
    ours_by_id, keep = {}, []
    removed = 0
    for entry in shortcuts.values():
        if not isinstance(entry, dict):
            continue
        mark = sval(entry, "ShortcutPath")
        if mark.startswith(MARK):
            gid = mark[len(MARK):]
            if gid in games and gid not in ours_by_id:
                ours_by_id[gid] = entry
                keep.append(("ours", gid))
            else:
                removed += 1
        else:
            keep.append(("theirs", entry))
    added = updated = 0
    result = []
    done = set()
    for kind, item in keep:
        if kind == "theirs":
            result.append(item)
        else:
            new = make_entry(games[item], ours_by_id[item])
            if new != ours_by_id[item]:
                updated += 1
            result.append(new)
            done.add(item)
    for gid, rec in games.items():
        if gid not in done:
            result.append(make_entry(rec))
            added += 1
    new_data = dict(data)
    new_data.pop(top_key, None)
    new_data["shortcuts"] = {str(i): e for i, e in enumerate(result)}
    if not (added or removed or updated) and path.is_file():
        copy_art(cfg / "grid", games)            # (pictures fetched since the last sync)
        return 0, 0, 0
    if not games and not path.is_file():
        return 0, 0, 0
    cfg.mkdir(parents=True, exist_ok=True)
    blob = bvdf_dump(new_data)
    if bvdf_load(blob) != new_data:          # never hand Steam a file it can't read back
        say(f"  {udir.name}: couldn't write shortcuts.vdf safely; left alone")
        return 0, 0, 0
    if path.is_file() and not path.with_name("shortcuts.vdf.bottle-backup").exists():
        shutil.copy2(path, path.with_name("shortcuts.vdf.bottle-backup"))
    tmp = path.with_name("shortcuts.vdf.bottle-tmp")
    tmp.write_bytes(blob)
    os.replace(tmp, path)
    copy_art(cfg / "grid", games)
    return added, removed, updated


def note_galaxy(games):
    """Find out once, for a game installed before this was checked, whether it uses the Galaxy SDK
    (an install or update checks again). A game whose folder can't be looked in stays as it is."""
    for rec in games.values():
        if rec.get("store") == "gog" and "galaxy" not in rec:
            found = uses_galaxy(rec.get("dir", ""))
            if found is not None:
                rec["galaxy"] = found
                update_installed("gog", rec["id"], rec)


def cmd_sync(args):
    games = all_installed()
    note_galaxy(games)
    if steam_running() and not args.force:
        say("Steam is running; it would undo this when it quits. Quit Steam first (bottle steam does it).")
        return 1
    users = steam_user_dirs()
    if not users:
        say("Steam has no signed-in user yet; the games are added once it has.")
        return 0
    note_art(games)
    for u in users:
        a, r, up = sync_user(u, games)
        if a or r or up:
            say(f"Steam user {u.name}: {a} added, {up} updated, {r} taken out (games from other stores)")
    return 0


def cmd_ids(args):
    for store in read_json(GAMES).values():
        for rec in (store or {}).values():
            if isinstance(rec, dict) and str(rec.get("appid", "")).isdigit():
                print(rec["appid"])
    return 0


# ------------------------------------------------------------------ gogdl

def gogdl_cmd():
    custom = os.environ.get("BOTTLE_GOGDL")
    if custom:
        return shlex.split(custom)
    return [sys.executable or "python3", "-m", "gogdl.cli"]


def gogdl_env():
    env = dict(os.environ)
    env["PYTHONPATH"] = GOGDL_DIR + (":" + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    env["GOGDL_CONFIG_PATH"] = str(GOGDL_CONFIG)
    env["PYTHONUNBUFFERED"] = "1"
    return env


def gogdl_available():
    return bool(os.environ.get("BOTTLE_GOGDL")) or (Path(GOGDL_DIR) / "gogdl/cli.py").is_file()


def gogdl_run(args, timeout=300):
    """gogdl's output, without ever showing it (the sign-in prints tokens). -> (code, out, err)"""
    if not gogdl_available():
        die("GOG's downloader isn't in the VM yet. Choose Bottle > Update the Bottle, then try again.")
    STATE.mkdir(parents=True, exist_ok=True)
    GOGDL_CONFIG.mkdir(parents=True, exist_ok=True)
    cmd = gogdl_cmd() + ["--auth-config-path", str(AUTH)] + args
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=gogdl_env(),
                           stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        die("GOG's downloader took too long to answer. Check the VM's network and try again.")
    return r.returncode, r.stdout, r.stderr


def last_json(text):
    for line in reversed(text.strip().splitlines()):
        line = line.strip()
        if line.startswith("{") or line == "null":
            try:
                return json.loads(line)
            except ValueError:
                continue
    return None


def gog_token():
    """A valid access token (gogdl refreshes an expired one), or None when not signed in."""
    if not AUTH.is_file():
        return None
    _code, out, _err = gogdl_run(["auth"], timeout=60)
    data = last_json(out)
    return data.get("access_token") if isinstance(data, dict) else None


def http_json(url, token=None, timeout=40):
    headers = {"User-Agent": "Portalistic/1 (bottle-stores)", "Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "replace"))


def year_of(value):
    """The year at the start of a date text ("2012-04-21 00:00:00.000000", "2015-07-07T15:00:00.000Z"); 0 when
    the text has none, or a year no game has (a placeholder)."""
    m = re.match(r"\s*(\d{4})-\d\d", value) if isinstance(value, str) else None
    year = int(m.group(1)) if m else 0
    return year if 1970 <= year <= datetime.now().year + 2 else 0


def http_blob(url, timeout=60, limit=20 << 20):
    """A file's bytes; OSError when it is bigger than limit (half a picture is worse than none)."""
    req = urllib.request.Request(url, headers={"User-Agent": "Portalistic/1 (bottle-stores)"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        blob = r.read(limit + 1)
    if len(blob) > limit:
        raise OSError(f"{url} is bigger than {limit >> 20} MB")
    return blob


# ------------------------------------------------------------------ GOG: signing in

def extract_code(text):
    text = (text or "").strip().strip("\"'")
    m = re.search(r"[?&#]code=([^&#\s]+)", text)
    if m:
        return m.group(1)
    return text if re.fullmatch(r"[A-Za-z0-9_\-]{16,}", text) else None


def gog_status(args):
    games = installed("gog")
    signed = AUTH.is_file()
    info = {"signedIn": signed, "user": read_json(USER).get("username", "") if signed else "",
            "installed": len(games), "downloader": gogdl_available()}
    if args.json:
        print(json.dumps(info))
    else:
        say(f"GOG: {'signed in as ' + (info['user'] or 'an account') if signed else 'not signed in'}; "
            f"{len(games)} game(s) installed")
        if not info["downloader"]:
            say("GOG's downloader isn't in the VM yet (Bottle > Update the Bottle).")
    return 0


def gog_login(args):
    code = extract_code(args.code)
    if not code:
        die("I couldn't find a GOG code in that. After you sign in, the browser ends on a page that "
            "says nothing useful; copy the whole address from its address bar (it contains code=...) "
            "and paste that.")
    old = AUTH.read_bytes() if AUTH.is_file() else None
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    _c, out, _e = gogdl_run(["auth", "--code", code], timeout=90)
    data = last_json(out)
    if not isinstance(data, dict) or data.get("error") or not data.get("access_token") or not AUTH.is_file():
        if old is not None:
            AUTH.write_bytes(old)
        else:
            AUTH.unlink(missing_ok=True)
        die("GOG didn't accept that code. A code works once and expires within a minute or so: "
            "sign in again and paste the new address straight away.")
    os.chmod(AUTH, 0o600)
    name = ""
    try:
        d = http_json(f"{GOG_EMBED}/userData.json", data["access_token"], timeout=20)
        name = d.get("username") or d.get("email") or ""
    except (urllib.error.URLError, ValueError, OSError):
        pass
    write_json(USER, {"username": name})
    LIBCACHE.unlink(missing_ok=True)
    say(f"Signed in to GOG{' as ' + name if name else ''}.")
    return 0


def gog_logout(args):
    for p in (AUTH, USER, LIBCACHE):
        p.unlink(missing_ok=True)
    say("Signed out of GOG. Installed games stay.")
    return 0


# ------------------------------------------------------------------ GOG: the library

def fetch_library(token):
    """The games the account owns that have a Windows version: [{id, title, slug, image, year}] (year 0: GOG
    gives no release date)."""
    games, page, total = [], 1, 1
    try:
        while page <= total:
            d = http_json(f"{GOG_EMBED}/account/getFilteredProducts?mediaType=1&page={page}", token)
            total = int(d.get("totalPages") or 1)
            for p in d.get("products") or []:
                if p.get("isGame") is False or not p.get("id"):
                    continue
                if (p.get("worksOn") or {}).get("Windows") is False:
                    continue
                released = p.get("releaseDate")
                games.append({"id": str(p["id"]), "title": p.get("title") or str(p["id"]),
                              "slug": p.get("slug") or "", "image": p.get("image") or "",
                              "year": year_of(released.get("date") if isinstance(released, dict) else released)})
            page += 1
        return games
    except (urllib.error.URLError, ValueError, OSError, KeyError) as e:
        say(f"(GOG's games list didn't load the usual way: {e}; trying product by product)")
    # the other way: the owned IDs, then each product's own page
    owned = http_json(f"{GOG_EMBED}/user/data/games", token).get("owned") or []

    def one(pid):
        try:
            d = http_json(f"{GOG_API}/products/{pid}", None, timeout=30)
        except (urllib.error.URLError, ValueError, OSError):
            return None
        if d.get("game_type", "game") != "game":
            return None
        return {"id": str(pid), "title": d.get("title") or str(pid), "slug": d.get("slug") or "", "image": "",
                "year": year_of(d.get("release_date"))}

    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        games = [g for g in pool.map(one, owned) if g]
    return games


def gog_library(refresh=False):
    cache = read_json(LIBCACHE)
    fresh = (cache.get("games") and cache.get("v") == LIBRARY_VERSION
             and time.time() - cache.get("fetched", 0) < LIBRARY_MAX_AGE)
    if fresh and not refresh:
        return cache["games"]
    token = gog_token()
    if not token:
        if cache.get("games"):
            return cache["games"]
        die("You're not signed in to GOG (or the sign-in expired). Sign in again.")
    try:
        games = fetch_library(token)
    except (urllib.error.URLError, ValueError, OSError) as e:
        if cache.get("games"):
            say(f"(couldn't reach GOG: {e}; showing the list from before)")
            return cache["games"]
        die(f"couldn't get your GOG games: {e}")
    games.sort(key=lambda g: g["title"].lower())
    write_json(LIBCACHE, {"fetched": time.time(), "v": LIBRARY_VERSION, "games": games})
    return games


def gog_list(args):
    if not AUTH.is_file():
        die("You're not signed in to GOG.")
    games = gog_library(args.refresh)
    have = installed("gog")
    rows = [{"id": g["id"], "title": g["title"], "installed": g["id"] in have,
             "size": have.get(g["id"], {}).get("size", 0), "image": g.get("image", ""),
             "year": int(g.get("year") or 0)} for g in games]
    for gid, rec in have.items():     # an installed game the list doesn't show (removed from the account)
        if not any(r["id"] == gid for r in rows):
            rows.append({"id": gid, "title": rec["title"], "installed": True, "size": rec.get("size", 0),
                         "image": "", "year": 0})
    if args.json:
        print(json.dumps({"games": rows}))
    else:
        for r in rows:
            say(f"{r['id']:>12}  {'installed' if r['installed'] else '         '}  {r['title']}")
        say(f"{len(rows)} game(s)")
    return 0


# ------------------------------------------------------------------ where games go

def folder_choices():
    """The places a game can go: the Mac's game folders as the VM sees them, then the VM's disk.
    -> [{name, label, path, default}]"""
    conf = read_json(LIBRARIES)
    default = conf.get("default") or "mac"
    out = []
    for f in conf.get("folders") or []:
        name = f.get("name")
        mount = MOUNT_ROOT / str(name)
        if name and mount.is_dir() and os.access(mount, os.W_OK):
            out.append({"name": name, "label": f.get("label") or name, "path": str(mount)})
    out.append({"name": "vm", "label": "VM disk", "path": str(HOME / "Games")})
    pick = next((i for i, c in enumerate(out) if c["name"] == default), 0)
    for i, c in enumerate(out):
        c["default"] = i == pick
        c["free"] = free_space(c["path"])
    return out


def free_space(path):
    p = Path(path)
    while not p.exists() and p != p.parent:
        p = p.parent
    try:
        return shutil.disk_usage(p).free
    except OSError:
        return 0


def choose_folder(wanted, old=None):
    """The game folder an install goes to: the one asked for, else where the game already is, else the default."""
    choices = folder_choices()
    if wanted:
        choice = next((c for c in choices if c["name"] == wanted), None)
        if choice is None:
            die(f"There is no game folder '{wanted}' here ({', '.join(c['name'] for c in choices)}). "
                "A drive may not be connected.")
        return choice
    if old and old.get("folder") in [c["name"] for c in choices]:
        return next(c for c in choices if c["name"] == old["folder"])
    return next((c for c in choices if c["default"]), choices[-1])


def gog_folders(args):
    out = folder_choices()
    if args.json:
        print(json.dumps({"folders": out}))
    else:
        for c in out:
            say(f"{c['name']:<10} {c['label']:<20} {human(c['free']):>9} free  {c['path']}{'  (default)' if c['default'] else ''}")
    return 0


# ------------------------------------------------------------------ GOG: installing

PROGRESS = re.compile(r"= Progress: ([\d.]+) (\d+)/(\d+), Running for: [\d:]+, ETA: ([\d:]+)")


def pick_language(info, wanted):
    langs = info.get("languages") or []
    if wanted:
        return wanted
    if not langs or "en-US" in langs:
        return "en-US"
    english = [l for l in langs if l.lower().startswith("en")]
    return (english or langs)[0]


def play_task(dest):
    """(exe, args, startdir) from the game's goggame-ID.info: its primary play task."""
    infos = sorted(dest.glob("goggame-*.info")) + sorted(dest.glob("*/goggame-*.info"))
    best = None
    for f in infos:
        d = read_json(f)
        tasks = [t for t in d.get("playTasks") or [] if t.get("type", "FileTask") == "FileTask" and t.get("path")]
        for t in tasks:
            score = (2 if t.get("isPrimary") else 0) + (1 if t.get("category") == "game" else 0)
            if str(t["path"]).lower().endswith(".exe") and (best is None or score > best[0]):
                best = (score, f.parent, t)
    if best is None:
        return None
    _score, root, t = best
    rel = str(t["path"]).replace("\\", "/")
    exe = find_nocase(root, rel)
    if exe is None:
        return None
    wd = str(t.get("workingDir") or "").replace("\\", "/")
    start = find_nocase(root, wd) if wd else exe.parent
    return str(exe), str(t.get("arguments") or ""), str(start if start and start.is_dir() else exe.parent)


def find_nocase(root, rel):
    """root/rel where a part's capitals may differ (GOG's paths come from Windows)."""
    p = Path(root)
    for part in [x for x in rel.split("/") if x not in ("", ".")]:
        if (p / part).exists():
            p = p / part
            continue
        try:
            match = next((c for c in p.iterdir() if c.name.lower() == part.lower()), None)
        except OSError:
            return None
        if match is None:
            return None
        p = match
    return p


def image_ext(blob):
    """The file extension for a picture's bytes (Steam looks at the name), None for anything but PNG and JPEG."""
    if blob[:4] == b"\x89PNG":
        return ".png"
    if blob[:2] == b"\xff\xd8":
        return ".jpg"
    return None


def art_file(key, kind):
    """Our copy of one of a game's pictures (cover, hero, logo, icon), or None."""
    for ext in (".jpg", ".png"):
        f = ART / f"{key}_{kind}{ext}"
        if f.is_file():
            return f
    return None


def store_art(key, rec, kind, blob):
    """Keep blob as the game's `kind` picture. A copy of the earlier picture that we put in Steam's grid
    folder (same bytes) goes too, so the next sync puts this one there; a picture the player chose stays."""
    ext = image_ext(blob)
    if ext is None:
        return False
    old = art_file(key, kind)
    old_blob = None
    if old is not None:
        try:
            old_blob = old.read_bytes()
        except OSError:
            pass
    if old_blob == blob:
        return True
    ART.mkdir(parents=True, exist_ok=True)
    new = ART / f"{key}_{kind}{ext}"
    tmp = new.with_name(new.name + ".tmp")
    tmp.write_bytes(blob)
    os.replace(tmp, new)
    if old is not None and old != new:
        old.unlink(missing_ok=True)
    if old_blob and rec.get("appid"):
        for u in steam_user_dirs():
            for k, suffix in GRID_ART:
                for e in GRID_EXTS if k == kind else ():
                    f = u / "config/grid" / f"{rec['appid']}{suffix}{e}"
                    try:
                        if f.is_file() and f.read_bytes() == old_blob:
                            f.unlink()
                    except OSError:
                        pass
    return True


def gog_art_links(gid, timeout):
    """GOG's pictures for a game, from its public page: ({cover, hero, logo, icon: address}, complete), or
    None when GOG can't be reached."""
    def url(u):
        return ("https:" + u) if u and u.startswith("//") else u

    links = {}
    try:
        d = http_json(f"{GOG_API}/v2/games/{gid}?locale=en-US", None, timeout=timeout)
        for k, v in ((d.get("_links") or {}) if isinstance(d, dict) else {}).items():
            if isinstance(v, dict) and isinstance(v.get("href"), str):
                links[k] = url(v["href"])
    except (urllib.error.URLError, ValueError, OSError):
        pass
    complete = bool(links)
    if not links:
        # the older answer has no cover or logo: take its background and icon now, the rest on a later try
        try:
            d = http_json(f"{GOG_API}/products/{gid}", None, timeout=timeout)
        except (urllib.error.URLError, ValueError, OSError):
            return None
        imgs = d.get("images") if isinstance(d, dict) else None
        imgs = imgs if isinstance(imgs, dict) else {}
        links = {"backgroundImage": url(imgs.get("background")),
                 "icon": url(imgs.get("icon") or imgs.get("sidebarIcon"))}
    return ({"cover": links.get("boxArtImage"),
             "hero": links.get("galaxyBackgroundImage") or links.get("backgroundImage"),
             "logo": links.get("logo"), "icon": links.get("icon") or links.get("iconSquare")}, complete)


def fetch_art(rec, timeout=20):
    """The pictures Steam's library shows for a game, from the store's public pages, best effort: the tall
    cover (the library's tiles), the background (the banner of the game's page and the wide tile), the
    title logo and the icon. -> True when everything the store lists came down, False when something
    didn't, None when the store couldn't be reached. The attempt is noted in rec (art: the version
    fetched, art_try: when)."""
    key = art_key(rec)
    rec["art_try"] = int(time.time())
    got = epic_art_links(str(rec["id"])) if rec.get("store") == "epic" else gog_art_links(str(rec["id"]), timeout)
    if got is None:
        return None
    links, complete = got
    for kind in ("cover", "hero", "logo", "icon"):
        href = links.get(kind)
        if not href:
            continue
        try:
            blob = http_blob(href, timeout)
            stored = store_art(key, rec, kind, blob)
        except (urllib.error.URLError, OSError):
            complete = False
            continue
        if kind == "icon" and stored:
            rec["icon"] = str(art_file(key, "icon"))
    (ART / f"{key}_wide.jpg").unlink(missing_ok=True)     # (the hero is the wide tile too now)
    if complete:
        rec["art"] = ART_VERSION
    return complete


def note_art(games):
    """Fetch the pictures once for a game that hasn't got the current ones (it was installed before the
    cover and logo were fetched, or the store couldn't be reached then). A failed try waits an hour; with
    the store out of reach the other games wait for the next sync."""
    now = time.time()
    for rec in games.values():
        if rec.get("art", 0) >= ART_VERSION or now - rec.get("art_try", 0) < ART_RETRY or not rec.get("appid"):
            continue
        result = fetch_art(rec, timeout=10)
        update_installed(rec.get("store", "gog"), str(rec["id"]), rec)
        if result is None:
            break


def copy_art(grid, games):
    """Put each game's pictures in Steam's grid folder, where it looks for a non-Steam game's, unless the
    player has set their own there."""
    for rec in games.values():
        for kind, suffix in GRID_ART:
            src = art_file(art_key(rec), kind)
            if src is None or not rec.get("appid"):
                continue
            stem = f"{rec['appid']}{suffix}"
            if any((grid / (stem + e)).exists() for e in GRID_EXTS):
                continue
            try:
                grid.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(src, grid / (stem + src.suffix))
            except OSError:
                pass


def run_download(cmd, env, progress):
    """A downloader's run (gogdl, Legendary), its progress as @@ lines; progress is the regular expression
    for its progress line (percent, parts done, parts, time left). -> (exit code, the last lines it said)."""
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env,
                            stdin=subprocess.DEVNULL, bufsize=0)
    tail, buf, last_pct = [], b"", -1.0
    while True:
        chunk = proc.stdout.read1(4096) if hasattr(proc.stdout, "read1") else proc.stdout.read(4096)
        if not chunk:
            break
        buf += chunk
        while True:
            m = re.search(rb"[\r\n]", buf)
            if not m:
                break
            line, buf = buf[:m.start()].decode("utf-8", "replace").strip(), buf[m.end():]
            if not line:
                continue
            pm = progress.search(line)
            if pm:
                pct = float(pm.group(1))
                if pct != last_pct:
                    last_pct = pct
                    say(f"@@progress {pct:.1f} {pm.group(2)} {pm.group(3)} {pm.group(4)}")
            elif "Downloaded:" in line or " + Download" in line or " + Disk" in line or "Cache usage:" in line:
                continue
            else:
                tail = (tail + [line])[-6:]
    return proc.wait(), tail


def gog_install(args):
    gid = str(args.id)
    if not gid.isdigit():
        die("usage: bottle-stores gog install GAME_ID (the number from the games list)")
    if not AUTH.is_file():
        die("You're not signed in to GOG.")
    cache = {g["id"]: g for g in read_json(LIBCACHE).get("games") or []}
    have = installed("gog")
    title = (have.get(gid) or cache.get(gid) or {}).get("title") or f"GOG game {gid}"
    choice = choose_folder(args.folder, have.get(gid))
    base = Path(choice["path"]) / "GOG Games"

    say(f"Looking up {title}…")
    code, out, err = gogdl_run(["info", gid, "--platform", "windows"] + (["--lang", args.lang] if args.lang else []),
                               timeout=180)
    info = last_json(out)
    if code != 0 or not isinstance(info, dict) or "folder_name" not in info:
        why = [l for l in (err or "").strip().splitlines() if l.strip()][-1:] or [""]
        if "support" in why[0].lower() or "content system" in why[0].lower():
            die(f"{title} has no Windows download on GOG.")
        die(f"GOG didn't give the details for {title}: {why[0] or 'no answer'}. "
            "Is it in your library, and are you still signed in?")
    lang = pick_language(info, args.lang)
    need = int((info.get("size") or {}).get("disk_size") or 0)
    base.mkdir(parents=True, exist_ok=True)
    dest = base / info["folder_name"]
    free = free_space(base) + (sum(f.stat().st_size for f in dest.rglob("*") if f.is_file()) if dest.is_dir() else 0)
    if need and free < need + SPACE_MARGIN:
        die(f"{title} needs {human(need)} and there's {human(free)} free in {choice['label']}. "
            "Free some space or pick another game folder.")
    say(f"Downloading {title}{f' ({human(need)})' if need else ''} to {choice['label']} / GOG Games / {info['folder_name']}")
    with locked("gog-" + gid):
        code, tail = run_download(gogdl_cmd() + ["--auth-config-path", str(AUTH), "download", gid, "--path", str(base),
                                                 "--platform", "windows", "--lang", lang], gogdl_env(), PROGRESS)
        if code != 0:
            die(f"the download stopped ({tail[-1] if tail else 'exit ' + str(code)}). Starting it again picks up what's done.")
        task = play_task(dest)
        if task is None:
            die(f"{title} downloaded to {dest}, but I couldn't find which program starts it "
                "(no goggame-*.info with a play task). Add it to Steam by hand from that folder.")
        exe, gargs, start = task
        old = have.get(gid) or {}
        # (GOG doesn't always say how big a game is up front: measure what's on disk then)
        size = need or sum(f.stat().st_size for f in dest.rglob("*") if f.is_file())
        rec = {"id": gid, "store": "gog", "title": title, "dir": str(dest), "exe": exe, "args": gargs, "startdir": start,
               "folder": choice["name"], "size": size, "installed": int(time.time()), "lang": lang,
               "slug": (cache.get(gid) or {}).get("slug", ""), "icon": old.get("icon", "")}
        rec["appid"] = old.get("appid") or shortcut_appid(f'"{exe}"', title)
        rec["galaxy"] = bool(uses_galaxy(dest))
        rec["art"], rec["art_try"] = old.get("art", 0), old.get("art_try", 0)
        if rec["art"] < ART_VERSION:
            fetch_art(rec)
        update_installed("gog", gid, rec)
    say(f"@@done {gid}")
    say(f"Installed {title}. It shows in Steam (collection “{GOG_TAG}”) after Steam restarts.")
    return 0


def gog_remove(args):
    gid = str(args.id)
    have = installed("gog")
    rec = have.get(gid)
    if rec is None:
        die(f"GOG game {gid} isn't installed here.")
    rec["store"] = "gog"
    with locked("gog-" + gid):
        delete_game_folder(rec, "GOG Games")
        # gogdl's record of what it installed: left behind, a reinstall would skip files
        for m in (GOGDL_CONFIG / "heroic_gogdl/manifests").glob(gid + "*"):
            m.unlink(missing_ok=True)
        forget_game(rec, args.purge)
        update_installed("gog", gid, None)
    say(f"@@done {gid}")
    say(f"Removed {rec['title']}." + ("" if args.purge else " Its saves and settings (the Wine prefix) are kept."))
    return 0


def delete_game_folder(rec, store_folder):
    """Delete an installed game's files, but only inside a folder called store_folder ("GOG Games"):
    never something else by mistake."""
    d = Path(rec["dir"])
    if d.is_dir() and d.parent.name == store_folder:
        say(f"Deleting {rec['title']} ({d})…")
        shutil.rmtree(d, ignore_errors=True)
        if d.exists():
            die(f"couldn't delete everything in {d}.")
    elif d.is_dir():
        say(f"{d} isn't in a folder called {store_folder}; I left its files alone.")


def forget_game(rec, purge):
    """What a removed game leaves besides its files: its Wine prefix (only with purge: it holds saves
    and settings), our pictures of it, and the copies of them in Steam's grid folder."""
    if purge:
        for apps in steam_libraries():
            shutil.rmtree(apps / "compatdata" / str(rec["appid"]), ignore_errors=True)
    for f in ART.glob(f"{art_key(rec)}_*"):
        f.unlink(missing_ok=True)
    for u in steam_user_dirs():
        for _kind, suffix in GRID_ART:
            for e in GRID_EXTS:
                (u / "config/grid" / f"{rec['appid']}{suffix}{e}").unlink(missing_ok=True)


# ------------------------------------------------------------------ Epic Games: Legendary

EPIC_PROGRESS = re.compile(r"= Progress: ([\d.]+)% \((\d+)/(\d+)\), Running for [\d:]+, ETA: ([\d:]+)")
EPIC_APP = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")


def legendary_available():
    return bool(os.environ.get("BOTTLE_LEGENDARY")) or (Path(LEGENDARY_DIR) / "legendary/cli.py").is_file()


def legendary_cmd():
    custom = os.environ.get("BOTTLE_LEGENDARY")
    if custom:
        return shlex.split(custom)
    return [sys.executable or "python3", "-c", LGD_BOOT]


def legendary_env():
    # (without Steam's LD_PRELOAD and LD_LIBRARY_PATH: a game's launch sets them, and they don't suit Python)
    env = {k: v for k, v in os.environ.items() if k not in ("LD_PRELOAD", "LD_LIBRARY_PATH")}
    env["PYTHONPATH"] = LEGENDARY_DIR + (":" + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    env["LEGENDARY_CONFIG_PATH"] = str(LGD_CONFIG)
    env["PYTHONUNBUFFERED"] = "1"
    env["PYTHONWARNINGS"] = "ignore"
    return env


def legendary_run(args, timeout=300):
    """Legendary's output, without ever showing it (a launch and a sign-in print tokens). -> (code, out, err)"""
    if not legendary_available():
        die("Epic's downloader isn't in the VM yet. Choose Bottle > Update the Bottle, then try again.")
    private_dirs()
    try:
        r = subprocess.run(legendary_cmd() + args, capture_output=True, text=True, timeout=timeout,
                           env=legendary_env(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        die("Epic didn't answer in time. Check the VM's network and try again.")
    return r.returncode, r.stdout, r.stderr


def private_dirs():
    """Our folder and Legendary's hold sign-ins: only the player gets in."""
    for d in (STATE, LGD_CONFIG):
        d.mkdir(parents=True, exist_ok=True)
        os.chmod(d, 0o700)


def lgd_json(text):
    """The last line of Legendary's output that is JSON (a list or an object), or None."""
    for line in reversed((text or "").strip().splitlines()):
        line = line.strip()
        if line[:1] in ("[", "{"):
            try:
                return json.loads(line)
            except ValueError:
                continue
    return None


def lgd_why(text):
    """What went wrong, from Legendary's messages: a failed check if it names one, else its last error line."""
    lines = [l.strip() for l in (text or "").splitlines() if l.strip()]
    fails = [l for l in lines if "Failure:" in l]
    bad = [l for l in lines if re.search(r"\b(ERROR|CRITICAL|FATAL)\b", l)]
    line = (fails or bad or lines or ["no answer"])[0 if fails else -1]
    return re.sub(r"^(\[[^\]]*\]\s*[A-Z]+:\s*|\s*!\s*Failure:\s*)", "", line)[:200]


def epic_user():
    """The signed-in Epic account's saved data, or {} (not signed in, or the sign-in has run out)."""
    d = read_json(LGD_CONFIG / "user.json")
    if not d.get("refresh_token"):
        return {}
    exp = d.get("refresh_expires_at")
    if isinstance(exp, str):
        try:
            if datetime.fromisoformat(exp.replace("Z", "+00:00")).timestamp() < time.time():
                return {}
        except ValueError:
            pass
    return d


def epic_extract_code(text):
    """The code from what Epic's sign-in page ends on: JSON with "authorizationCode", or the bare code."""
    text = (text or "").strip()
    m = re.search(r'"authorizationCode"\s*:\s*"([^"]+)"', text)
    if m:
        return m.group(1)
    m = re.search(r"[?&#]code=([^&#\s\"']+)", text)
    if m:
        return m.group(1)
    text = text.strip("\"'")
    return text if re.fullmatch(r"[A-Za-z0-9]{16,64}", text) else None


def epic_status(args):
