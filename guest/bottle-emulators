#!/usr/bin/env bash
# bottle-emulators: the console emulators Desktop Mode comes with (Nov 3): Ryujinx (Nintendo Switch; its
# own ARM build, not Discover's: see below), RPCS3 (PlayStation 3), Play! (PlayStation 2; PCSX2 has no
# ARM build) and RetroArch (the older consoles, through its cores), each pinned to Desktop Mode's taskbar
# once.
#
# Ryujinx: Discover's Ryujinx is a Flatpak whose OpenGL/Vulkan never reached this VM's GPU before
# bottle-flatpak-gpu, and it shared one settings file with this one (each wrote its own GPU into it). This
# one is Ryubing's ARM build, pinned (version + SHA-256), in ~/.local/opt/ryujinx, with the menu entry
# "Ryujinx (Mac GPU)". RPCS3, Play! and RetroArch come from Flathub (they get the Mac's GPU through
# bottle-flatpak-gpu, in Vulkan only: OpenGL in a Flatpak stays on the processor. RetroArch starts on Vulkan
# (set here, once); set Play! to Vulkan in its own settings). RetroArch's cores come from its Online
# Updater (libretro's ARM builds). RetroArch's menu pictures and fonts (its "assets") don't come with the
# Flatpak here: without them the menu shows white squares and a blocky built-in font (Nov 3). They're
# put in its own settings folder from libretro's assets.zip (what the Online Updater's "Update Assets"
# gets), once; a later "Update Assets" in RetroArch writes to the same folder.
#
#   bottle-emulators [install]   install what's missing, pin each to the taskbar the first time
#   bottle-emulators status
# Needs about 4.5 GB on the VM's disk the first time (mostly the Flatpaks' KDE runtime): skipped without the room.
# BOTTLE_EMULATORS=0: nothing.
set -uo pipefail
RYU_VER=1.3.3
RYU_URL="https://git.ryujinx.app/projects/Ryubing/releases/download/$RYU_VER/ryujinx-$RYU_VER-linux_arm64.tar.gz"
RYU_SHA256=0485b611583c401733d706ec39db40999f08ba4e22f6f38b0d94602a8016d295
RYU_DIR="$HOME/.local/opt/ryujinx"
APPS="$HOME/.local/share/applications"
STATE="$HOME/.config/steamos-bottle"
FLATPAKS=(net.rpcs3.RPCS3 org.purei.Play org.libretro.RetroArch)
PIN=(ryujinx-gpu.desktop net.rpcs3.RPCS3.desktop org.purei.Play.desktop org.libretro.RetroArch.desktop)
say() { printf '%s\n' "$*"; }
[[ "${BOTTLE_EMULATORS:-1}" == 0 ]] && exit 0
mkdir -p "$STATE" "$APPS"

ryujinx() {
  if [[ "$(cat "$RYU_DIR/.version" 2>/dev/null)" != "$RYU_VER" || ! -x "$RYU_DIR/Ryujinx" ]]; then
    local tmp; tmp="$(mktemp -d)"
    curl -fsSL --max-time 300 -o "$tmp/r.tgz" "$RYU_URL" || { rm -rf "$tmp"; say "  Ryujinx: couldn't download $RYU_VER"; return 1; }
    echo "$RYU_SHA256  $tmp/r.tgz" | sha256sum -c --quiet - || { rm -rf "$tmp"; say "  Ryujinx: checksum mismatch"; return 1; }
    mkdir -p "$tmp/x" && tar xzf "$tmp/r.tgz" -C "$tmp/x" && [[ -x "$tmp/x/publish/Ryujinx" ]] || { rm -rf "$tmp"; say "  Ryujinx: couldn't unpack"; return 1; }
    rm -rf "$RYU_DIR.new" && mkdir -p "${RYU_DIR%/*}" && mv "$tmp/x/publish" "$RYU_DIR.new" && echo "$RYU_VER" > "$RYU_DIR.new/.version" \
      && rm -rf "$RYU_DIR" && mv "$RYU_DIR.new" "$RYU_DIR"
    rm -rf "$tmp"
    say "  Ryujinx $RYU_VER installed"
  fi
  cat > "$APPS/ryujinx-gpu.desktop.tmp" <<D
[Desktop Entry]
Type=Application
Name=Ryujinx (Mac GPU)
Comment=Nintendo Switch emulator, drawing on the Mac's graphics card
Exec=$RYU_DIR/Ryujinx.sh %f
Icon=$RYU_DIR/Ryujinx.png
Terminal=false
Categories=Game;Emulator;
MimeType=application/x-nx-nca;application/x-nx-nro;application/x-nx-nso;application/x-nx-nsp;application/x-nx-xci;
StartupWMClass=Ryujinx
D
  # its icon (the download has none): Flathub's, from the store data Flatpak keeps (as Discover shows it)
  local ic="$HOME/.local/share/icons/hicolor/128x128/apps/ryujinx-gpu.png" f
  if [[ ! -s "$ic" ]]; then
    f="$(ls "$HOME"/.local/share/flatpak/appstream/flathub/*/active/icons/128x128/io.github.ryubing.Ryujinx.png 2>/dev/null | head -1)"
    # a new system has no store data yet (Nov 4: Ryujinx showed a gamepad): Flathub's, a few MB
    if [[ -z "$f" ]] && command -v flatpak >/dev/null; then
      timeout 300 flatpak update --user --appstream flathub >/dev/null 2>&1 || true
      f="$(ls "$HOME"/.local/share/flatpak/appstream/flathub/*/active/icons/128x128/io.github.ryubing.Ryujinx.png 2>/dev/null | head -1)"
    fi
    [[ -n "$f" ]] && mkdir -p "${ic%/*}" && cp -f "$f" "$ic"
  fi
  if [[ -s "$ic" ]]; then sed -i "s|^Icon=.*|Icon=ryujinx-gpu|" "$APPS/ryujinx-gpu.desktop.tmp"
  else sed -i "s|^Icon=.*|Icon=applications-games|" "$APPS/ryujinx-gpu.desktop.tmp"; fi
  mv -f "$APPS/ryujinx-gpu.desktop.tmp" "$APPS/ryujinx-gpu.desktop"
}

flatpaks() {
  command -v flatpak >/dev/null || { say "  no Flatpak (Desktop Mode installs it)"; return 1; }
  local missing=() a free
  for a in "${FLATPAKS[@]}"; do flatpak info --user "$a" >/dev/null 2>&1 || missing+=("$a"); done
  (( ${#missing[@]} )) || return 0
  # room for what's missing: about 1 GB an app, 2.5 GB for each runtime not here yet (KDE's with its GL
  # libraries), 1 GB to spare
  local need=$((1024 * 1024)) rt rts=()
  for a in "${missing[@]}"; do
    need=$((need + 1024 * 1024))
    rt="$(timeout 60 flatpak remote-info --user flathub "$a" 2>/dev/null | sed -n 's/^ *Runtime: //p')"
    [[ -z "$rt" ]] && { need=$((need + 5 * 1024 * 1024 / 2)); continue; }
    [[ " ${rts[*]-} " == *" $rt "* ]] && continue; rts+=("$rt")
    flatpak info --user "${rt%%/*}//${rt##*/}" >/dev/null 2>&1 || need=$((need + 5 * 1024 * 1024 / 2))
  done
  free="$(df -Pk "$HOME" | awk 'NR == 2 {print $4}')"
  if (( free < need )); then say "  not enough space on the VM's disk for ${missing[*]} (needs about $(( (need + 1024 * 1024 - 1) / 1024 / 1024 )) GB free)"; return 1; fi
  timeout 3600 flatpak install --user -y --noninteractive flathub "${missing[@]}" >/dev/null 2>&1 \
    && say "  installed ${missing[*]}" || { say "  couldn't install ${missing[*]} from Flathub"; return 1; }
}

# RetroArch on Vulkan, once (its default, OpenGL, would draw on the processor here); a player's own choice
# afterwards stays. RetroArch fills in the rest of its settings file itself.
retroarch_vulkan() {
  local cfg="$HOME/.var/app/org.libretro.RetroArch/config/retroarch/retroarch.cfg" mark="$STATE/retroarch-vulkan"
  [[ -e "$mark" ]] && return 0
  flatpak info --user org.libretro.RetroArch >/dev/null 2>&1 || return 0
  mkdir -p "${cfg%/*}"
  if grep -q '^video_driver *=' "$cfg" 2>/dev/null; then sed -i 's|^video_driver *=.*|video_driver = "vulkan"|' "$cfg"
  else echo 'video_driver = "vulkan"' >> "$cfg"; fi
  touch "$mark"
}

# RetroArch's assets (menu icons, fonts), when its assets folder has none: libretro's assets.zip into
# ~/.var/app/org.libretro.RetroArch/config/retroarch/assets, and retroarch.cfg pointed there. Tried again
# at the next Desktop Mode start until it works (no network, no room...). BOTTLE_RA_ASSETS_URL: another zip.
RA_ASSETS_URL="${BOTTLE_RA_ASSETS_URL:-https://buildbot.libretro.com/assets/frontend/assets.zip}"
retroarch_assets() {
  local base="$HOME/.var/app/org.libretro.RetroArch/config/retroarch"
  local dir="$base/assets" cfg="$base/retroarch.cfg" tmp free
  flatpak info --user org.libretro.RetroArch >/dev/null 2>&1 || return 0
  if [[ ! -d "$dir/ozone/png" || ! -d "$dir/pkg" ]]; then
    free="$(df -Pk "$HOME" | awk 'NR == 2 {print $4}')"
    (( free > 600 * 1024 )) || { say "  RetroArch's menu pictures: not enough space on the VM's disk (needs about 600 MB free)"; return 1; }
    tmp="$(mktemp -d)"
    curl -fsSL --max-time 600 -o "$tmp/assets.zip" "$RA_ASSETS_URL" || { rm -rf "$tmp"; say "  RetroArch's menu pictures: couldn't download them"; return 1; }
    mkdir -p "$tmp/x"
    if command -v unzip >/dev/null; then unzip -qo "$tmp/assets.zip" -d "$tmp/x" >/dev/null 2>&1
    else python3 -I -m zipfile -e "$tmp/assets.zip" "$tmp/x" >/dev/null 2>&1; fi
    [[ -d "$tmp/x/ozone/png" && -d "$tmp/x/pkg" ]] || { rm -rf "$tmp"; say "  RetroArch's menu pictures: the download wasn't what was expected"; return 1; }
    mkdir -p "$dir" && cp -a "$tmp/x/." "$dir/" || { rm -rf "$tmp"; say "  RetroArch's menu pictures: couldn't copy them"; return 1; }
    rm -rf "$tmp"
    say "  RetroArch's menu pictures and fonts installed"
  fi
  # pointed at them (RetroArch writes "~/..." there, or nothing before its first start)
  mkdir -p "$base"
  if grep -q '^assets_directory *=' "$cfg" 2>/dev/null; then
    grep -qx "assets_directory = \"$dir\"" "$cfg" || sed -i "s|^assets_directory *=.*|assets_directory = \"$dir\"|" "$cfg"
  else
    echo "assets_directory = \"$dir\"" >> "$cfg"
  fi
}

# Each emulator on the taskbar, once (taken off by the player, it stays off): through Plasma's scripting,
# so only while Plasma runs (bottle-session look runs this then).
# A new desktop's taskbar has its launchers as Plasma's defaults, not in its settings: reading them gives
# none, and until Nov 4 writing the emulators replaced them (System Settings, Discover, Dolphin and Firefox
# went missing, Michael's M1). Now a taskbar whose launchers are none, or only the emulators, gets the
# defaults back first, once (taskbar-defaults). And Plasma's list of applications is brought up to date
# first: an emulator installed while the desktop was open was pinned as an application it didn't know yet
# (a blank icon; a click on it opened the "Open with" chooser).
DEFAULT_LAUNCHERS=(systemsettings.desktop org.kde.discover.desktop org.kde.dolphin.desktop org.mozilla.firefox.desktop)
pin() {
  local done_file="$STATE/emulators-pinned" seeded="$STATE/taskbar-defaults" bus add=() d seed=0
  bus="$(cat "$HOME/.cache/steamos-bottle/plasma-bus" 2>/dev/null)"
  [[ -n "$bus" ]] && command -v qdbus-qt6 >/dev/null || return 0
  for d in "${PIN[@]}"; do
    grep -qx "$d" "$done_file" 2>/dev/null && continue
    [[ -f "$APPS/$d" || -f "$HOME/.local/share/flatpak/exports/share/applications/$d" || -f "/var/lib/flatpak/exports/share/applications/$d" ]] && add+=("$d")
  done
  [[ -e "$seeded" ]] || seed=1
  (( ${#add[@]} || seed )) || return 0
  command -v kbuildsycoca6 >/dev/null && { DBUS_SESSION_BUS_ADDRESS="$bus" timeout 60 kbuildsycoca6 >/dev/null 2>&1 || true; }
  local list ours defaults out
  list=""; (( ${#add[@]} )) && list="$(printf "'applications:%s'," "${add[@]}")"
  ours="$(printf "'applications:%s'," "${PIN[@]}")"
  defaults="$(printf "'applications:%s'," "${DEFAULT_LAUNCHERS[@]}")"
  out="$(DBUS_SESSION_BUS_ADDRESS="$bus" timeout 15 qdbus-qt6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var add = [${list%,}], ours = [${ours%,}], defaults = [${defaults%,}], seed = $seed, n = 0, ps = panels();
    function base(x) { return x.split('?')[0]; }
    for (var i = 0; i < ps.length; i++) { var ids = ps[i].widgetIds;
      for (var j = 0; j < ids.length; j++) { var w = ps[i].widgetById(ids[j]);
        if (w.type == 'org.kde.plasma.icontasks' || w.type == 'org.kde.plasma.taskmanager') {
          w.currentConfigGroup = ['General'];
          var l = w.readConfig('launchers', []); if (typeof l == 'string') l = l ? l.split(',') : [];
          l = l.filter(function (x) { return base(x) != 'applications:' && x != ''; });
          if (seed) { var onlyOurs = true;
            for (var m = 0; m < l.length; m++) if (ours.indexOf(base(l[m])) < 0) onlyOurs = false;
            if (onlyOurs) l = defaults.concat(l); }
          for (var k = 0; k < add.length; k++) { var have = false;
            for (var m = 0; m < l.length; m++) if (base(l[m]) == add[k]) have = true;
            if (!have) l.push(add[k]); }
          w.writeConfig('launchers', l); w.reloadConfig(); n++; } } }
    print('pinned ' + n);" 2>/dev/null)"
  if grep -q '^pinned [1-9]' <<<"$out"; then
    (( ${#add[@]} )) && { printf '%s\n' "${add[@]}" >> "$done_file"; say "  pinned to the taskbar: ${add[*]}"; }
    (( seed )) && touch "$seeded"
  fi
}

case "${1:-install}" in
  install) flatpaks; retroarch_vulkan; retroarch_assets; ryujinx; pin; exit 0 ;;
  pin) pin; exit 0 ;;
  status)
    say "Ryujinx: $(cat "$RYU_DIR/.version" 2>/dev/null || echo "not installed")"
    for a in "${FLATPAKS[@]}"; do say "$a: $(flatpak info --user "$a" 2>/dev/null | sed -n 's/^ *Version: //p' || true)"; done
    say "RetroArch menu pictures: $([[ -d "$HOME/.var/app/org.libretro.RetroArch/config/retroarch/assets/ozone/png" ]] && echo yes || echo no)"
    say "pinned: $(cat "$STATE/emulators-pinned" 2>/dev/null | tr '\n' ' ')"; exit 0 ;;
  *) echo "usage: bottle-emulators [install | pin | status]" >&2; exit 2 ;;
esac
