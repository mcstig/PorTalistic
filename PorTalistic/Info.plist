<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shown in macOS's own prompt when a game lives on an external disk. Without it the
	     prompt is the system's generic sentence, which doesn't say why an app called
	     PorTalistic wants the drive. It does not stop the prompt: that grant belongs to
	     Privacy & Security, not to the app. -->
	<key>NSRemovableVolumesUsageDescription</key>
	<string>PorTalistic needs this to find and launch the games you keep on this drive.</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>NSApplicationCrashOnExceptions</key>
	<true/>
	<!-- Where updates come from: appcast.xml in this project's repository, written by
	     Scripts/release.sh. Upstream's feed used to be here, which would have replaced this app
	     with Mythic on the first update check. Kept equal to Branding.appcastURL by
	     Scripts/check-invariants.sh. SUPublicEDKey, the key every update is checked against,
	     is added by Scripts/set-update-key.sh. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/mcstig/PorTalistic/main/appcast.xml</string>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>SUPublicEDKey</key>
	<string>0+qijPcAxgEyw3KWHUPPr75EpLgGc2Cjy0G2mXPw6K4=</string>
</dict>
</plist>
