    if [[ "$PM_GAVE_UP" != 1 ]]; then
      PM_GAVE_UP=1
      echo "$(date '+%F %T') Steam was restarted three times in the last hour for games installed as their Linux version: not again for now"
    fi
    PM_FAST=0
    return 0
  fi
  PM_GAVE_UP=0
