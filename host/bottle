# ---- the LAN's file servers, for the Linux desktop (Oct 23) ----
# The VM is behind the Mac's NAT, so Bonjour (multicast) never reaches it and nas.local doesn't resolve
# there. The Mac asks Bonjour itself (dns-sd: SMB, NFS and SFTP servers), resolves each to an address,
# and the watcher sends the list to the VM every 5 minutes (bottle-session lan-hosts: /etc/hosts and
# Dolphin's Network place). BOTTLE_LAN_HOSTS=0 turns it off.
LAN_ROUND=0
LAN_SENT=""
lan_hosts_scan() {  # "IP NAME.local SERVICES" per server, SERVICES like smb,nfs
  local type svc t inst host ip line out="" seen=""
  command -v dns-sd >/dev/null || return 0
  for type in _smb._tcp:smb _nfs._tcp:nfs _sftp-ssh._tcp:sftp; do
    svc="${type#*:}"; t="${type%:*}"
    t="$(dns_sd_for 2 -B "$t" local. | awk '/ Add / {n = index($0, $7); print substr($0, n)}' | sort -u)"
    while IFS= read -r inst; do
      [[ -n "$inst" ]] || continue
      host="$(dns_sd_for 2 -L "$inst" "${type%:*}" local. | sed -n 's/.*can be reached at \([^ :]*\.local\)\.:[0-9]*.*/\1/p' | head -n 1)"
      [[ -n "$host" ]] || continue
      case " $seen " in *" $host "*)
        out="$(sed "s/^\([0-9.]*\) $host \(.*\)\$/\1 $host \2,$svc/" <<<"$out")"; continue ;;
      esac
      ip="$(dns_sd_for 2 -G v4 "$host." | awk -v h="$host." '$0 ~ " Add " && $0 ~ h && $6 !~ /^127\./ {print $6; exit}')"
      # this Mac itself (Remote Login, File Sharing): the VM reaches it at Lima's host address
      [[ -z "$ip" || "$ip" == 127.* ]] && { dns_sd_for 2 -G v4 "$host." | grep -q " Add .* $host\. *127\." && ip=192.168.5.2; }
      [[ "$ip" =~ ^[0-9.]+$ ]] || continue
      seen="$seen $host"
      out="$out${out:+$'\n'}$ip $host $svc"
    done <<<"$t"
  done
  # Windows PCs, routers and NAS without Bonjour (Finder finds them by Windows' own broadcasts, which
  # don't cross into the VM either): every address of the Mac's network asked for SMB (port 445, 1 s,
  # 60 at a time: a /24 takes about 5 s), then the server's own name (smbutil status). Networks bigger
  # than /22 aren't swept.
  local ifc mask base i t d name
  ifc="$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')"
  mask="$(ipconfig getoption "$ifc" subnet_mask 2>/dev/null)"
  base="$(ipconfig getifaddr "$ifc" 2>/dev/null)"
  if [[ "$mask" == 255.255.255.0 && "$base" =~ ^[0-9.]+\.[0-9]+$ ]] && command -v nc >/dev/null && command -v smbutil >/dev/null; then
    d="$(mktemp -d "${TMPDIR:-/tmp}/lanscan.XXXXXX")"
    base="${base%.*}"
    for i in $(seq 1 254); do
      ( nc -z -G 1 "$base.$i" 445 2>/dev/null && : > "$d/$i" ) </dev/null >/dev/null 2>&1 &
      (( i % 60 == 0 )) && wait
    done
    wait
    for t in "$d"/*; do
      [[ -f "$t" ]] || continue
      ip="$base.${t##*/}"
      grep -q "^$ip " <<<"$out" && continue   # (Bonjour had it, with a better name)
      name="$(smbutil status "$ip" 2>/dev/null | sed -n 's/^Server: //p' | head -n 1 | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9._-')"
      [[ -n "$name" ]] || name="smb-${ip##*.}"
      out="$out${out:+$'\n'}$ip $name smb"
    done
    rm -rf "$d"
  fi
  printf '%s' "$out"
}
dns_sd_for() {  # $1 = seconds; the rest: dns-sd's arguments (it never ends by itself)
  local secs="$1" p; shift
  dns-sd "$@" 2>/dev/null </dev/null &
  p=$!
  ( sleep "$secs"; kill "$p" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
  wait "$p" 2>/dev/null || true
}
lan_hosts_push() {  # the servers to the VM (when the list changed, or $1 = force)
  local list
  [[ "${BOTTLE_LAN_HOSTS:-1}" != 0 ]] || return 0
  list="$(lan_hosts_scan)"
  [[ "$list" != "$LAN_SENT" || "${1:-}" == force ]] || return 0
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 30 bash -c 'command -v bottle-session >/dev/null || exit 0; printf %s "$1" | base64 -d | bottle-session lan-hosts' _ "$(printf '%s' "$list" | base64)" >/dev/null 2>&1 || return 0
  LAN_SENT="$list"
  [[ -n "$list" ]] && echo "$(date '+%F %T') file servers on the LAN sent to the VM: $(awk '{printf "%s%s", (NR > 1 ? ", " : ""), $2}' <<<"$list")"
  return 0
}
