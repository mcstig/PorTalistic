# Where a Windows game crashed: the code bytes around each address in the crash backtraces of
# the newest game logs (~/steam-<appid>.log), read from the game files themselves, for disassembly.
import glob, os, re, struct, sys
home = os.path.expanduser("~")
steam = os.path.join(home, ".local/share/Steam")
EXC = re.compile(r"^[0-9.]+:([0-9a-f]{4}):([0-9a-f]{4}):warn:seh:dispatch_exception backtrace: --- Exception (0x[0-9a-f]+)\.", re.M)
LOADED = re.compile(r"^[0-9.]+:([0-9a-f]{4}):[0-9a-f]{4}:trace:loaddll:build_module Loaded L\"(.+?)\" at ([0-9A-F]+): native", re.M)
FRAME = re.compile(r"^[0-9.]+:([0-9a-f]{4}):([0-9a-f]{4}):warn:seh:virtual_unwind backtrace: ([0-9A-F]+): L\"(.+?)\" \+ ([0-9A-F]+)\.")
SERIOUS = ("0xc0000005", "0xc000001d", "0xc0000096", "0xc0000094", "0xc00000fd", "0xc0000409", "0xc0000374", "0x80000003")
def pe_sections(f):
    with open(f, "rb") as fh:
        h = fh.read(4096)
        off = struct.unpack_from("<I", h, 0x3C)[0]
        if h[off:off + 4] != b"PE\0\0":
            return None, []
        n, opt = struct.unpack_from("<H", h, off + 6)[0], struct.unpack_from("<H", h, off + 20)[0]
        stamp = struct.unpack_from("<I", h, off + 8)[0]
        st = off + 24 + opt
        secs = []
        for i in range(n):
            nm, vs, va, rs, rp = struct.unpack_from("<8sIIII", h, st + 40 * i)
            secs.append((nm.rstrip(b"\0").decode(errors="replace"), va, vs, rp, rs))
        return stamp, secs
def winpath(p, app):
    p = p.replace("\\\\", "\\")
    d, rest = p[:1].upper(), p[3:].replace("\\", "/")
    cands = []
    if d == "S":
        cands = [os.path.join(steam, rest), os.path.join("/s", rest)]
    elif d == "C":
        cands = [os.path.join(steam, "steamapps/compatdata", app, "pfx/drive_c", rest)]
    else:
        cands = [os.path.join(steam, "steamapps/compatdata", app, "pfx/dosdevices", d.lower() + ":", rest)]
    for c in cands:
        if os.path.isfile(c):
            return c
    return None
out = []
listed = set()
logs = sorted(glob.glob(os.path.join(home, "steam-*.log")), key=os.path.getmtime, reverse=True)[:4]
for lg in logs:
    app = os.path.basename(lg)[6:-4]
    text = open(lg, errors="replace").read()
    mods = {}
    for pid, wp, base in LOADED.findall(text):
        mods[(pid, wp.replace("\\\\", "\\").split("\\")[-1].lower())] = wp
    lines = text.splitlines()
    shown = 0
    for i, ln in enumerate(lines):
        m = EXC.match(ln)
        if not m or m.group(3) not in SERIOUS:
            continue
        pid, tid, code = m.groups()
        shown += 1
        if shown > 3:
            break
        out.append("== %s: exception %s in process %s thread %s (log line %d)" % (os.path.basename(lg), code, pid, tid, i + 1))
        for ln2 in lines[i + 1:i + 6]:
            if ":seh:dispatch_exception" in ln2 and ("code=" in ln2 or "info[" in ln2):
                out.append("   " + ln2.split(":seh:", 1)[1])
        frames = 0
        for ln2 in lines[i + 1:i + 60]:
            f = FRAME.match(ln2)
            if not f or f.group(1) != pid or f.group(2) != tid:
                continue
            frames += 1
            if frames > 6:
                break
            addr, mod, rva = f.group(3), f.group(4), int(f.group(5), 16)
            wp = mods.get((pid, mod.lower()))
            path = winpath(wp, app) if wp else None
            if not path:
                out.append("-- frame %s %s+%X: no native file (Wine builtin or not found)" % (addr, mod, rva))
                continue
            try:
                stamp, secs = pe_sections(path)
            except Exception as e:
                out.append("-- frame %s %s+%X: can not read %s (%s)" % (addr, mod, rva, path, e))
                continue
            hit = [s for s in secs if s[1] <= rva < s[1] + max(s[2], s[4])]
            if not hit and path not in listed:
                listed.add(path)
                out.append("   sections of %s: " % mod + "  ".join("%s va=%X vsize=%X raw=%X" % (x[0], x[1], x[2], x[4]) for x in secs))
            if not hit:
                out.append("-- frame %s %s+%X: not in a section" % (addr, mod, rva))
                continue
            nm, va, vs, rp, rs = hit[0]
            fo = rp + (rva - va)
            if not rs or fo >= rp + rs:
                out.append("-- frame %s %s+%X  section %s: not in the file (unpacked at run time)" % (addr, mod, rva, nm))
                continue
            a = max(rp, fo - 256)
            b = min(rp + rs, fo + 96)
            with open(path, "rb") as fh:
                fh.seek(a)
                data = fh.read(b - a)
            out.append("-- frame %s %s+%X  section %s  pe-stamp %08x  size %d  file %s" % (addr, mod, rva, nm, stamp, os.path.getsize(path), path))
            if path not in listed:
                listed.add(path)
                out.append("   sections: " + "  ".join("%s va=%X vsize=%X raw=%X" % (x[0], x[1], x[2], x[4]) for x in secs))
            out.append("   bytes from rva %X (crash/return at rva %X): %s" % (rva - (fo - a), rva, data.hex()))
        if frames == 0:
            out.append("-- (no backtrace frames for this thread)")
print("\n".join(out) if out else "(no crashes in the newest game logs)")
PYEOF
