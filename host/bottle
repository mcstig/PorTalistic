      pmst="$(grep -E "RecvMsgClientLogOnResponse\(\) : processing complete|not auto reconnecting due to Session Replaced" "$pmcl" 2>/dev/null | tail -n 1)"
      case "$pmst" in
        *"Session Replaced"*) printf 'steamoff\t%s\n' "$(printf '%s' "$pmst" | sed -n 's/^\[[0-9-]* \([0-9:]*\)\].*/\1/p' | cut -c1-5)" ;;
      esac
    fi
    # a connected game folder that Steam's library list doesn't have (Steam's first start after an
    # install came before the folder could be added; Settings > Storage dropped it): "libmissing TAB name"
    if [ -f "$HOME/.config/steamos-bottle/libraries.json" ] && [ -f "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" ]; then
