# ---- updating the app (Portalistic.app) from its GitHub releases ----
# Each release (host/release.sh) is a tag v<version> with Portalistic-<version>.zip, and GitHub's
# releases/latest leads to the newest. The app looks at launch and once a day and offers it
# (AppDelegate+Updates.swift); installing it:
#   1. downloads the zip into ~/Library/Caches/Portalistic/update and unpacks it;
#   2. checks the new copy: a valid signature from the same developer (team) for the same app,
#      accepted by Gatekeeper (notarized), and a newer version: else nothing changes;
#   3. moves this copy aside and the new one into its place. The running app carries on from the
#      old files until it opens the new copy, which closes it. The VM, Steam and a game keep
#      running; the VM takes the new kit at its next start (or Steam > Update the VM).
# Overrides (tests): BOTTLE_APP_RELEASES (the releases' address), BOTTLE_APP_LATEST (a version).
APP_RELEASES="${BOTTLE_APP_RELEASES:-https://github.com/mcstig/PorTalistic/releases}"
app_version_of() { /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null; }
app_sign_field() { codesign -dv "$1" 2>&1 | sed -n "s/^$2=//p" | head -1; }   # $2: TeamIdentifier, Identifier
# $1 newer than $2? (dotted numbers: 0.7.10 > 0.7.9)
version_newer() {
  local IFS=. i x y
  local -a a b
  read -r -a a <<<"$1"
  read -r -a b <<<"$2"
  for i in 0 1 2 3; do
    x="${a[i]:-0}"; y="${b[i]:-0}"
    x="${x%%[!0-9]*}"; y="${y%%[!0-9]*}"
    (( 10#${x:-0} > 10#${y:-0} )) && return 0
    (( 10#${x:-0} < 10#${y:-0} )) && return 1
  done
  return 1
}
# A copy whose version isn't a published release (withdrawn, or renumbered as 0.7.1 was on Oct 13,
# when 0.7.0.x became the numbering) is offered the newest release even if its number is lower;
# one that is a release, never a lower one.
app_release_exists() { curl -fsS -o /dev/null --connect-timeout 15 --max-time 30 "$APP_RELEASES/tag/v$1" 2>/dev/null; }
app_update_kind() {   # $1 newest release, $2 this copy: update, replace or current
  if version_newer "$1" "$2"; then echo update
  elif [[ "$1" != "$2" ]] && ! app_release_exists "$2"; then echo replace
  else echo current; fi
}
# the newest release's version: where releases/latest leads (…/releases/tag/v0.7.2)
app_latest() {
  local u
  if [[ -n "${BOTTLE_APP_LATEST:-}" ]]; then echo "$BOTTLE_APP_LATEST"; return 0; fi
  u="$(curl -fsS -o /dev/null -w '%{redirect_url}' --connect-timeout 15 --max-time 30 "$APP_RELEASES/latest")" || return 1
  [[ "$u" == */tag/v* ]] || return 1
  echo "${u##*/tag/v}"
}
cmd_app_update() {
  local what="${1:-check}" cur latest kind dir zip new old team
  [[ -n "$APP_BUNDLE" ]] || die "Only Portalistic.app updates itself; this is the kit (host/package-app.sh makes the app)."
  case "$what" in check|install) ;; *) die "usage: bottle app-update [check|install]" ;; esac
  cur="$(app_version_of "$APP_BUNDLE")"
  latest="$(app_latest)" || die "Couldn't reach GitHub to see Portalistic's newest version."
  kind="$(app_update_kind "$latest" "$cur")"
  if [[ "$what" == check ]]; then
    if [[ "$kind" == current ]]; then echo "current $cur $latest"; else echo "$kind $latest $APP_RELEASES/tag/v$latest"; fi
    return 0
  fi
  [[ "$kind" != current ]] || { info "Portalistic $cur is up to date (the newest release is $latest)."; return 0; }
  case "$APP_BUNDLE" in
    */AppTranslocation/*)
      die "Portalistic is running from where it was downloaded. Move it to the Applications folder, open it from there, then update." ;;
  esac
  [[ -w "$APP_BUNDLE" && -w "$(dirname "$APP_BUNDLE")" ]] \
    || die "Portalistic can't replace itself in $(dirname "$APP_BUNDLE") (no permission). Download it from $APP_RELEASES/latest instead."
  team="$(app_sign_field "$APP_BUNDLE" TeamIdentifier)"
  [[ -n "$team" && "$team" != "not set" ]] || die "This copy of Portalistic isn't signed by its developer, so it can't check an update. Download it from $APP_RELEASES/latest instead."
  dir="$HOME/Library/Caches/Portalistic/update"
  rm -rf "$dir"                         # (the copy an earlier update moved aside)
  mkdir -p "$dir"
  zip="$dir/Portalistic-$latest.zip"
  info "Downloading Portalistic ${latest}…"
  curl -fL --retry 3 --connect-timeout 20 -s -S -o "$zip" "$APP_RELEASES/download/v$latest/Portalistic-$latest.zip" \
    || die "The download stopped (network?). Try again."
  ditto -x -k "$zip" "$dir/new" 2>/dev/null || die "The download isn't a zip Portalistic can open. Try again."
  new="$dir/new/Portalistic.app"
  [[ -d "$new" ]] || die "The download has no Portalistic.app in it."
  info "Checking it…"
  codesign --verify --deep --strict "$new" 2>/dev/null || die "The new copy's signature doesn't check out. Nothing was changed."
  [[ "$(app_sign_field "$new" TeamIdentifier)" == "$team" ]] || die "The new copy isn't signed by Portalistic's developer. Nothing was changed."
  [[ "$(app_sign_field "$new" Identifier)" == "$(app_sign_field "$APP_BUNDLE" Identifier)" ]] || die "The download is a different app. Nothing was changed."
  spctl -a -t exec "$new" 2>/dev/null || die "macOS doesn't accept the new copy (it isn't notarized). Nothing was changed."
  [[ "$(app_version_of "$new")" == "$latest" ]] || die "The download is Portalistic $(app_version_of "$new"), not $latest. Nothing was changed."
  info "Replacing Portalistic $cur with ${latest}…"
  old="$dir/Portalistic-$cur.app"
  mv "$APP_BUNDLE" "$old" || die "Couldn't move this copy aside. Nothing was changed."
  if ! mv "$new" "$APP_BUNDLE"; then
    mv "$old" "$APP_BUNDLE"
    die "Couldn't put the new copy in place; this one is back as it was."
  fi
  rm -rf "$zip" "$dir/new"
  info "Portalistic is now $latest."
}

# ---- uninstalling Portalistic ----
# `bottle uninstall --list` says what an uninstall deletes, a line for each: KIND<TAB>KILOBYTES<TAB>PATH<TAB>WHAT.
#   system: the Linux system (the VM);  data: Portalistic's folders on this Mac;  games: a game folder
#   (not deleted here: the app moves it to the Trash when asked; its size is its game drive's, 0 for
#   a folder without one, since counting loose games would take minutes).
# `bottle uninstall --yes` stops the VM and deletes the system and the data. Only inside Portalistic.app:
# the kit is a development folder, and its VM is a developer's.
dir_kb() { du -sk "$1" 2>/dev/null | awk '{print $1 + 0}'; }
uninstall_what() {
  case "$1" in
    "$HOME/.portalistic")                 echo "Portalistic's working folder" ;;
    "$HOME/Library/Caches/Portalistic")   echo "Downloaded updates and caches" ;;
    "$HOME/Library/Logs/Portalistic")     echo "Logs" ;;
    *)                                    echo "Settings (the list of game folders, and so on)" ;;
  esac
}
uninstall_rows() {
  local sys="$LIMA_HOME/$VM_NAME" sysk=0 kb p name label path
  if [[ -d "$sys" && ! -L "$sys" ]]; then
    sysk="$(dir_kb "$sys")"
    printf 'system\t%s\t%s\tThe Linux system: Steam, your store sign-ins and any game installed on its own disk\n' "$sysk" "$sys"
  fi
  for p in "$HOME/.portalistic" "$STATE_DIR" "$HOME/Library/Caches/Portalistic" "$HOME/Library/Logs/Portalistic"; do
    [[ -d "$p" && ! -L "$p" ]] || continue
    kb="$(dir_kb "$p")"
    case "$sys" in "$p"/*) kb=$(( kb > sysk ? kb - sysk : 0 )) ;; esac   # (the system is counted above)
    printf 'data\t%s\t%s\t%s\n' "$kb" "$p" "$(uninstall_what "$p")"
  done
  while IFS=$'\t' read -r name label path; do
    [[ -n "$path" && -d "$path" && ! -L "$path" && -f "$path/.portalistic-library" ]] || continue
    case "$path" in "$HOME"|"$HOME/"|/|/Volumes|/Volumes/) continue ;; esac
    # the size is the game drive's (its file's used space; a folder's loose files would take minutes to count)
    kb=0; [[ -f "$path/$LIB_IMAGE" ]] && kb="$(dir_kb "$path/$LIB_IMAGE")"
    printf 'games\t%s\t%s\t%s\n' "$kb" "$path" "$label"
  done < <(lib_rows)
}
uninstall_remove() {  # $1: a folder inside the home folder
  local p="$1"
  case "$p" in "$HOME"/?*) ;; *) die "Not deleting $p: it isn't inside your home folder." ;; esac
  [[ -e "$p" || -L "$p" ]] || return 0
  if [[ -L "$p" ]]; then rm -f "$p"; else rm -rf "$p" 2>/dev/null || true; fi
  [[ ! -e "$p" && ! -L "$p" ]] || { warn "Couldn't delete $p."; return 1; }
}
cmd_uninstall() {
  local what="${1:-}" p bad=0 sys
  [[ -n "$APP_BUNDLE" ]] || die "Only Portalistic.app uninstalls itself; this is the kit, a development folder: delete it yourself."
  sys="$LIMA_HOME/$VM_NAME"
  [[ "$HOME" == /?* && -d "$HOME" ]] || die "Can't tell where your home folder is."
  case "$what" in
    --list) uninstall_rows; return 0 ;;
    --yes) ;;
    *) die "usage: bottle uninstall --list | --yes" ;;
  esac
  info "Stopping Portalistic's VM and deleting it…"
  audio_stop || true
  awake_stop || true
  if [[ -d "$sys" ]]; then
    limactl delete --force "$VM_NAME" >/dev/null 2>&1 || true   # (stops it first)
    if [[ -d "$sys" ]]; then
      # Lima couldn't (a damaged instance, or a leftover process holds it): end what runs from it
      pkill -TERM -f "$sys/" 2>/dev/null || true
      sleep 2
      pkill -KILL -f "$sys/" 2>/dev/null || true
      uninstall_remove "$sys" || bad=1
    fi
  fi
  for p in "$HOME/.portalistic" "$STATE_DIR" "$HOME/Library/Caches/Portalistic"; do
    [[ -e "$p" ]] && info "Deleting ~${p#"$HOME"}…"
    uninstall_remove "$p" || bad=1
  done
  (( bad == 0 )) || die "Something couldn't be deleted (see above); nothing else was touched."
  info "Deleting the logs…"
  uninstall_remove "$HOME/Library/Logs/Portalistic" || true   # last: this command's own log is in it
  info "Portalistic's Linux system and its data are deleted."
}

# ---- Steam links and the window manager ----
# Open a steam:// link in the running Steam: the Steam program hands it to the instance that
# runs (as desktop shortcuts do). Gets to places without Steam's menus, e.g. its settings.
cmd_steam_url() {
  local url="${1:-}"
  [[ "$url" == steam://* ]] || die "usage: bottle steam-url steam://...   (e.g. steam://open/settings, steam://uninstall/<app id>)"
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if ! steam_running; then
    [[ "${BOTTLE_FROM_APP:-}" == 1 ]] && die "Steam isn't running. Choose Steam > Restart Steam, then try again."
    die "Steam isn't running. Use: bottle steam"
  fi
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 40 bash -c '
    S="$HOME/.local/share/Steam"
    DISPLAY=:1 LD_LIBRARY_PATH="$S/lib/aarch64-linux-gnu" XDG_RUNTIME_DIR="/run/user/$(id -u)" \
      timeout 30 "$S/steamrtarm64/steam" "$1" >/dev/null 2>&1 &
    sleep 3' _ "$url" || warn "Steam didn't confirm; if nothing opened, try again in a few seconds."
  info "Sent to Steam: $url"
}

# FEX (Steam tool 3127680) runs every x86 game on Steam's ARM64 client. If Steam's record of it
# breaks (an earlier version of the kit set it to Proton), Steam won't use or reinstall it.
# This moves its record and files aside (kept as a backup) and has Steam install it afresh.
# Valve's Proton EasyAntiCheat Runtime (Steam tool 1826330): games with Easy Anti-Cheat that allow
# Proton (Rocket League, ...) need it, or the anti-cheat stops them at launch ("Launch Error").
# Steam installs it by itself on a PC; the ARM64 client here doesn't, so this asks for it, and
# steam-arm64 points Proton at it (PROTON_EAC_RUNTIME). Whether the anti-cheat accepts this
# machine is its own decision: nothing here hides the VM or the x86 translator from it.
eac_state() {  # installed / downloading / missing
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 30 bash -c '
    for A in /s/steamapps ~/.local/share/Steam/steamapps; do
      m="$A/appmanifest_1826330.acf"; [ -f "$m" ] || continue
      if grep -Eq "\"StateFlags\"[[:space:]]+\"4\"" "$m" \
         && [ -n "$(find "$A/common/Proton EasyAntiCheat Runtime" -name "easyanticheat*.so" 2>/dev/null | head -1)" ]; then
        echo installed
      else
        echo downloading
      fi
      exit 0
    done
    echo missing' 2>/dev/null | tail -n 1
}

cmd_anticheat() {
  local st i
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    die "A game is running. Quit it first (this restarts Steam)."
  fi
  # The VM's Steam launcher has to know about the runtime: that comes with bottle update.
  if ! vsh_for 30 grep -q PROTON_EAC_RUNTIME /usr/local/bin/steam-arm64 2>/dev/null; then
    info "Bringing the VM up to date first…"
    cmd_update
  fi
  st="$(eac_state)"
  if [[ "$st" != installed ]]; then
    steam_running || steam_start "$debug"
    info "Waiting for Steam…"
    for i in $(seq 1 24); do
      vsh_for 10 bash -c 'pgrep -f "[s]teamwebhelper" >/dev/null' && break
      sleep 5
    done
    sleep 15   # Steam signs in and loads the library
    info "Asking Steam to install Proton EasyAntiCheat Runtime (Valve's, about 100 MB)…"
    cmd_steam_url steam://install/1826330
    info "If Steam shows an install window for it, click Install."
    for i in $(seq 1 60); do   # up to 10 minutes
      sleep 10
      st="$(eac_state)"
      [[ "$st" == installed ]] && break
      (( i % 6 == 0 )) && info "Still waiting (${st})…"
    done
    if [[ "$st" != installed ]]; then
      log_export || true
      die "Steam didn't install it (${st}). Report it on github.com/mcstig/PorTalistic, with the logs saved above."
    fi
  fi
  info "Proton EasyAntiCheat Runtime is installed. Restarting Steam so games use it…"
  steam_stop
  steam_start "$debug"
  info "Done. Start Rocket League with anti-cheat."
}

# The app's Library: bottle-library (in the VM) lists the installed games and gathers the covers
# Steam has cached; they come over as one tar stream into the app's cache folder.
LIBRARY_CACHE="$HOME/Library/Caches/Portalistic/library"
cmd_library() {
  case "${1:-}" in
    add)     shift; lib_add "$@"; return ;;
    remove)  shift; lib_remove "$@"; return ;;
    default) shift; lib_default_set "$@"; return ;;
    folders) lib_folders; return ;;
  esac
  local tarf n have
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  have="$(vsh_for 30 bash -c 'command -v bottle-library >/dev/null && echo yes || echo no' || true)"
  case "$have" in
    *yes*) ;;
    *no*) die "The VM doesn't have the library helper yet: Steam > Update the VM (or: bottle update)" ;;
    *) die "The VM didn't answer; try again in a few seconds." ;;
  esac
  if [[ "${1:-}" != --copy ]]; then
    vsh_for 60 bottle-library
    return
  fi
  mkdir -p "${LIBRARY_CACHE%/*}"
  tarf="$(mktemp "${TMPDIR:-/tmp}/bottle-library.XXXXXX")"
  # shellcheck disable=SC2016  # runs in the VM
  if ! vsh_for 120 bash -c 'D="$(mktemp -d)"; bottle-library --export "$D" >&2 && tar -C "$D" -cf - .; rc=$?; rm -rf "$D"; exit $rc' > "$tarf"; then
    rm -f "$tarf"
    die "Couldn't read the library from the VM (see above)."
  fi
  rm -rf "$LIBRARY_CACHE.new"
  mkdir -p "$LIBRARY_CACHE.new"
  if ! tar -xf "$tarf" -C "$LIBRARY_CACHE.new" || [[ ! -f "$LIBRARY_CACHE.new/library.json" ]]; then
    rm -rf "$tarf" "$LIBRARY_CACHE.new"
    die "The library from the VM came over incomplete."
  fi
  rm -f "$tarf"
  rm -rf "$LIBRARY_CACHE.old"
  [[ -d "$LIBRARY_CACHE" ]] && mv "$LIBRARY_CACHE" "$LIBRARY_CACHE.old"
  mv "$LIBRARY_CACHE.new" "$LIBRARY_CACHE"
  rm -rf "$LIBRARY_CACHE.old"
  n="$(grep -c '"appid"' "$LIBRARY_CACHE/library.json" || true)"
  info "Library: $n games (in $LIBRARY_CACHE)"
}

# Steam's interface: Big Picture (default) or its desktop windows, kept in the VM's
# ~/.config/steamos-bottle/steam-ui; steam-arm64 starts Steam that way and the keeper
# (bottle-maximize-steam --keep) holds it there.
cmd_ui() {
  local want="${1:-}"
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if [[ -z "$want" ]]; then
    # shellcheck disable=SC2016  # runs in the VM
    vsh bash -c '[ "$(cat ~/.config/steamos-bottle/steam-ui 2>/dev/null)" = desktop ] && echo desktop || echo bigpicture'
    return
  fi
  case "$want" in
    bigpicture|big-picture) want=bigpicture ;;
    desktop) ;;
    *) die "usage: bottle ui [bigpicture|desktop]" ;;
  esac
  # shellcheck disable=SC2016  # runs in the VM
  vsh bash -c 'mkdir -p ~/.config/steamos-bottle && echo "$1" > ~/.config/steamos-bottle/steam-ui' _ "$want"
  if steam_running; then
    if [[ "$want" == bigpicture ]]; then
      cmd_steam_url steam://open/bigpicture
    else
      cmd_steam_url steam://close/bigpicture
      info "If Steam stays in Big Picture, restart it: bottle steam"
    fi
  fi
  info "Steam's interface: $want (also from Steam's next start)."
}

# Does OpenGL on the Mac's GPU (zink) work in the VM? $1 = seconds the check may take (300).
# 0 when it does (the stand-ins that worked are saved for steam-arm64), else 1; the reasons go to
# steam-gpu-check.txt in the VM (and Save Logs). Used by `bottle steam-gpu on` and gpu_auto_prepare.
steam_gpu_check() {
  local rc=0
    # the VM's Steam launcher and the bottle's OpenGL shim must be this kit's: update them first
    # shellcheck disable=SC2016  # runs in the VM
    if ! vsh bash -c 'grep -q BOTTLE_STEAM_GPU_FAKE /usr/local/bin/steam-arm64 2>/dev/null && grep -qa "interface on the GPU here" /usr/local/lib64/libbottle_kopper.so 2>/dev/null && grep -qa BOTTLE_FAKE_ZINK /usr/local/lib64/libVkLayer_bottle_present.so 2>/dev/null && grep -qa "with shaders and a texture" /usr/local/bin/bottle-gltest 2>/dev/null'; then
      info "The VM needs this kit's newer Steam launcher first: updating the VM…"
      cmd_update
    fi
    info "Checking OpenGL on the Mac's GPU (zink) in the VM…"
    # As Steam's interface will be started: zink, LIBGL_KOPPER_DRI2 and the layer's stand-ins for
    # the features zink needs for OpenGL 3+ (BOTTLE_FAKE_ZINK; steam-arm64 sets all three),
    # the bottle's shim (guest/present-layer/bottle_kopper.c) preloaded into the program that
    # starts it and linked on the library path, as steam-arm64 does for Steam, and that program
    # setting LIBGL_KOPPER_DISABLE=true first, as Steam does for its web views.
    # It tries the layer's stand-ins from the fewest up and keeps the first set that gives an
    # OpenGL core profile and bottle-gltest's 3.3 core window drawn with shaders, saving it to
    # ~/.config/steamos-bottle/steam-gpu-fake for steam-arm64. Everything it sees goes to
    # steam-gpu-check.txt there (and into Save Logs).
    # shellcheck disable=SC2016  # runs in the VM
    vsh_for "${1:-300}" bash -c '
      export DISPLAY=:1
      command -v glxinfo >/dev/null || sudo -n dnf install -y -q glx-utils >/dev/null 2>&1
      command -v xwd >/dev/null || sudo -n dnf install -y -q xwd >/dev/null 2>&1
      command -v glxinfo >/dev/null || { echo "  glxinfo is missing: choose Steam > Update the VM first"; exit 2; }
      C=~/.config/steamos-bottle; mkdir -p "$C"; D="$C/steam-gpu-check.txt"
      echo "== $(date) bottle steam-gpu on: check" > "$D"
      now="$(glxinfo -B 2>/dev/null | sed -n "s/^OpenGL renderer string: //p")"
      echo "  now:  ${now:-no OpenGL?}"
      { echo "== the Mac GPU as Vulkan reports it (vulkaninfo)"
        command -v vulkaninfo >/dev/null || echo "(no vulkaninfo)"
        vulkaninfo 2>/dev/null | grep -E "deviceName|VK_EXT_(provoking_vertex|transform_feedback|shader_object|custom_border_color|line_rasterization|extended_dynamic_state3)[ :]|^[[:space:]]+(geometryShader|tessellationShader|depthClamp|dualSrcBlend|fillModeNonSolid|shaderClipDistance|shaderCullDistance|shaderInt64|shaderInt16|sampleRateShading|independentBlend|imageCubeArray|logicOp|multiViewport|vertexPipelineStoresAndAtomics|fragmentStoresAndAtomics|textureCompressionBC|provokingVertexLast|transformFeedback)[[:space:]]*="
      } >> "$D" 2>&1
      shim="$(mktemp -d)"; trap "rm -rf $shim" EXIT
      ln -s /usr/local/lib64/libbottle_kopper.so "$shim/libGLX_mesa.so.0"
      ln -s /usr/local/lib64/libbottle_kopper.so "$shim/libEGL_mesa.so.0"
      zink() { env LIBGL_KOPPER_DRI2=1 MESA_LOADER_DRIVER_OVERRIDE=zink BOTTLE_FAKE_ZINK="$fz" BOTTLE_PRESENT_DEBUG=1 \
                   LD_LIBRARY_PATH="$shim" LD_PRELOAD=/usr/local/lib64/libbottle_kopper.so \
                   bash -c "export LIBGL_KOPPER_DISABLE=true; exec \"\$@\"" _ "$@"; }
      fz=0
      out="$(zink timeout 30 glxinfo -B 2>&1)"
      r="$(printf "%s\n" "$out" | sed -n "s/^OpenGL renderer string: //p")"
      echo "  zink: ${r:-did not start}"
      { echo "== zink without stand-ins"; printf "%s\n" "$out"; } >> "$D"
      case "$r" in
        *zink*Venus*|*zink*Apple*) ;;   # zink on the Mac GPU (not on llvmpipe)
        *) printf "%s\n" "$out" | grep -iE "error|fail|zink|vulkan|kopper" | head -6 | sed "s/^/    /"; exit 1 ;;
      esac
      for fz in geometryShader geometryShader,depthClamp,dualSrcBlend,independentBlend,fillModeNonSolid 1; do
        echo "  the layer'"'"'s stand-ins for zink: $fz"
        echo "== stand-ins: $fz" >> "$D"
        out="$(zink timeout 30 glxinfo -B 2>&1)"
        printf "%s\n" "$out" >> "$D"
        v="$(printf "%s\n" "$out" | sed -n "s/^OpenGL core profile version string: //p")"
        echo "    OpenGL core profile: ${v:-none}"
        [ -n "$v" ] || continue
        ok=1
        # Not glxgears here: it draws GL_QUADS, which zink (believing in geometry shaders now)
        # turns into a geometry shader the Mac GPU cannot run (it crashed, Oct 9 11:37). Steam
        # draws triangles; bottle-gltest draws a textured triangle with shaders, as it does.
        if [ ! -x /usr/local/bin/bottle-gltest ]; then
          echo "    bottle-gltest isn'"'"'t in the VM (it couldn'"'"'t be built): nothing to check with"
          echo "(no bottle-gltest)" >> "$D"; ok=0
        fi
        if [ "$ok" = 1 ] && [ -x /usr/local/bin/bottle-gltest ]; then
          for t in glx egl; do
            res="$(zink timeout 20 /usr/local/bin/bottle-gltest "$t" argb core 2>&1)"
            printf "%s\n" "$res" | head -40 | sed "s/^/  gltest $t: /" >> "$D"
            rr="$(printf "%s\n" "$res" | sed -n "s/^renderer: //p")"
            rs="$(printf "%s\n" "$res" | sed -n "s/^RESULT: //p")"
            echo "    transparent window, OpenGL 3.3 core, $t: ${rs:-no result}"
            case "$t:$rs:$rr" in
              *:shows*:*zink*Venus*|*:shows*:*zink*Apple*) ;;
              glx:*) ok=0 ;;
              egl:*) echo "      (not through EGL: Big Picture may stay black if Steam draws through EGL)" ;;
            esac
          done
        fi
        if [ "$ok" = 1 ]; then
          echo "$fz" > "$C/steam-gpu-fake"
          echo "== chosen: $fz" >> "$D"
          echo "  using these stand-ins: $fz"
          exit 0
        fi
      done
      echo "== none worked" >> "$D"
      exit 1' || rc=$?
    if (( rc != 0 )); then log_export >/dev/null 2>&1 || true; fi
    return "$rc"
}

# Steam's interface draws with OpenGL (Chromium). The VM has OpenGL only in software (llvmpipe,
# on the VM's processors), which makes Big Picture's animations stutter. Mesa's zink runs OpenGL
# on Vulkan, which here is Venus on the Mac's GPU (presented by the bottle layer, like games).
# "on" first checks that zink works in this VM (glxinfo; glxgears shows a window for a few
# seconds), then starts Steam with it (~/.config/steamos-bottle/steam-gpu; steam-arm64 reads it).
cmd_steam_gpu() {
  local want="${1:-}" rc=0 since
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if [[ -z "$want" || "$want" == status ]]; then
    # shellcheck disable=SC2016  # runs in the VM
    if [[ "$(vsh bash -c 'cat ~/.config/steamos-bottle/steam-gpu 2>/dev/null')" == zink ]]; then
      [[ "$want" == status ]] && { echo gpu; return 0; }   # (the app: which choice to grey out)
      info "Steam's interface: on the Mac's GPU (bottle steam-gpu off goes back)."
    else
      [[ "$want" == status ]] && { echo cpu; return 0; }
      info "Steam's interface: on the VM's processors (bottle steam-gpu on tries the Mac's GPU)."
    fi
    return 0
  fi
  if [[ "$want" == on ]]; then
    steam_gpu_check || die "OpenGL on the Mac's GPU doesn't work in this VM yet (above); Steam stays as it is. The details are saved with the logs (Steam > Save Logs)."
    vsh bash -c 'mkdir -p ~/.config/steamos-bottle && echo zink > ~/.config/steamos-bottle/steam-gpu'
    # from here on Ctrl-C puts it back (Steam isn't left on a mode that wasn't checked)
    trap 'steam_gpu_back "Stopped before the check finished."' INT
    info "Restarting Steam with its interface on the Mac's GPU…"
  elif [[ "$want" == off ]]; then
    vsh bash -c 'rm -f ~/.config/steamos-bottle/steam-gpu'
    gpu_auto_set off   # chosen by hand: not tried again by itself
    info "Restarting Steam with its interface on the VM's processors…"
  else
    die "usage: bottle steam-gpu [on|off|status]"
  fi
  desktop_start >/dev/null
  steam_stop
  since="$(vsh date '+%Y-%m-%d %H:%M:%S')"
  steam_start "$debug"
  [[ "$want" == on ]] || { info "Done."; return 0; }
  # Big Picture must really show: else straight back, keeping the attempt's log.
  info "Checking that Big Picture shows on the Mac's GPU. Leave this running: the screen can stay"
  info "black or blinking for up to five minutes (the first tries usually fail), and if it doesn't"
  info "work Steam goes back as it was by itself."
  rc=0
  steam_screen_shows "$since" || rc=$?
  trap - INT
  case "$rc" in
    0) ;;
    3) steam_gpu_back "Steam's interface couldn't start OpenGL on the Mac's GPU." ;;
    *) steam_gpu_back "Big Picture didn't show on the Mac's GPU." ;;
  esac
  gpu_auto_set on   # chosen by hand and it works
  local renderer
  renderer="$(steam_ui_renderer "$since")"
  case "$renderer" in
    *zink*|*Venus*|*Apple*)
      info "Done: Big Picture draws on the Mac's GPU ($renderer)." ;;
    "")
      info "Done: Big Picture shows with its interface on the Mac's GPU." ;;
    *)
      warn "Big Picture shows, but Steam's web views report $renderer, which is the VM's processors."
      info "It may not be smoother. Steam's log is kept in the VM: Steam > Save Logs." ;;
  esac
  info "Back to the VM's processors any time: bottle steam-gpu off"
}

# Steam back on the VM's processors after a GPU attempt that didn't work ($1 says why), keeping
# that attempt's log for Save Logs.
steam_gpu_back() {
  trap - INT
  # a check still running (Ctrl-C during it): end it, its ssh (which ends the check in the VM)
  # and its timer (which would otherwise fire later at process numbers that may be reused)
  if [[ -n "${VSH_FOR_PID:-}" ]]; then
    pkill -P "$VSH_FOR_PID" 2>/dev/null || true
    kill "$VSH_FOR_PID" 2>/dev/null || true
    if [[ -n "${VSH_FOR_TIMER:-}" ]]; then
      pkill -P "$VSH_FOR_TIMER" 2>/dev/null || true
      kill "$VSH_FOR_TIMER" 2>/dev/null || true
    fi
    VSH_FOR_PID='' VSH_FOR_TIMER=''
  fi
  warn "$1 Going back to the VM's processors…"
  vsh bash -c 'cp ~/.config/steamos-bottle/steam.log ~/.config/steamos-bottle/steam-gpu-failed.log 2>/dev/null; rm -f ~/.config/steamos-bottle/steam-gpu'
  gpu_auto_set failed
  steam_stop
  steam_start "$debug"
  log_export >/dev/null 2>&1 || true
  die "Steam is back as it was. The GPU attempt's logs are saved with the logs (Steam > Save Logs)."
}

# Steam's Big Picture window is up and not all black (a look at the VM's screen with xwd): waits
# up to 150 s for the window, then up to 30 s for something on it. Ends early with status 3 when
# Steam's web helper can't get OpenGL: its log says so 12 times after $1, Steam's start time. It
# retries every 10 s and the first tries normally fail: on the M4 Mac's VM it took 2 to 4 failed
# tries before it worked, once 9, and on Oct 21 a new M1 laptop's check gave up after 2 (about 20 s)
# and put Steam back on the CPU just before the third try. No xwd: can't tell (yes).
steam_screen_shows() {
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 340 bash -c '
    export DISPLAY=:1
    since="$1"; W=~/.local/share/Steam/logs/webhelper.txt
    gl_failed() {
      [ -f "$W" ] || return 1
      [ "$(awk -v s="$since" "substr(\$0, 2, 19) >= s && /failed to initialize GL thread/" "$W" | wc -l)" -ge 12 ]
    }
    # What Steam and its web helper run with (settings, OpenGL libraries, the shim log), into
    # steam-gpu-diag.txt for Save Logs; the main points here.
    snapshot() {
      D=~/.config/steamos-bottle/steam-gpu-diag.txt
      { echo "== $(date) $1"
        for p in $(pgrep -x steam) $(pgrep -x steamwebhelper); do
          t="$(tr "\0" " " < /proc/$p/cmdline 2>/dev/null | grep -o -- "--type=[a-z-]*" | head -1)"
          echo "-- $(cat /proc/$p/comm 2>/dev/null) $p ${t:-(main)}"
          tr "\0" "\n" < /proc/$p/environ 2>/dev/null \
            | grep -E "^(LD_LIBRARY_PATH|LD_PRELOAD|MESA_|LIBGL_|__GLX|__EGL|SDL_|GALLIUM|BOTTLE_)" | sed "s/^/   env /"
          grep -oE "/[^ ]*(libGL|libEGL|libOpenGL|libgallium|bottle_kopper|SDL)[^ ]*" /proc/$p/maps 2>/dev/null \
            | sort -u | sed "s/^/   lib /"
        done
        echo "-- kopper.log"; tail -30 ~/.cache/steamos-bottle/kopper.log 2>/dev/null
      } > "$D" 2>&1
      m="$(pgrep -x steamwebhelper | while read -r p; do
             tr "\0" " " < /proc/$p/cmdline 2>/dev/null | grep -q -- "--type=" || { echo "$p"; break; }; done)"
      if [ -n "$m" ]; then
        k="$(tr "\0" "\n" < /proc/$m/environ 2>/dev/null | sed -n "s/^LIBGL_KOPPER_DISABLE=//p")"
        z="$(tr "\0" "\n" < /proc/$m/environ 2>/dev/null | sed -n "s/^MESA_LOADER_DRIVER_OVERRIDE=//p")"
        echo "  Steam web helper runs with LIBGL_KOPPER_DISABLE=${k:-unset}, MESA_LOADER_DRIVER_OVERRIDE=${z:-unset}"
        grep -q bottle_kopper /proc/$m/maps 2>/dev/null && echo "  the shim is loaded in it" || echo "  the shim is not loaded in it"
      else
        echo "  (the Steam web helper was not running at that moment)"
      fi
      n="$(grep -c "starts steamwebhelper" ~/.cache/steamos-bottle/kopper.log 2>/dev/null)"
      echo "  the shim saw Steam start its web helper ${n:-0} times (kopper.log)"
    }
    command -v xwd >/dev/null || exit 0
    for _ in $(seq 1 300); do   # (up to five minutes for Big Picture'"'"'s window; Oct 23, was 150 s)
      gl_failed && { snapshot "web helper: no OpenGL"; exit 3; }
      wmctrl -l 2>/dev/null | grep -q "Steam Big Picture Mode$" && break
      sleep 1
    done
    for _ in $(seq 1 15); do
      sleep 2
      gl_failed && { snapshot "web helper: no OpenGL"; exit 3; }
      xwd -root -silent 2>/dev/null | python3 -c "
import sys
d = sys.stdin.buffer.read()
if len(d) < 100: sys.exit(1)
hdr = int.from_bytes(d[0:4], \"big\"); w = int.from_bytes(d[16:20], \"big\"); h = int.from_bytes(d[20:24], \"big\")
bpp = max(3, int.from_bytes(d[44:48], \"big\") // 8)
bpl = int.from_bytes(d[48:52], \"big\"); nc = int.from_bytes(d[76:80], \"big\"); px = d[hdr + nc * 12:]
lit = tot = 0
for y in range(0, h, 24):
    for x in range(0, w, 24):
        o = y * bpl + x * bpp
        if o + 3 > len(px): continue
        tot += 1; lit += (px[o] + px[o + 1] + px[o + 2]) > 24
sys.exit(0 if tot and lit * 50 > tot else 1)   # over 2% of the screen not black
" && exit 0
    done
    snapshot "Big Picture black"
    exit 1' _ "$1"
}

# What Steam's web views draw with since $1 (Steam's start time), from Steam's GPU report: e.g.
# "ANGLE (Mesa, zink Vulkan 1.3(Virtio-GPU Venus (Apple M4 Max) …)". Empty if not there yet.
