    for f in "$HOME/.lima/$VM_NAME"/*.log; do
      [[ -f "$f" ]] || continue
      # krunkit repeats a harmless vsock message every minute; leave it out
      echo; echo "== ${f##*/} (last 200 lines that matter)"
      grep -v "unexpected dgram pkt" "$f" 2>/dev/null | tail -n 200 || true
    done
    # GPU faults, hangs and restarts on the Mac side (the last 3 hours)
    echo; echo "== macOS GPU messages (last 3 hours)"
    log show --last 3h --style compact --predicate \
      '(process == "kernel" AND (eventMessage CONTAINS[c] "AGX" OR eventMessage CONTAINS[c] "GPU")) OR (process == "krunkit" AND (messageType == error OR messageType == fault))' \
      2>/dev/null | tail -n 150 || true
    echo; echo "== sound player log"; tail -n 30 "$STATE_DIR/audio.log" 2>/dev/null || true
    echo; echo "== macOS crash reports (newest first)"
    # shellcheck disable=SC2012  # plain file names
    ls -t "$HOME/Library/Logs/DiagnosticReports"/{krunkit,Portalistic,SteamOSBottle,bottle-audio,limactl}* 2>/dev/null | head -10 | sed 's#.*/##' || true
    # shellcheck disable=SC2012
    f="$(ls -t "$HOME/Library/Logs/DiagnosticReports"/krunkit* 2>/dev/null | head -1 || true)"
    if [[ -n "$f" ]]; then echo; echo "== ${f##*/} (start)"; head -n 120 "$f" || true; fi
  } > "$mac" 2>&1 || true
  info "Saved $(du -h "$out" | cut -f1 | tr -d ' ') of logs to $out (and ${mac##*/})"
}

cmd_log() {
  need_vm
  case "${1:-game}" in
    steam) vsh bash -c 'tail -n 60 ~/.config/steamos-bottle/steam.log 2>/dev/null || echo "No Steam log yet (bottle start)."' ;;
    export) log_export ;;
    game|prev|list)
      # shellcheck disable=SC2016  # runs in the VM
      vsh bash -c 'if command -v bottle-log >/dev/null; then bottle-log "$@"; else echo "The VM needs: bottle update"; fi' \
        _ "${1:-game}" ${2+"$2"} ;;
    *) die "usage: bottle log [game | prev [N] | list | steam | export]" ;;
  esac
}

cmd_perf() {
  local pid i u sum=0 max=0 n=0
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running."
  pid="$(pgrep -n krunkit || true)"
  if [[ -n "$pid" ]]; then
    echo "== Mac: the VM (krunkit) uses $(ps -o %cpu= -p "$pid" | tr -d ' ')% CPU (100% = one core)"
    # Per thread (first decimal number on each ps -M row is %CPU). One thread near 100%
    # while the game runs = the GPU command translation (one thread) is the limit.
    echo "== Mac: its busiest threads, % each: $(ps -M -p "$pid" 2>/dev/null | awk 'NR > 1 {
           for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+$/) { print $i; break } }' \
         | sort -rn | head -6 | tr '\n' ' ')"
  fi
  # Apple GPU busy %, from the driver's own statistics (no sudo needed). 5 samples over ~2 s.
  for i in 1 2 3 4 5; do
    u="$(ioreg -r -d 1 -w 0 -c IOAccelerator 2>/dev/null | grep -oE '"Device Utilization %"=[0-9]+' | head -1 | cut -d= -f2)"
    if [[ -n "$u" ]]; then sum=$((sum + u)); n=$((n + 1)); (( u > max )) && max=$u; fi
    [[ $i -lt 5 ]] && sleep 0.5
  done
  (( n > 0 )) && echo "== Mac: GPU busy ${max}% peak, $((sum / n))% average"
  # macOS compiles Metal shaders in MTLCompilerService processes: busy = shader compile stutter.
  echo "== Mac: Metal shader compiler $(ps -A -o %cpu=,comm= | awk '/MTLCompilerService/ {s += $1} END {printf "%.0f", s}')% CPU"
  # A game that starts well and gets slower after a minute or two: the Mac running hot (its
  # chips slow down) or short of memory (the VM's memory, the game's GPU memory, other apps).
  # Thermal pressure: 0 nominal, 1 moderate, 2 heavy, 3 trapping, 4 sleeping (OSThermalNotification).
  # Memory pressure: 1 normal, 2 warning, 4 critical.
  echo "== Mac: thermal pressure $(notifyutil -g com.apple.system.thermalpressurelevel 2>/dev/null | awk '{print $2}'), memory pressure $(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null), free memory $(memory_pressure -Q 2>/dev/null | grep -oE '[0-9]+%' | tail -1), swap $(sysctl -n vm.swapusage 2>/dev/null | sed -E 's/.*used = ([^ ]+).*/\1 used/'), $(vm_stat 2>/dev/null | awk '/Swapouts/ {gsub(/\./, "", $2); print $2 " pages swapped out since boot"}')"
  [[ -n "$pid" ]] && echo "== Mac: the VM's memory on the Mac: $(( $(ps -o rss= -p "$pid" 2>/dev/null || echo 0) / 1024 )) MB"
  echo "== Mac: power $(pmset -g batt 2>/dev/null | head -1 | sed -E "s/.*'(.*)'.*/\1/"), energy mode $(power_now)"
  echo "== Mac: busiest processes (% of one core, MB)"
  ps -A -o %cpu=,rss=,comm= -r 2>/dev/null | head -6 | awk '{ m = $2 / 1024; $2 = ""; c = $1; $1 = ""; n = split($0, p, "/"); printf "  %5s%%  %6.0f MB  %s\n", c, m, p[n] }'
  vsh_for 60 bash -c '
    echo "== VM: load $(cut -d" " -f1-3 /proc/loadavg) on $(nproc) CPUs; memory MB (total used free shared cache available): $(free -m | awk "NR == 2 {print \$2, \$3, \$4, \$5, \$6, \$7}")"
    echo "== VM: pressure, share of the last 10 s that work waited for: CPU $(awk "NR == 1 {print \$2}" /proc/pressure/cpu 2>/dev/null), memory $(awk "NR == 1 {print \$2}" /proc/pressure/memory 2>/dev/null), disk $(awk "NR == 1 {print \$2}" /proc/pressure/io 2>/dev/null)"
    # everything else busy next to the game (Steam'"'"'s interface drawing behind it, the screen server...)
    echo "== VM: busiest processes (2 s; 100% = one core)"
    top -b -c -w 300 -n 2 -d 1 -o %CPU 2>/dev/null | awk "/^top -/{n++} n==2" | sed -n "8,14p" \
      | awk "{c = \$12; n = split(c, p, \"/\"); printf \"  %5s%%  %s %s\n\", \$9, p[n], substr(\$13, 1, 40)}"
    # The game: the biggest process running a .exe (helpers and this script excluded;
    # patterns are written ".ex[e]" so they never match their own command line).
    P=$(ps -eo pid,rss,args --sort=-rss | awk "NR > 1 && tolower(\$0) ~ /\\.ex[e]/ && \$0 !~ /bash -c/ && tolower(\$0) !~ /(steam|explorer|services|winedevice|plugplay|rpcss|svchost|xalia|conhost|tabtip|wineboot)\\.ex[e]/ {print \$1; exit}")
    if [ -z "$P" ]; then echo "No game running."; exit 0; fi
    echo "== game: $(ps -o args= -p "$P" | grep -oE "[^\\\\/ ]+\.exe" | tail -1) (pid $P), busiest threads (100% = one core)"
    top -b -H -n 2 -d 1 -p "$P" | awk "/^top -/{n++} n==2" | sed -n "7,17p" | cut -c1-100
    L=$(ls -t ~/steam-*.log 2>/dev/null | head -1)
    echo "== swapchains (newest last; fmt 44/50 = BGRA, 37/43 = RGBA)"
    [ -n "$L" ] && grep -E "bottle-present[^]]*\] swapchain " "$L" | tail -3 | sed -E "s/.*swapchain /  /; s/ window=[^ ]+//"
    echo "== pacing, every 10 s of play (newest last): hitches and shader compiling"
    [ -n "$L" ] && grep -E "bottle-present[^]]*\] pacing: " "$L" | tail -3 | sed -E "s/^.*bottle-present ([0-9:]+)\] pacing: /  \1 /"
    echo "== frames (newest last; needs bottle steam --debug)"
    [ -n "$L" ] && grep -E "bottle-present[^]]*\] [0-9.]+ fps" "$L" | tail -2 | sed -E "s/^.*bottle-present[^]]*\] //; s/ \| /\n    /g"
    # Steam'"'"'s in-game overlay: its UI processes (Steam starts one per game), its two parts in
    # the game process, and the shared memory they talk through
    echo "== Steam overlay: UI processes; in the game; shared memory"
    ps -eo pid,etime,args | grep "[g]ameoverlayui" | cut -c1-300 | head -6
    grep -E "gameoverlayrenderer|steamoverlayvulkanlayer" /proc/$P/maps 2>/dev/null | awk "{print \$6}" | sort -u | sed "s/^/  in game: /"
    ls -la --time-style=+%T /dev/shm 2>/dev/null | tail -n +2 | head -30 | sed "s/^/  shm: /"
    true'
}

# ---- the Portalistic app (its code: host/Portalistic/, one file per part) ----
APP_SRC="$KIT_DIR/host/Portalistic"
XCODE_PROJECT="$KIT_DIR/host/Portalistic.xcodeproj"
TEAM_CONFIG="$KIT_DIR/host/xcode/Team.xcconfig"

# Xcode's developer folder (xcode-select may point at the Command Line Tools instead).
xcode_dev_dir() {
  local d a
  d="${DEVELOPER_DIR:-$(xcode-select -p 2>/dev/null || true)}"
  if [[ "$d" != *.app/Contents/Developer ]]; then
    d=""
    for a in /Applications/Xcode.app /Applications/Xcode-beta.app; do
      [[ -d "$a" ]] && { d="$a/Contents/Developer"; break; }
    done
    if [[ -z "$d" ]]; then
      a="$(mdfind "kMDItemCFBundleIdentifier == 'com.apple.dt.Xcode'" 2>/dev/null | head -1)"
      [[ -n "$a" ]] && d="$a/Contents/Developer"
    fi
  fi
  [[ -n "$d" && -x "$d/usr/bin/xcodebuild" ]] || return 1
  printf '%s\n' "$d"
}

# The signing team: the one chosen in Xcode (it ranks first in the build too), else
# Team.xcconfig. A team chosen in Xcode is copied into Team.xcconfig, so a newer project file from
# a kit update doesn't lose it.
xcode_team() {
  local t c
  c="$(sed -n 's/^[[:space:]]*DEVELOPMENT_TEAM[[:space:]]*=[[:space:]]*\([A-Z0-9]\{10\}\).*/\1/p' "$TEAM_CONFIG" 2>/dev/null | head -1 || true)"
  t="$(sed -n 's/.*DEVELOPMENT_TEAM = \([A-Z0-9]\{10\}\);.*/\1/p' "$XCODE_PROJECT/project.pbxproj" 2>/dev/null | head -1 || true)"
  if [[ -n "$t" && "$t" != "$c" ]]; then
    printf '// Your signing team (chosen in Xcode; not part of the kit)\nDEVELOPMENT_TEAM = %s\n' "$t" > "$TEAM_CONFIG"
  fi
  printf '%s\n' "${t:-$c}"
}

# Teams that can sign here: valid Apple Development identities (certificate and private key in
# the keychain), "TEAMID<tab>Name" per line (the team is the certificate's OU).
cert_teams() {
  local tmp f subj team org valid
  valid="$(security find-identity -v -p codesigning 2>/dev/null \
           | sed -nE 's/^ *[0-9]+\) ([0-9A-F]{40}) "Apple Development: .*/\1/p' | tr '\n' ' ' || true)"
  [[ -n "${valid// /}" ]] || return 0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/bottle-certs.XXXXXX")"
  security find-certificate -a -Z -p -c "Apple Development" 2>/dev/null \
    | awk -v d="$tmp" -v ok="$valid" '
        BEGIN { n = split(ok, a, " "); for (i = 1; i <= n; i++) good[a[i]] = 1 }
        /^SHA-1 hash:/ { h = $3 }
        /BEGIN CERT/ { k++; f = d "/" k ".pem"; p = (h in good) }
        p { print > f }
        /END CERT/ { if (p) close(f); p = 0 }' || true
  for f in "$tmp"/*.pem; do
    [[ -f "$f" ]] || continue
    subj="$(openssl x509 -noout -subject -in "$f" 2>/dev/null || true)"
    team="$(printf '%s\n' "$subj" | grep -oE 'OU ?= ?[A-Z0-9]{10}' | head -1 | grep -oE '[A-Z0-9]{10}$' || true)"
    org="$(printf '%s\n' "$subj" | sed -nE 's@.*(/|, )O ?= ?([^/,]+).*@\2@p' | head -1 || true)"
    if [[ -n "$team" ]]; then printf '%s\t%s\n' "$team" "$org"; fi
  done | sort -u
  rm -rf "$tmp"
}

cmd_xcode() {
  local team teams n signed was_running=0
  [[ -d "$XCODE_PROJECT" ]] || die "Missing $XCODE_PROJECT"
  xcode_dev_dir >/dev/null || die "Xcode isn't installed (it's free in the App Store)."
  team="$(xcode_team)"
  if [[ -n "$team" ]]; then
    info "Signing team: $team (in host/xcode/Team.xcconfig)"
  else
    teams="$(cert_teams)"
    n="$(printf '%s' "$teams" | grep -c . || true)"
    if [[ "$n" == 1 ]]; then
      team="$(cut -f1 <<<"$teams")"
      printf '// Your signing team (bottle xcode wrote it; not part of the kit)\nDEVELOPMENT_TEAM = %s\n' "$team" > "$TEAM_CONFIG"
      info "Signing team: $team ($(cut -f2 <<<"$teams")), saved in host/xcode/Team.xcconfig"
    elif [[ "$n" -gt 1 ]]; then
      warn "Several teams have certificates here:"
      printf '%s\n' "$teams" | sed 's/^/    /' >&2
      warn "In Xcode: target Portalistic > Signing & Capabilities > Team; then run bottle xcode again."
    else
      warn "No Apple Development certificate here yet. In Xcode: target Portalistic > Signing & Capabilities > Team: your account (Xcode makes the certificate); then run bottle xcode again."
    fi
  fi
  open -a "$(dirname "$(dirname "$(xcode_dev_dir)")")" "$XCODE_PROJECT"
  info "Opened in Xcode. ⌘R builds and runs a debug copy."
  [[ -n "$team" ]] || return 0
  # The app in ~/Applications: the Xcode build, signed with the team, from now on (and right away).
  signed="$(codesign -dv "$APP_DIR" 2>&1 || true)"
  [[ "$signed" == *"TeamIdentifier=$team"* ]] && return 0
  pgrep -f "Portalistic.app/Contents/MacOS/Portalistic" >/dev/null && was_running=1
  mkdir -p "$LOGS_DIR"
  if app_build_xcode "$LOGS_DIR/app-build.log"; then
    info "Portalistic.app in ~/Applications is now the Xcode build, signed with team $team."
    if [[ "$was_running" == 1 ]]; then open "$APP_DIR"; fi
  else
    warn "The Xcode build failed (log: logs/app-build.log); the app you have keeps working. ⌘B in Xcode shows why."
  fi
}

# Builds the app with Xcode, signed with your team, into ~/Applications. Fails (1) without Xcode
# or a team, or when the build fails (its log: logs/app-build.log).
app_build_xcode() {
  local dev build product path
  [[ -d "$XCODE_PROJECT" && -n "$(xcode_team)" ]] || return 1
  dev="$(xcode_dev_dir)" || return 1
  build="$HOME/Library/Caches/Portalistic/xcode-build"
  path="$(printf '%s' "$PATH" | tr ':' '\n' | awk 'NF && !seen[$0]++' | paste -sd: - | tr -d '&<>"')"
  info "Building Portalistic.app with Xcode (once per update, about a minute)…"
  if ! DEVELOPER_DIR="$dev" xcodebuild -project "$XCODE_PROJECT" -target "Portalistic" \
        -configuration Release -allowProvisioningUpdates \
        SYMROOT="$build" OBJROOT="$build/obj" BOTTLE_KIT_DIR="$KIT_DIR" BOTTLE_PATH="$path" \
        build >"$1" 2>&1; then
    grep -E "error:" "$1" | head -10 >&2 || true
    return 1
  fi
  product="$build/Release/Portalistic.app"
  [[ -x "$product/Contents/MacOS/Portalistic" ]] || { echo "error: no app in $product" >>"$1"; return 1; }
  app_quit_running
  rm -rf "$APP_DIR.new"
  ditto "$product" "$APP_DIR.new" || return 1
  rm -rf "$APP_DIR" || return 1
  mv "$APP_DIR.new" "$APP_DIR" || return 1
  touch "$APP_DIR"   # Finder and the Dock pick up the new icon
}

# A copy that's already running would keep the old build: quit it (the VM carries on), and wait
# until it's gone, so opening the app afterwards starts the new one.
app_quit_running() {
  local i=0
  pkill -f "Portalistic.app/Contents/MacOS/Portalistic" 2>/dev/null || return 0
  while pgrep -f "Portalistic.app/Contents/MacOS/Portalistic" >/dev/null && (( i < 20 )); do
    sleep 0.25; i=$((i + 1))
  done
}

# Any of the app's source files changed after $1 was built (awk reads it all: no SIGPIPE for find).
app_sources_newer() {
  find "$APP_SRC" -name '*.swift' -newer "$1" 2>/dev/null | awk 'END { exit NR == 0 }'
}

# The app was called SteamOS Bottle until Oct 12, 2026 (the project is Portalistic now): once the
# renamed app is built, the old copy in ~/Applications and its build cache go.
OLD_APP_DIR="$HOME/Applications/SteamOS Bottle.app"
app_retire_old() {
  [[ -d "$OLD_APP_DIR" && -x "$APP_DIR/Contents/MacOS/Portalistic" ]] || return 0
  pkill -f "SteamOS Bottle.app/Contents/MacOS/SteamOSBottle" 2>/dev/null || true
  rm -rf "$OLD_APP_DIR" "$HOME/Library/Caches/SteamOS Bottle"
  info "Removed the old SteamOS Bottle.app: the app is Portalistic.app now"
}

app_build() {  # build the app bundle when it's missing or older than its source
  local bin="$APP_DIR/Contents/MacOS/Portalistic" f
  local log="$LOGS_DIR/app-build.log"
  local -a srcs=()
  [[ -d "$APP_SRC" ]] || die "Missing $APP_SRC"
  [[ -x "$bin" ]] && ! app_sources_newer "$bin" && return 0
  mkdir -p "$LOGS_DIR"
  if [[ -d "$XCODE_PROJECT" && -n "$(xcode_team)" ]] && xcode_dev_dir >/dev/null; then
    app_build_xcode "$log" && return 0
    cp -f "$log" "$LOGS_DIR/app-build-xcode.log" 2>/dev/null || true
    warn "Building the app with Xcode failed (log: logs/app-build-xcode.log); building it with swiftc instead (not signed with your team)."
  fi
  command -v swiftc >/dev/null || die "Building the app needs Xcode's Swift compiler (or: xcode-select --install)"
  info "Building Portalistic.app (once per update, ~30 s)…"
  mkdir -p "$APP_DIR/Contents/MacOS"
  # macOS 13 or later (as Info.plist says): controllers, rumble and the window subtitle need 11+.
  # -parse-as-library: the app starts at its @main type (as in the Xcode build).
  while IFS= read -r -d '' f; do srcs+=("$f"); done < <(find "$APP_SRC" -name '*.swift' -print0)
  if ! swiftc -O -parse-as-library -module-name Portalistic -target "$(uname -m)-apple-macosx13.0" \
        -o "$bin.new" "${srcs[@]}" >"$log" 2>&1; then
    grep -E "error:" "$log" | head -10 >&2 || true
    rm -f "$bin.new"
    if [[ -x "$bin" ]]; then  # keep using the build that works
      warn "Building the new app failed (log: $log); opening the previous one."
      touch "$bin"; return 0
    fi
    die "Building the app failed; full log: $log"
  fi
  app_quit_running
  mv -f "$bin.new" "$bin"
  # The app runs this kit's bottle command (starting the VM, the Bottle menu): it needs to know
  # where the kit is, and the PATH (opened from the Dock it gets a bare one, without Homebrew).
  local xml_kit xml_path
  xml_kit="$(printf '%s' "$KIT_DIR" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
  xml_path="$(printf '%s' "$PATH" | tr ':' '\n' | awk 'NF && !seen[$0]++' | paste -sd: - \
              | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"   # each folder once
  mkdir -p "$APP_DIR/Contents/Resources"
  [[ -f "$KIT_DIR/host/AppIcon.icns" ]] && cp -f "$KIT_DIR/host/AppIcon.icns" "$APP_DIR/Contents/Resources/AppIcon.icns"
  cat > "$APP_DIR/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>BottleKitDir</key><string>$xml_kit</string>
  <key>BottlePath</key><string>$xml_path</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleExecutable</key><string>Portalistic</string>
  <key>CFBundleIdentifier</key><string>io.github.mcstig.portalistic</string>
  <key>CFBundleName</key><string>Portalistic</string>
  <key>CFBundleDisplayName</key><string>Portalistic</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(sed -n 's/^MARKETING_VERSION *= *//p' "$KIT_DIR/host/xcode/Bottle.xcconfig")</string>
  <key>CFBundleVersion</key><string>$(sed -n 's/^CURRENT_PROJECT_VERSION *= *//p' "$KIT_DIR/host/xcode/Bottle.xcconfig")</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF
  codesign --force --sign - "$APP_DIR" >/dev/null 2>&1 || true
  touch "$APP_DIR"   # Finder and the Dock pick up the new icon
}

# The kit's VM side (guest/) as one short fingerprint: what bottle update last installed is
# kept in the VM (~/.cache/steamos-bottle/kit-stamp), so the bottle can tell when the VM is
# behind the kit and update it by itself (Oct 9: a fix sat on the Mac, never installed).
kit_stamp() {
  # (not guest/tests: selftests copy them when they run, and the packaged app leaves them out)
  ( cd "$KIT_DIR" && find guest -type f ! -path 'guest/tests/*' ! -name .DS_Store ! -name '*.pyc' -print0 | LC_ALL=C sort -z \
      | xargs -0 shasum -a 1 | shasum -a 1 | cut -c1-16 )
}
vm_kit_stamp() { vsh_for 30 bash -c 'cat ~/.cache/steamos-bottle/kit-stamp 2>/dev/null' 2>/dev/null | tail -n 1; }

# Brings the VM up to the kit when it's behind (not while a game runs: the update restarts the
# screen server). $1 = what happens next, for the message. Returns 0 if it updated.
update_if_behind() {
  local want have
  want="$(kit_stamp)" || return 1
  have="$(vm_kit_stamp)"
  [[ -n "$want" && "$want" != "$have" ]] || return 1
  if [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    warn "The kit has changes the VM doesn't have yet; they go in when no game is running (bottle update)."
    return 1
  fi
  info "The kit changed since the VM was last updated: updating it first${1:+ ($1)}…"
  cmd_update --now
}

# Everything the app shows, running: the VM, its desktop and screen server, Steam, the sound on
# this Mac and the keep-awake watcher. The app runs this itself (bottle _up) when it opens and
# the bottle isn't there; its "==>" lines are the app's progress messages.
cmd_up() {
  need_vm
  [[ "$(vm_status)" == Running ]] || vm_start
  # The VM side (built by bottle update): bottle-desktop starts the screen server and
  # maximizes Steam's window (safe to run again).
  vsh bash -c 'command -v bottle-screen >/dev/null' \
    || die "The VM doesn't have the screen server yet. Run: bottle update"
  local broken
  broken="$(vm_tools_damaged)"
  if [[ -n "$broken" ]]; then
    info "Some of the bottle's programs in the VM were lost when it was last stopped; reinstalling them (a minute or two)…"
    printf '%s\n' "$broken" | sed 's/^/  lost: /'
    cmd_update --now
  else
    update_if_behind "then Steam" || true
  fi
  info "Starting the desktop…"
  desktop_start >/dev/null
  if steam_running; then info "Steam is running."; else steam_start "$debug"; fi
  audio_start
  awake_start
  screen_check
  info "Ready."
}

# Lima has the VM's screen port open on this Mac (it forwards a port once the VM listens on it).
# Asking lsof doesn't connect: bottle-screen serves one window, a test connection would take over.
screen_reachable() { lsof -nP -iTCP:"$SCREEN_PORT" -sTCP:LISTEN >/dev/null 2>&1; }

# The app's screen reaches this Mac. If it doesn't within 10 s, the screen server starts afresh
# once (Lima picks the port up when it opens again). If it won't stay up, it runs here for a few
# seconds to show its own error or how it died (and the kernel's word on it); if it runs fine
# that way, it's started like that. Otherwise says which part is missing (the app shows it).
screen_check() {
  local i
  for i in $(seq 1 10); do screen_reachable && return 0; sleep 1; done
  info "The VM's screen isn't reaching this Mac; restarting the screen server…"
  vsh bash -c 'pkill -x bottle-screen; sleep 1' || true
  desktop_start >/dev/null || true
  for i in $(seq 1 15); do screen_reachable && return 0; sleep 1; done
  if ! vsh bash -c 'pgrep -x bottle-screen >/dev/null'; then
    warn "The screen server stops right after it starts. Running it for a few seconds:"
    # shellcheck disable=SC2016  # runs in the VM
    if vsh bash -c '
        cd /tmp
        DISPLAY=:1 timeout 4 bottle-screen -d :1 -p "$1" 2>&1 | tail -8
        rc=${PIPESTATUS[0]}
        if [ "$rc" = 124 ]; then echo "  (it ran fine this way)"; exit 0; fi
        echo "bottle-screen exited with status $rc$([ "$rc" -gt 128 ] && echo " (signal $((rc - 128)))")"
        ls -l "$(command -v bottle-screen)"; file "$(command -v bottle-screen)" 2>/dev/null
        sudo -n journalctl -k -n 200 --no-pager 2>/dev/null | grep -i "bottle-screen" | tail -3
        sudo -n coredumpctl list bottle-screen --no-pager 2>/dev/null | tail -2
        exit 1' _ "$SCREEN_PORT" >&2; then
      vsh bash -c 'setsid -f bottle-screen -d :1 -p "$1" </dev/null >>~/.config/steamos-bottle/screen.log 2>&1' _ "$SCREEN_PORT" || true
      for i in $(seq 1 10); do screen_reachable && return 0; sleep 1; done
    fi
    die "The VM's screen server doesn't start (why: Show Log). Bottle > Save Logs has the rest."
  fi
  if ! vsh bash -c "ss -ltn 2>/dev/null | grep -q ':$SCREEN_PORT '"; then
    die "The VM's screen server runs but doesn't open port $SCREEN_PORT. Bottle > Save Logs has its log."
  fi
  die "The VM's screen server runs, but Lima doesn't bring its port to this Mac. Bottle > Shut Down the VM, then start it again."
}

cmd_window() {
  cmd_up
  if [[ -n "$APP_BUNDLE" ]]; then open "$APP_BUNDLE"; return 0; fi
  app_build
  app_retire_old
  open "$APP_DIR"
  info "Portalistic is open. In games that hide the pointer the mouse is captured; ⌘Esc releases it."
}

# The app found its source newer than itself (an update): build it, then open the new one. Runs
# detached from the app, which app_build quits once the new build is ready.
cmd_rebuild_app() {
  if [[ -n "$APP_BUNDLE" ]]; then open "$APP_BUNDLE"; return 0; fi   # (the app updates as a whole)
  app_build
  app_retire_old
  sleep 1
  open "$APP_DIR"
}

# ---- sound on the Mac (host/bottle-audio.swift) ----
audio_build() {  # compile the player when it's missing or older than its source (the app has it built)
  [[ -n "$APP_BUNDLE" ]] && { [[ -x "$AUDIO_BIN" ]]; return; }
  local src="$KIT_DIR/host/bottle-audio.swift"
  [[ -f "$src" ]] || return 1
  if [[ ! -x "$AUDIO_BIN" || "$src" -nt "$AUDIO_BIN" ]]; then
    if ! command -v swiftc >/dev/null; then
      warn "No Swift compiler, so no sound on the Mac (install Xcode or: xcode-select --install)"
      return 1
    fi
    info "Building the sound player (once, ~20 s)…"
    mkdir -p "$STATE_DIR" "$LOGS_DIR"
    if ! swiftc -O -o "$AUDIO_BIN.new" "$src" >"$LOGS_DIR/audio-build.log" 2>&1; then
      warn "Couldn't build the sound player; details: $LOGS_DIR/audio-build.log"
      return 1
    fi
    mv -f "$AUDIO_BIN.new" "$AUDIO_BIN"
  fi
}
audio_pid() { pgrep -f "/bottle-audio( |$)" | head -1 || true; }
audio_start() {  # never fails the calling command
  [[ "${BOTTLE_AUDIO:-1}" == 0 ]] && return 0
  audio_build || return 0
  if [[ -n "$(audio_pid)" ]]; then
    # already playing, unless the player was just rebuilt: then restart it
    [[ "$AUDIO_BIN" -nt "$STATE_DIR/audio.log" ]] || return 0
    audio_stop
    sleep 0.3
  fi
  nohup "$AUDIO_BIN" >"$STATE_DIR/audio.log" 2>&1 </dev/null &
  disown 2>/dev/null || true
  info "Sound: the bottle's audio plays on this Mac (bottle audio off to stop)."
}
audio_stop() {
  local pid
  pid="$(audio_pid)"
  [[ -n "$pid" ]] && kill "$pid" 2>/dev/null
  return 0
}
# ---- the VM's disk ----
# Games live on the VM's disk (a file in ~/.lima/<vm> that takes Mac space only as it fills),
# or in game folders on the Mac or a drive (bottle library add, below).
vm_disk_gb() { echo $(( $(limactl list --format '{{.Disk}}' "$VM_NAME" 2>/dev/null || echo 0) / 1073741824 )); }
mac_free_gb() { df -g "$HOME" 2>/dev/null | awk 'NR == 2 {print $4}'; }   # (the VM's disk is in the home folder's volume)

disk_status() {
  need_vm
  echo "== The VM's disk: $(vm_disk_gb) GB inside the VM; it takes $(vm_disk_mac_gb) GB of this Mac now (deleted files give their space back); this Mac has $(mac_free_gb) GB free"
  echo "== Games outside the VM's disk: bottle library folders"
  [[ "$(vm_status)" == Running ]] || { echo "(start the VM to see what's on it)"; return 0; }
  # shellcheck disable=SC2016  # runs in the VM
  vsh bash -c '
    df -h / | awk "NR == 2 {print \"== In the VM: \" \$3 \" used, \" \$4 \" free (\" \$5 \" full)\"}"
    echo "== Biggest (games, downloads in progress, Windows prefixes, caches, logs):"
    S=$HOME/.local/share/Steam/steamapps
    { du -sh "$S"/common/* "$S"/downloading/* "$S"/temp "$S"/shadercache "$S"/compatdata \
          "$HOME"/steam-*.log "$HOME"/.cache 2>/dev/null
      sudo -n du -sh /var/cache/libdnf5 /var/cache/dnf /var/log/journal /var/lib/systemd/coredump 2>/dev/null
    } | sort -rh | head -15 | sed "s#$S/##; s#$HOME/#~/#"'
}

disk_clean() {  # only things nothing needs: package caches, old system logs, crash dumps, huge game logs
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  info "Clearing package caches, old system logs, crash dumps and game logs over 50 MB in the VM…"
  vsh bash -c '
    sudo -n dnf clean all -q >/dev/null 2>&1
    sudo -n journalctl --vacuum-size=100M -q >/dev/null 2>&1
    sudo -n sh -c "rm -f /var/lib/systemd/coredump/*" 2>/dev/null
    find ~ -maxdepth 1 -name "steam-*.log" -size +50M -delete 2>/dev/null
    df -h / | awk "NR == 2 {print \"In the VM now: \" \$4 \" free\"}"'
}

disk_grow() {  # $1 = new size in GB (default 200). Safe to run again: it finishes a grow
  local want="${1:-200}" cur free started=1 restart=0 startlog="$STATE_DIR/vm-start.log"
  need_vm
  [[ "$want" =~ ^[0-9]+$ ]] || die "usage: bottle disk grow [GB]   (default 200)"
  mkdir -p "$STATE_DIR"
  cur="$(vm_disk_gb)"
  audio_stop
  awake_stop
  if (( want > cur )); then
    free="$(mac_free_gb)"
    if (( free < want - cur + 10 )); then
      die "Growing to ${want} GB can take up to $(( want - cur )) GB more on this Mac, which has ${free} GB free. A size that fits: bottle disk grow $(( cur + free - 20 ))"
    fi
    info "Growing the VM's disk from ${cur} GB to ${want} GB (it takes Mac space only as games fill it)."
    if [[ "$(vm_status)" == Running ]]; then
      info "Stopping the VM…"
      vm_stop >/dev/null 2>&1 || vm_stop --force >/dev/null 2>&1 || true
    fi
    limactl edit "$VM_NAME" --disk "$want" </dev/null || die "Lima couldn't resize the disk (see above). Start the VM again with: bottle start"
  else
    info "The VM's disk is ${cur} GB; making sure the VM's file system uses all of it."
    # A VM already running here may have started on a full disk, which keeps Lima from
    # finishing its start-up: restart it once the space is there.
    [[ "$(vm_status)" == Running ]] && restart=1
  fi
  # On a full disk Lima can't finish starting the VM (it gives up after 10 minutes), but the
  # VM's ssh comes up, and that's all this needs. So Lima starts in the background.
  if [[ "$(vm_status)" != Running ]]; then
    info "Starting the VM (only its ssh is needed for this; up to 5 minutes)…"
    vm_start >>"$startlog" 2>&1 &
    started=0
  fi
  info "Waiting for the VM to answer…"
  if ! vm_answers $(( started ? 180 : 360 )); then
    info "The VM doesn't answer; restarting it (up to 10 minutes)…"
    limactl stop --force "$VM_NAME" >/dev/null 2>&1 || true
    sleep 2
    vm_start >>"$startlog" 2>&1 &
    started=0
    if ! vm_answers 600; then
      log_export || true
      die "The VM still doesn't answer. Its logs are saved (above): attach them to a bug report on github.com/mcstig/PorTalistic."
    fi
  fi
  info "Growing the VM's file system into the disk…"
  # Fedora's cloud-init does this at boot when it can; on a full disk it can't.
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 180 bash -c '
    src="$(findmnt -no SOURCE / | sed "s/\[.*//")"; fs="$(findmnt -no FSTYPE /)"
    part="${src##*/}"; disk="/dev/$(lsblk -no PKNAME "$src" | head -1)"
    num="$(cat "/sys/class/block/$part/partition" 2>/dev/null)"
    before="$(df -h / | awk "NR == 2 {print \$4}")"
    if [ -n "$num" ]; then
      if command -v growpart >/dev/null; then
        sudo -n growpart "$disk" "$num" >/dev/null 2>&1 || true   # NOCHANGE when already done
      else
        echo ", +" | sudo -n sfdisk -N "$num" --no-reread "$disk" >/dev/null 2>&1 || true
        sudo -n partx -u "$disk" 2>/dev/null || true
      fi
    fi
    case "$fs" in
      btrfs) sudo -n btrfs filesystem resize max / >/dev/null ;;
      ext4)  sudo -n resize2fs "$src" >/dev/null 2>&1 ;;
      xfs)   sudo -n xfs_growfs / >/dev/null ;;
    esac
    df -h / | awk -v b="$before" "NR == 2 {print \"In the VM: \" \$2 \" disk, \" \$4 \" free (was \" b \")\"}"' \
    || warn "Growing the file system didn't finish (see above)."
  if (( !started || restart )); then
    info "Restarting the VM so it starts up normally with the space (a minute or two)…"
    vm_stop >/dev/null 2>&1 || vm_stop --force >/dev/null 2>&1 || true
    sleep 2
    if ! vm_start; then
      log_export || true
      die "Lima still couldn't finish starting the VM. Its logs are saved (above): attach them to a bug report on github.com/mcstig/PorTalistic."
    fi
  fi
  desktop_start >/dev/null
  steam_start "$debug"
  audio_start
  awake_start
  info "Done. Steam carries on with its downloads."
}

# ---- game folders: games on the Mac or a drive instead of the VM's disk ----
# The VM's disk is one file on the Mac that grows as the VM fills it (and shrinks again when files
# are deleted: the VM's file system hands freed blocks back), but inside the VM Steam sees the
# disk's own size (200 GB), not the Mac's free space. A game folder is a plain folder on this Mac
# or on a drive, shared with the VM (a writable Lima mount at /mnt/portalistic/NAME): games there
# are ordinary files on that drive, Steam sees its real free space before an install, and an
# uninstall gives the space straight back. bottle-libraries in the VM makes each one a Steam
# library (steam-arm64 runs it before Steam starts). The list, ~/.config/steamos-bottle/libraries:
# "default NAME" (or vm), "stamp N" (when the default was last chosen), then NAME<TAB>LABEL<TAB>PATH.
# The VM gets its shares only when it starts, so adding or removing a folder restarts it, and a
# drive must be connected when the VM starts (one that isn't is left out until the next start).
LIB_CONF="$STATE_DIR/libraries"
LIB_APPLIED="$STATE_DIR/libraries-mounted"   # the mounts last given to Lima
LIB_MOUNT_ROOT=/mnt/portalistic
LIB_MAC_DIR="$HOME/Games/Portalistic"
LIB_DRIVE_DIR="Portalistic Library"
LIB_HOME_ONLY='.mounts = [{"location": "~"}]'
MAC_STEAM_LIBS="$HOME/Library/Application Support/Steam/config/libraryfolders.vdf"

json_str() {  # a JSON string
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}
lib_rows() {  # NAME<TAB>LABEL<TAB>PATH, one per game folder
  [[ -f "$LIB_CONF" ]] || return 0
  awk -F'\t' 'NF >= 3 && $1 ~ /^[a-z0-9][a-z0-9-]*$/ {print}' "$LIB_CONF"
}
lib_key() { [[ -f "$LIB_CONF" ]] || return 0; awk -F'\t' -v k="$1" 'NF == 2 && $1 == k {print $2; exit}' "$LIB_CONF"; }
lib_find() { lib_rows | awk -F'\t' -v w="$1" '$1 == w || $3 == w {print; exit}'; }
lib_save() {  # $1 default, $2 stamp; the rows on stdin
  local rows
  rows="$(cat)"
  mkdir -p "$STATE_DIR"
  { echo "# Portalistic's game folders (bottle library add|remove|default): the default for new games,"
    echo "# when it was chosen, then NAME<TAB>LABEL<TAB>PATH. The VM shares each at $LIB_MOUNT_ROOT/NAME."
    printf 'default\t%s\nstamp\t%s\n' "$1" "$2"
    [[ -n "$rows" ]] && printf '%s\n' "$rows"
    true
  } > "$LIB_CONF.tmp" && mv -f "$LIB_CONF.tmp" "$LIB_CONF"
}

# The VM's shares as Lima mounts (a yq expression): the home folder, read-only as always, and
# each game folder that's there right now.
lib_mounts_expr() {
  local expr='.mounts = [{"location": "~"}' name label path
  while IFS=$'\t' read -r name label path; do
    [[ -n "$name" && -d "$path" ]] || continue
    expr="$expr, {\"location\": $(json_str "$path"), \"mountPoint\": \"$LIB_MOUNT_ROOT/$name\", \"writable\": true}"
  done < <(lib_rows)
  echo "$expr]"
}
# Before the VM starts (Lima reads its mounts then). $1 = none: the home folder only.
lib_mounts_apply() {
  local expr name label path
  [[ -f "$LIB_CONF" || -f "$LIB_APPLIED" ]] || return 0   # never used: Lima's settings stay as they are
  if [[ "${1:-}" == none ]]; then expr="$LIB_HOME_ONLY"; else expr="$(lib_mounts_expr)"; fi
  if [[ "${1:-}" != none ]]; then
    while IFS=$'\t' read -r name label path; do
      [[ -z "$name" || -d "$path" ]] || warn "Game folder $label isn't there ($path): the VM starts without it (connect the drive, then: bottle restart)"
    done < <(lib_rows)
  fi
  [[ "$(cat "$LIB_APPLIED" 2>/dev/null)" == "$expr" ]] && return 0
  if ! limactl edit --tty=false "$VM_NAME" --set "$expr" </dev/null >/dev/null; then
    warn "Lima couldn't change the folders the VM shares (see above)."
    return 1
  fi
  printf '%s\n' "$expr" > "$LIB_APPLIED"
}
# The list, as the VM's bottle-libraries reads it (~/.config/steamos-bottle/libraries.json there).
lib_push_conf() {
  local json sep="" name label path
  [[ -f "$LIB_CONF" ]] || return 0
  json="{\"default\": $(json_str "$(lib_key default)"), \"stamp\": $(json_str "$(lib_key stamp)"), \"folders\": ["
  while IFS=$'\t' read -r name label path; do
    [[ -n "$name" ]] || continue
    json="$json$sep{\"name\": $(json_str "$name"), \"label\": $(json_str "$label"), \"path\": $(json_str "$path")}"
    sep=", "
  done < <(lib_rows)
  json="$json]}"
  # (base64: the text goes through ssh's command line unharmed)
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 20 bash -c 'mkdir -p ~/.config/steamos-bottle && printf %s "$1" | base64 -d > ~/.config/steamos-bottle/libraries.json' \
    _ "$(printf '%s' "$json" | base64 | tr -d '\n')" >/dev/null 2>&1 || warn "Couldn't give the VM the list of game folders."
}

lib_game_running() {
  [[ "$(vm_status)" == Running ]] \
    && [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]
}

# The VM shares folders only from its start: restart it (with Steam) to share the new list.
lib_restart_vm() {
  need_vm
  if [[ "$(vm_status)" != Running ]]; then
    info "The VM shares it from its next start (bottle start)."
    return 0
  fi
  if lib_game_running; then
    die "A game is running. Quit it, then: bottle restart (the VM shares the game folders from its next start)."
  fi
  info "Restarting the VM so it shares the game folders (a minute or two)…"
  audio_stop
  awake_stop
  steam_stop
  info "Stopping the VM…"
  vm_stop >/dev/null 2>&1 || vm_stop --force >/dev/null 2>&1 || true
  vm_start || die "The VM didn't start (see above). Try: bottle start"
  update_if_behind "then Steam starts" || true
  desktop_start >/dev/null
  steam_start "$debug"
  audio_start
  awake_start
  lib_status_vm 60
}
# What Steam made of them: bottle-libraries status in the VM, once Steam has started ($1: seconds
# to wait for steam-arm64 to have set them up).
lib_status_vm() {
  local end=$(( SECONDS + ${1:-0} ))
  [[ "$(vm_status)" == Running ]] || return 0
  vsh_for 20 bash -c 'command -v bottle-libraries >/dev/null' || return 0
  while (( SECONDS < end )); do
    vsh_for 10 bash -c 'pgrep -f "[s]teamrtarm64/steam( |$)" >/dev/null' && break
    sleep 2
  done
  vsh_for 30 bottle-libraries status || true
}

lib_slug() {  # a short name for the list and the VM's mount: lower case, letters, digits, dashes
  local s
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//; s/-$//')"
  [[ -n "$s" ]] || s=drive
  [[ "$s" == vm ]] && s=vm-folder
  echo "$s"
}

lib_add() {
  local arg="" make_default=0 a dir label vol vroot=/ name base n fs row def
  for a in "$@"; do
    case "$a" in
      --default) make_default=1 ;;
      --debug) ;;
      -*) die "usage: bottle library add PATH [--default]" ;;
      *) [[ -z "$arg" ]] || die "usage: bottle library add PATH [--default]"; arg="$a" ;;
    esac
  done
  [[ -n "$arg" ]] || die "usage: bottle library add PATH [--default]   (a folder on this Mac, e.g. ~/Games/Portalistic, or a drive: /Volumes/NAME)"
  # shellcheck disable=SC2088  # a "~" that came in quoted
  case "$arg" in "~") arg="$HOME" ;; "~/"*) arg="$HOME/${arg#\~/}" ;; esac
  [[ "$arg" == /* ]] || die "Give the whole path (e.g. ~/Games/Portalistic or /Volumes/SSD)."
  while [[ "$arg" == */ && "$arg" != / ]]; do arg="${arg%/}"; done
  case "$arg" in
    /Volumes/*/*) vol="${arg#/Volumes/}"; vol="${vol%%/*}"; dir="$arg" ;;
    /Volumes/*)   vol="${arg#/Volumes/}"; dir="$arg/$LIB_DRIVE_DIR" ;;
    *)            vol=""; dir="$arg" ;;
  esac
  if [[ -n "$vol" ]]; then
    [[ -d "/Volumes/$vol" ]] || die "No drive called \"$vol\" is connected (ls /Volumes shows what is)."
    [[ "/Volumes/$vol" -ef / ]] && die "That's this Mac's own disk: give a folder on it instead (e.g. bottle library add ~/Games/Portalistic)."
    label="$vol"
    vroot="/Volumes/$vol"
  else
    [[ "$dir" == "$HOME"/* || -d "${dir%/*}" || -d "$dir" ]] || die "There's no folder ${dir%/*} on this Mac."
    label="Mac"
    [[ -n "$(lib_find mac)" && "$(lib_find mac | cut -f3)" != "$dir" ]] && label="${dir##*/}"
  fi
  case "$dir/" in
    "$KIT_DIR/"*|"$HOME/.lima/"*|"$HOME/.portalistic/"*|"$HOME/Library/"*|"$HOME/.Trash/"*|/System/*|/Applications/*|/usr/*|/private/*)
      die "Not there: $dir is for macOS, Lima or the kit. A folder like ~/Games/Portalistic, or a drive, is the place for games." ;;
  esac
  # A Steam library of the Mac's own Steam (or any other Steam): the VM's Steam would replace the
  # Mac versions of its games with Linux or Windows ones. Portalistic keeps its own folder.
  if [[ -f "$MAC_STEAM_LIBS" ]]; then
    while IFS= read -r a; do
      [[ -n "$a" && "$a" != "$HOME/Library/Application Support/Steam" ]] || continue
      case "$dir/" in "$a/"*)
        die "$a is your Mac Steam's library: Steam in the VM would replace the Mac versions of its games. Give the drive instead (bottle library add \"$( [[ -n "$vol" ]] && echo "/Volumes/$vol" || echo "$LIB_MAC_DIR")\"): Portalistic makes its own folder on it." ;;
      esac
    done < <(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$MAC_STEAM_LIBS")
  fi
  if [[ ! -f "$dir/.portalistic-library" ]] && compgen -G "$dir/steamapps/appmanifest_*.acf" >/dev/null; then
    die "$dir is already another Steam's library (it has games in steamapps/). Give a new folder, or the drive (/Volumes/NAME): Portalistic makes its own folder on it."
  fi
  # The VM keeps Linux file details there (permissions, links): a Mac format, not exFAT/NTFS/FAT.
  fs="$(diskutil info "$vroot" 2>/dev/null | sed -n 's/^ *File System Personality: *//p' | head -1)"
  case "$fs" in
    *APFS*|*HFS*|"") ;;
    *) die "${vol:-This disk} is formatted as $fs. Games need a Mac format there (APFS: Disk Utility > Erase, which deletes what's on it), since Steam in the VM needs links and file permissions." ;;
  esac
  [[ "$(diskutil info "$vroot" 2>/dev/null | sed -n 's/^ *Protocol: *//p' | head -1)" == "Disk Image" ]] \
    && die "/Volumes/$vol is a disk image, not a drive."

  # (krunkit takes the folder as "sharedDir=PATH,mountTag=..." and Lima's file is YAML)
  [[ "$dir" != *,* && "$dir" != *$'\n'* ]] || die "Portalistic can't share a folder with a comma in its path; rename it or pick another."
  row="$(lib_find "$dir")"
  def="$(lib_key default)"
  if [[ -n "$row" ]]; then
    name="$(cut -f1 <<<"$row")"
    info "$dir is already a game folder ($name)."
    if (( make_default )) && [[ "$def" != "$name" ]]; then lib_default_set "$name"; fi
    return 0
  fi
  mkdir -p "$dir/steamapps" || die "Couldn't make $dir."
  [[ -w "$dir" ]] || die "$dir isn't writable."
  printf 'Portalistic game folder (bottle library add). The VM shares it with Steam; its games are\nnormal files here. bottle library remove forgets it (the games stay).\n' > "$dir/.portalistic-library" 2>/dev/null || true
  # games come back from Steam: not worth the Time Machine space
  tmutil addexclusion "$dir" >/dev/null 2>&1 || true
  base="$(lib_slug "$( [[ -z "$vol" && "$label" == Mac ]] && echo mac || echo "$label")")"
  name="$base" n=2
  while [[ -n "$(lib_find "$name")" ]]; do name="$base-$n"; n=$(( n + 1 )); done
  if (( make_default )) || [[ -z "$def" ]]; then def="$name"; fi
  { lib_rows; printf '%s\t%s\t%s\n' "$name" "$label" "$dir"; } \
    | lib_save "$def" "$( [[ "$def" == "$name" ]] && date +%s || lib_key stamp)"
  info "Game folder \"$label\" ($name): $dir$( [[ "$def" == "$name" ]] && echo ', the default for new games')"
  case "$dir/" in
    "$HOME/Documents/"*|"$HOME/Desktop/"*|"$HOME/Downloads/"*)
      info "macOS may ask whether the VM may use that folder: allow it." ;;
  esac
  [[ -n "$vol" ]] && info "Keep $vol connected while the bottle runs, and eject it only after: bottle stop."
  lib_restart_vm
}

lib_remove() {
  local want="${1:-}" row name label dir def
  [[ -n "$want" ]] || die "usage: bottle library remove NAME   (NAME from: bottle library folders)"
  row="$(lib_find "$want")"
  [[ -n "$row" ]] || die "No game folder called $want (bottle library folders lists them)."
  IFS=$'\t' read -r name label dir <<<"$row"
  def="$(lib_key default)"
  if [[ "$def" == "$name" ]]; then
    def=vm
    [[ "$name" != mac && -n "$(lib_find mac)" ]] && def=mac
  fi
  lib_rows | awk -F'\t' -v n="$name" '$1 != n' | lib_save "$def" "$(date +%s)"
  info "Steam stops using \"$label\". Its games stay in $dir (bottle library add $dir brings them back)."
  lib_restart_vm
}

lib_default_set() {  # $1 = NAME or vm
  local want="${1:-}" row
  [[ -n "$want" ]] || die "usage: bottle library default NAME   (NAME from: bottle library folders, or vm for the VM's disk)"
  if [[ "$want" != vm ]]; then
    row="$(lib_find "$want")"
    [[ -n "$row" ]] || die "No game folder called $want (bottle library folders lists them)."
    want="$(cut -f1 <<<"$row")"
  fi
  lib_rows | lib_save "$want" "$(date +%s)"
  if [[ "$(vm_status)" != Running ]]; then
    info "New games will install to $want (from the VM's next start)."
    return 0
  fi
  lib_game_running && die "A game is running. Quit it first (Steam restarts to take the new default; it's saved and applies at Steam's next start)."
  lib_push_conf
  # (Steam keeps this setting in memory and writes it back when it quits: so it quits first,
  # and steam-arm64 sets it before Steam starts again)
  if steam_running; then
    steam_stop
    steam_start "$debug"
  else
    vsh_for 60 bash -c 'command -v bottle-libraries >/dev/null && bottle-libraries sync' || true
  fi
  info "New games install to $( [[ "$want" == vm ]] && echo "the VM's disk" || lib_find "$want" | cut -f2) by default (Steam > Settings > Storage changes it too)."
  lib_status_vm 60
}

lib_folders() {
  local name label path def free n=0
  def="$(lib_key default)"
  echo "== Game folders (bottle library add PATH; a drive: /Volumes/NAME):"
  while IFS=$'\t' read -r name label path; do
    [[ -n "$name" ]] || continue
    n=$(( n + 1 ))
    if [[ -d "$path" ]]; then free="$(df -g "$path" 2>/dev/null | awk 'NR == 2 {print $4}') GB free"; else free="not connected"; fi
    echo "  $name: \"$label\", $path ($free)$( [[ "$name" == "$def" ]] && echo '; the default for new games')"
  done < <(lib_rows)
  (( n )) || echo "  none yet: games go on the VM's disk. A folder on this Mac for them: bottle library add \"$LIB_MAC_DIR\" --default"
  echo "== The VM's disk: takes $(vm_disk_mac_gb) GB of this Mac now (it grows and shrinks with what's on it); the Mac has $(mac_free_gb) GB free$( [[ "$def" == vm ]] && echo '; the default for new games')"
  lib_status_vm 0
}

# ---- the Mac's free space (the watcher, every round) ----
# The VM's disk takes Mac space as it fills, but inside the VM it looks like 200 GB with plenty
# free, so Steam would download into it until the Mac is full, and a VM whose disk can't grow
# any more stops working. Under BOTTLE_DISK_LOW_GB (10) free, the watcher has the VM hand back
# what deleted files freed and puts a warning in the app (every 15 minutes at most); under
# BOTTLE_DISK_STOP_GB (3), a Steam download that's making the VM's disk grow is stopped (Steam
# quits; Bottle > Restart Steam brings it back). Game folders don't need this: Steam sees their
# drive's real free space.
VM_DIR="${LIMA_HOME:-$HOME/.lima}/$VM_NAME"
vm_disk_kb() { local b; b="$(stat -f %b "$VM_DIR/disk" 2>/dev/null || echo 0)"; echo $(( b / 2 )); }
vm_disk_mac_gb() { echo $(( $(vm_disk_kb) / 1000000 )); }
vm_notice() {  # $1 kind (0 news, 1 a problem), $2 seconds, $3 title, $4 text: a banner in the app
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 15 bash -c 'd=~/.cache/steamos-bottle/notices; mkdir -p "$d"; f="$d/$(date +%s%N).txt"
    printf "%s %s\n%s\n%s\n" "$1" "$2" "$3" "$4" > "$f.tmp" && mv "$f.tmp" "$f"' _ "$1" "$2" "$3" "$4" >/dev/null 2>&1 || true
}
DG_LAST="" DG_WARNED=0
disk_guard() {  # $1 = what Steam does: game, download, idle
  local free now size grew=0
  free="$(mac_free_gb)"
  [[ "$free" =~ ^[0-9]+$ ]] || return 0
  size="$(vm_disk_kb)"
  if [[ -n "$DG_LAST" ]] && (( size > DG_LAST + 65536 )); then grew=1; fi   # +64 MB since the last round
  DG_LAST="$size"
  (( free < ${BOTTLE_DISK_LOW_GB:-10} )) || return 0
  now="$(date +%s)"
  if (( free < ${BOTTLE_DISK_STOP_GB:-3} && grew )) && [[ "$1" == download ]]; then
    echo "$(date '+%F %T') the Mac has ${free} GB free and a Steam download is filling the VM's disk: stopping Steam"
    steam_stop >/dev/null 2>&1 || true
    vm_notice 1 60 "Steam stopped: your Mac is almost full" "Only ${free} GB left, and Steam was downloading onto the VM's disk. Free up space on the Mac, then Bottle > Restart Steam. Games in a game folder (Bottle > Add a Game Folder) don't fill the VM's disk."
    DG_WARNED="$now"
    return 0
  fi
  (( now - DG_WARNED >= 900 )) || return 0
  DG_WARNED="$now"
  vsh_for 120 sudo -n fstrim / >/dev/null 2>&1 || true   # space deleted files freed: back to the Mac now
  free="$(mac_free_gb)"
  (( free < ${BOTTLE_DISK_LOW_GB:-10} )) || return 0
  echo "$(date '+%F %T') the Mac has ${free} GB free"
  vm_notice 1 30 "Your Mac has ${free} GB free" "Games on the VM's disk use the Mac's space, and Steam can't see that limit there. Install games to a game folder (Bottle > Show Game Folders) or free up space."
}

# ---- the first launch on a Mac: Portalistic's Linux system (bottle setup) ----
# A Mac without the VM gets Portalistic's ready-made Linux image (host/build-image.sh made it;
# host/image.env says where it is, how big, and its checksum). Lima makes the VM from it; then the
# VM starts as it always does, and its first start brings it up to this kit (for its new user)
# and installs Steam. The VM: its share of the Mac's memory (memory_suggested_gb: 2 GB on a 4 GB
# Mac, 8 GB on a 16 GB one), its performance cores, a
# 200 GB disk that takes Mac space only as it fills, no Mac folders shared but the game folder
# ~/Games/Portalistic (bottle library). Downloads resume where they stopped.
#   bottle setup [IMAGE]   IMAGE: a local image file instead of the download (development)
IMAGE_ENV="$KIT_DIR/host/image.env"
mac_perf_cores() {
  local n all
  n="$(sysctl -n hw.perflevel0.physicalcpu 2>/dev/null || sysctl -n hw.physicalcpu 2>/dev/null || echo 4)"
  all="$(sysctl -n hw.ncpu 2>/dev/null || echo "$n")"
  (( n < 4 )) && n=4
  (( n > all )) && n=$all   # (never more than the Mac has)
  echo "$n"
}
# A file from the image's release, with its progress every few seconds: $1 = URL, $2 = file,
# $3/$4 = bytes before this file / all bytes (for the percentage of the whole download).
setup_fetch() {
  local url="$1" out="$2" before="$3" total="$4" p have
  curl -fL --retry 5 --retry-delay 3 --connect-timeout 20 -C - -s -S -o "$out" "$url" &
  p=$!
  while kill -0 "$p" 2>/dev/null; do
    sleep 3
    have=$(( before + $(stat -f %z "$out" 2>/dev/null || echo 0) ))
    printf '  %s of %s GB (%d%%)\n' "$(awk -v b="$have" 'BEGIN {printf "%.1f", b / 1e9}')" \
      "$(awk -v b="$total" 'BEGIN {printf "%.1f", b / 1e9}')" $(( have * 100 / (total > 0 ? total : 1) ))
  done
  wait "$p"
}
cmd_setup() {
  local src="${1:-}" dl="$HOME/.portalistic/download" f part n before=0 sha yaml mem cpus
  command -v limactl >/dev/null || die "Lima isn't here (the app carries it; in a kit: host/setup-host.sh)."
  if limactl list -q 2>/dev/null | grep -qx "$VM_NAME"; then
    info "Portalistic is already set up."
    cmd_up
    return
  fi
  [[ -f "$IMAGE_ENV" ]] || die "This copy of Portalistic doesn't say where its Linux system is (host/image.env)."
  # the VM gets 2 GB at least, and macOS keeps as much (memory_suggested_gb)
  (( $(mac_memory_gb) >= MAC_MEMORY_MIN_GB )) \
    || die "Portalistic needs a Mac with ${MAC_MEMORY_MIN_GB} GB of memory or more; this one has $(mac_memory_gb) GB."
  # krunkit runs the VM with macOS's Hypervisor, which a Mac that is itself a virtual machine doesn't offer
  [[ "$(sysctl -n kern.hv_support 2>/dev/null)" != 0 ]] \
    || die "This Mac can't run virtual machines: macOS's Hypervisor isn't available here, as happens when macOS itself runs in a virtual machine. Portalistic runs Steam in one."

  # shellcheck disable=SC1090
  . "$IMAGE_ENV"
  mkdir -p "$dl"
  f="$dl/$PORTALISTIC_IMAGE_FILE"
  if [[ -n "$src" ]]; then
    [[ -f "$src" ]] || die "No image at $src"
    info "Using the image $src…"
    rm -f "$f"
    cp -c "$src" "$f" 2>/dev/null || cp "$src" "$f"
  elif [[ "$(stat -f %z "$f" 2>/dev/null || echo 0)" != "$PORTALISTIC_IMAGE_SIZE" ]]; then
    [[ -n "${PORTALISTIC_IMAGE_URL:-}" ]] || die "This copy of Portalistic has no download address for its Linux system."
    (( $(mac_free_gb) * 1000000000 > PORTALISTIC_IMAGE_SIZE * 3 + 10000000000 )) \
      || die "Portalistic needs about $(( PORTALISTIC_IMAGE_SIZE * 3 / 1000000000 + 10 )) GB free on this Mac to set up; it has $(mac_free_gb) GB."
    info "Downloading Portalistic's Linux system ($(awk -v b="$PORTALISTIC_IMAGE_SIZE" 'BEGIN {printf "%.1f", b / 1e9}') GB)…"
    if [[ -n "${PORTALISTIC_IMAGE_PARTS:-}" ]]; then
      for part in $PORTALISTIC_IMAGE_PARTS; do
        setup_fetch "$PORTALISTIC_IMAGE_URL/$part" "$dl/$part" "$before" "$PORTALISTIC_IMAGE_SIZE" \
          || die "The download stopped (network?). Try again: it carries on where it stopped."
        before=$(( before + $(stat -f %z "$dl/$part") ))
      done
      info "Putting the pieces together…"
      # shellcheck disable=SC2086
      ( cd "$dl" && cat $PORTALISTIC_IMAGE_PARTS > "$f.joining" ) && mv -f "$f.joining" "$f"
      for part in $PORTALISTIC_IMAGE_PARTS; do rm -f "$dl/$part"; done
    else
      setup_fetch "$PORTALISTIC_IMAGE_URL/$PORTALISTIC_IMAGE_FILE" "$f" 0 "$PORTALISTIC_IMAGE_SIZE" \
        || die "The download stopped (network?). Try again: it carries on where it stopped."
    fi
  fi
  info "Checking it…"
  sha="$(shasum -a 256 "$f" | cut -d' ' -f1)"
  if [[ -z "$src" && "$sha" != "$PORTALISTIC_IMAGE_SHA256" ]]; then
    rm -f "$f"
    die "The download came out different from what it should be (checksum); it's deleted. Try again."
  fi
  mem="${BOTTLE_SETUP_MEMORY_GB:-$(memory_suggested_gb)}"
  cpus="$(mac_perf_cores)"
  yaml="$dl/portalistic.yaml"
  cat > "$yaml" <<EOF
# Portalistic's Linux VM (bottle setup made it from Portalistic's image, version $PORTALISTIC_IMAGE_VERSION)
vmType: krunkit
images:
- location: "$f"
  arch: aarch64
  digest: "sha256:$sha"
cpus: $cpus
memory: "${mem}GiB"
disk: "200GiB"
mounts: []
user:
  name: deck
  home: /home/deck
ssh:
  loadDotSSHPubKeys: false
containerd:
  system: false
  user: false
EOF
  info "Making the VM from it (a minute or two)…"
  limactl create --name="$VM_NAME" --tty=false "$yaml" 2>&1 | grep -v -E "level=(debug|info) msg=\"(Attempting|Using cache|Converting)" || true
  limactl list -q 2>/dev/null | grep -qx "$VM_NAME" || die "Lima couldn't make the VM (see above)."
  rm -f "$f" "$yaml"    # (the VM has its own disk now)
  # games go to a folder on this Mac (see "game folders" above)
  [[ -f "$LIB_CONF" ]] || lib_add "$LIB_MAC_DIR" --default
  info "Starting it for the first time (it sets itself up, then installs Steam)…"
  cmd_up
  info "Portalistic is set up. Sign in to Steam in the window."
}

# ---- updating the app (Portalistic.app) from its GitHub releases ----
# Each release (host/release.sh) is a tag v<version> with Portalistic-<version>.zip, and GitHub's
# releases/latest leads to the newest. The app looks at launch and once a day and offers it
# (AppDelegate+Updates.swift); installing it:
#   1. downloads the zip into ~/Library/Caches/Portalistic/update and unpacks it;
#   2. checks the new copy: a valid signature from the same developer (team) for the same app,
#      accepted by Gatekeeper (notarized), and a newer version: else nothing changes;
#   3. moves this copy aside and the new one into its place. The running app carries on from the
#      old files until it opens the new copy, which closes it. The VM, Steam and a game keep
#      running; the VM takes the new kit at its next start (or Bottle > Update the Bottle).
# Overrides (tests): BOTTLE_APP_RELEASES (the releases' address), BOTTLE_APP_LATEST (a version).
APP_RELEASES="${BOTTLE_APP_RELEASES:-https://github.com/mcstig/PorTalistic/releases}"
app_version_of() { /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null; }
app_sign_field() { codesign -dv "$1" 2>&1 | sed -n "s/^$2=//p" | head -1; }   # $2: TeamIdentifier, Identifier
# $1 newer than $2? (dotted numbers: 0.7.10 > 0.7.9)
version_newer() {
  local IFS=. i x y
  local -a a b
  read -r -a a <<<"$1"
  read -r -a b <<<"$2"
  for i in 0 1 2 3; do
    x="${a[i]:-0}"; y="${b[i]:-0}"
    x="${x%%[!0-9]*}"; y="${y%%[!0-9]*}"
    (( 10#${x:-0} > 10#${y:-0} )) && return 0
    (( 10#${x:-0} < 10#${y:-0} )) && return 1
  done
  return 1
}
# the newest release's version: where releases/latest leads (…/releases/tag/v0.7.2)
app_latest() {
  local u
  if [[ -n "${BOTTLE_APP_LATEST:-}" ]]; then echo "$BOTTLE_APP_LATEST"; return 0; fi
  u="$(curl -fsS -o /dev/null -w '%{redirect_url}' --connect-timeout 15 --max-time 30 "$APP_RELEASES/latest")" || return 1
  [[ "$u" == */tag/v* ]] || return 1
  echo "${u##*/tag/v}"
}
cmd_app_update() {
  local what="${1:-check}" cur latest dir zip new old team
  [[ -n "$APP_BUNDLE" ]] || die "Only Portalistic.app updates itself; this is the kit (host/package-app.sh makes the app)."
  case "$what" in check|install) ;; *) die "usage: bottle app-update [check|install]" ;; esac
  cur="$(app_version_of "$APP_BUNDLE")"
  latest="$(app_latest)" || die "Couldn't reach GitHub to see Portalistic's newest version."
  if [[ "$what" == check ]]; then
    if version_newer "$latest" "$cur"; then echo "update $latest $APP_RELEASES/tag/v$latest"; else echo "current $cur"; fi
    return 0
  fi
  version_newer "$latest" "$cur" || { info "Portalistic $cur is the newest version."; return 0; }
  case "$APP_BUNDLE" in
    */AppTranslocation/*)
      die "Portalistic is running from where it was downloaded. Move it to the Applications folder, open it from there, then update." ;;
  esac
  [[ -w "$APP_BUNDLE" && -w "$(dirname "$APP_BUNDLE")" ]] \
    || die "Portalistic can't replace itself in $(dirname "$APP_BUNDLE") (no permission). Download it from $APP_RELEASES/latest instead."
  team="$(app_sign_field "$APP_BUNDLE" TeamIdentifier)"
  [[ -n "$team" && "$team" != "not set" ]] || die "This copy of Portalistic isn't signed by its developer, so it can't check an update. Download it from $APP_RELEASES/latest instead."
  dir="$HOME/Library/Caches/Portalistic/update"
  rm -rf "$dir"                         # (the copy an earlier update moved aside)
  mkdir -p "$dir"
  zip="$dir/Portalistic-$latest.zip"
  info "Downloading Portalistic $latest…"
  curl -fL --retry 3 --connect-timeout 20 -s -S -o "$zip" "$APP_RELEASES/download/v$latest/Portalistic-$latest.zip" \
    || die "The download stopped (network?). Try again."
  ditto -x -k "$zip" "$dir/new" 2>/dev/null || die "The download isn't a zip Portalistic can open. Try again."
  new="$dir/new/Portalistic.app"
  [[ -d "$new" ]] || die "The download has no Portalistic.app in it."
  info "Checking it…"
  codesign --verify --deep --strict "$new" 2>/dev/null || die "The new copy's signature doesn't check out. Nothing was changed."
  [[ "$(app_sign_field "$new" TeamIdentifier)" == "$team" ]] || die "The new copy isn't signed by Portalistic's developer. Nothing was changed."
  [[ "$(app_sign_field "$new" Identifier)" == "$(app_sign_field "$APP_BUNDLE" Identifier)" ]] || die "The download is a different app. Nothing was changed."
  spctl -a -t exec "$new" 2>/dev/null || die "macOS doesn't accept the new copy (it isn't notarized). Nothing was changed."
  version_newer "$(app_version_of "$new")" "$cur" || die "The download isn't newer than this copy ($cur). Nothing was changed."
  info "Replacing Portalistic $cur with $latest…"
  old="$dir/Portalistic-$cur.app"
  mv "$APP_BUNDLE" "$old" || die "Couldn't move this copy aside. Nothing was changed."
  if ! mv "$new" "$APP_BUNDLE"; then
    mv "$old" "$APP_BUNDLE"
    die "Couldn't put the new copy in place; this one is back as it was."
  fi
  rm -rf "$zip" "$dir/new"
  info "Portalistic is now $latest."
}

# ---- Steam links and the window manager ----
# Open a steam:// link in the running Steam: the Steam program hands it to the instance that
# runs (as desktop shortcuts do). Gets to places without Steam's menus, e.g. its settings.
cmd_steam_url() {
  local url="${1:-}"
  [[ "$url" == steam://* ]] || die "usage: bottle steam-url steam://...   (e.g. steam://open/settings, steam://uninstall/<app id>)"
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if ! steam_running; then
    [[ "${BOTTLE_FROM_APP:-}" == 1 ]] && die "Steam isn't running. Choose Bottle > Restart Steam, then try again."
    die "Steam isn't running. Use: bottle steam"
  fi
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 40 bash -c '
    S="$HOME/.local/share/Steam"
    DISPLAY=:1 LD_LIBRARY_PATH="$S/lib/aarch64-linux-gnu" XDG_RUNTIME_DIR="/run/user/$(id -u)" \
      timeout 30 "$S/steamrtarm64/steam" "$1" >/dev/null 2>&1 &
    sleep 3' _ "$url" || warn "Steam didn't confirm; if nothing opened, try again in a few seconds."
  info "Sent to Steam: $url"
}

# FEX (Steam tool 3127680) runs every x86 game on Steam's ARM64 client. If Steam's record of it
# breaks (an earlier version of the kit set it to Proton), Steam won't use or reinstall it.
# This moves its record and files aside (kept as a backup) and has Steam install it afresh.
# Valve's Proton EasyAntiCheat Runtime (Steam tool 1826330): games with Easy Anti-Cheat that allow
# Proton (Rocket League, ...) need it, or the anti-cheat stops them at launch ("Launch Error").
# Steam installs it by itself on a PC; the ARM64 client here doesn't, so this asks for it, and
# steam-arm64 points Proton at it (PROTON_EAC_RUNTIME). Whether the anti-cheat accepts this
# machine is its own decision: nothing here hides the VM or the x86 translator from it.
eac_state() {  # installed / downloading / missing
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 30 bash -c '
    for A in /s/steamapps ~/.local/share/Steam/steamapps; do
      m="$A/appmanifest_1826330.acf"; [ -f "$m" ] || continue
      if grep -Eq "\"StateFlags\"[[:space:]]+\"4\"" "$m" \
         && [ -n "$(find "$A/common/Proton EasyAntiCheat Runtime" -name "easyanticheat*.so" 2>/dev/null | head -1)" ]; then
        echo installed
      else
        echo downloading
      fi
      exit 0
    done
    echo missing' 2>/dev/null | tail -n 1
}

cmd_anticheat() {
  local st i
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    die "A game is running. Quit it first (this restarts Steam)."
  fi
  # The VM's Steam launcher has to know about the runtime: that comes with bottle update.
  if ! vsh_for 30 grep -q PROTON_EAC_RUNTIME /usr/local/bin/steam-arm64 2>/dev/null; then
    info "Bringing the VM up to date first…"
    cmd_update
  fi
  st="$(eac_state)"
  if [[ "$st" != installed ]]; then
    steam_running || steam_start "$debug"
    info "Waiting for Steam…"
    for i in $(seq 1 24); do
      vsh_for 10 bash -c 'pgrep -f "[s]teamwebhelper" >/dev/null' && break
      sleep 5
    done
    sleep 15   # Steam signs in and loads the library
    info "Asking Steam to install Proton EasyAntiCheat Runtime (Valve's, about 100 MB)…"
    cmd_steam_url steam://install/1826330
    info "If Steam shows an install window for it, click Install."
    for i in $(seq 1 60); do   # up to 10 minutes
      sleep 10
      st="$(eac_state)"
      [[ "$st" == installed ]] && break
      (( i % 6 == 0 )) && info "Still waiting (${st})…"
    done
    if [[ "$st" != installed ]]; then
      log_export || true
      die "Steam didn't install it (${st}). Report it on github.com/mcstig/PorTalistic, with the logs saved above."
    fi
  fi
  info "Proton EasyAntiCheat Runtime is installed. Restarting Steam so games use it…"
  steam_stop
  steam_start "$debug"
  info "Done. Start Rocket League with anti-cheat."
}

# The app's Library: bottle-library (in the VM) lists the installed games and gathers the covers
# Steam has cached; they come over as one tar stream into the app's cache folder.
LIBRARY_CACHE="$HOME/Library/Caches/Portalistic/library"
cmd_library() {
  case "${1:-}" in
    add)     shift; lib_add "$@"; return ;;
    remove)  shift; lib_remove "$@"; return ;;
    default) shift; lib_default_set "$@"; return ;;
    folders) lib_folders; return ;;
  esac
  local tarf n have
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  have="$(vsh_for 30 bash -c 'command -v bottle-library >/dev/null && echo yes || echo no' || true)"
  case "$have" in
    *yes*) ;;
    *no*) die "The VM doesn't have the library helper yet: Bottle > Update the Bottle (or: bottle update)" ;;
    *) die "The VM didn't answer; try again in a few seconds." ;;
  esac
  if [[ "${1:-}" != --copy ]]; then
    vsh_for 60 bottle-library
    return
  fi
  mkdir -p "${LIBRARY_CACHE%/*}"
  tarf="$(mktemp "${TMPDIR:-/tmp}/bottle-library.XXXXXX")"
  # shellcheck disable=SC2016  # runs in the VM
  if ! vsh_for 120 bash -c 'D="$(mktemp -d)"; bottle-library --export "$D" >&2 && tar -C "$D" -cf - .; rc=$?; rm -rf "$D"; exit $rc' > "$tarf"; then
    rm -f "$tarf"
    die "Couldn't read the library from the VM (see above)."
  fi
  rm -rf "$LIBRARY_CACHE.new"
  mkdir -p "$LIBRARY_CACHE.new"
  if ! tar -xf "$tarf" -C "$LIBRARY_CACHE.new" || [[ ! -f "$LIBRARY_CACHE.new/library.json" ]]; then
    rm -rf "$tarf" "$LIBRARY_CACHE.new"
    die "The library from the VM came over incomplete."
  fi
  rm -f "$tarf"
  rm -rf "$LIBRARY_CACHE.old"
  [[ -d "$LIBRARY_CACHE" ]] && mv "$LIBRARY_CACHE" "$LIBRARY_CACHE.old"
  mv "$LIBRARY_CACHE.new" "$LIBRARY_CACHE"
  rm -rf "$LIBRARY_CACHE.old"
  n="$(grep -c '"appid"' "$LIBRARY_CACHE/library.json" || true)"
  info "Library: $n games (in $LIBRARY_CACHE)"
}

# Steam's interface: Big Picture (default) or its desktop windows, kept in the VM's
# ~/.config/steamos-bottle/steam-ui; steam-arm64 starts Steam that way and the keeper
# (bottle-maximize-steam --keep) holds it there.
cmd_ui() {
  local want="${1:-}"
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if [[ -z "$want" ]]; then
    # shellcheck disable=SC2016  # runs in the VM
    vsh bash -c '[ "$(cat ~/.config/steamos-bottle/steam-ui 2>/dev/null)" = desktop ] && echo desktop || echo bigpicture'
    return
  fi
  case "$want" in
    bigpicture|big-picture) want=bigpicture ;;
    desktop) ;;
    *) die "usage: bottle ui [bigpicture|desktop]" ;;
  esac
  # shellcheck disable=SC2016  # runs in the VM
  vsh bash -c 'mkdir -p ~/.config/steamos-bottle && echo "$1" > ~/.config/steamos-bottle/steam-ui' _ "$want"
  if steam_running; then
    if [[ "$want" == bigpicture ]]; then
      cmd_steam_url steam://open/bigpicture
    else
      cmd_steam_url steam://close/bigpicture
      info "If Steam stays in Big Picture, restart it: bottle steam"
    fi
  fi
  info "Steam's interface: $want (also from Steam's next start)."
}

# Steam's interface draws with OpenGL (Chromium). The VM has OpenGL only in software (llvmpipe,
# on the VM's processors), which makes Big Picture's animations stutter. Mesa's zink runs OpenGL
# on Vulkan, which here is Venus on the Mac's GPU (presented by the bottle layer, like games).
# "on" first checks that zink works in this VM (glxinfo; glxgears shows a window for a few
# seconds), then starts Steam with it (~/.config/steamos-bottle/steam-gpu; steam-arm64 reads it).
cmd_steam_gpu() {
  local want="${1:-}" rc=0 since
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  if [[ -z "$want" ]]; then
    # shellcheck disable=SC2016  # runs in the VM
    if [[ "$(vsh bash -c 'cat ~/.config/steamos-bottle/steam-gpu 2>/dev/null')" == zink ]]; then
      info "Steam's interface: on the Mac's GPU (bottle steam-gpu off goes back)."
    else
      info "Steam's interface: on the VM's processors (bottle steam-gpu on tries the Mac's GPU)."
    fi
    return 0
  fi
  if [[ "$want" == on ]]; then
    # the VM's Steam launcher and the bottle's OpenGL shim must be this kit's: update them first
    # shellcheck disable=SC2016  # runs in the VM
    if ! vsh bash -c 'grep -q BOTTLE_STEAM_GPU_FAKE /usr/local/bin/steam-arm64 2>/dev/null && grep -qa "interface on the GPU here" /usr/local/lib64/libbottle_kopper.so 2>/dev/null && grep -qa BOTTLE_FAKE_ZINK /usr/local/lib64/libVkLayer_bottle_present.so 2>/dev/null && grep -qa "with shaders and a texture" /usr/local/bin/bottle-gltest 2>/dev/null'; then
      info "The VM needs this kit's newer Steam launcher first: updating the VM…"
      cmd_update
    fi
    info "Checking OpenGL on the Mac's GPU (zink) in the VM…"
    # As Steam's interface will be started: zink, LIBGL_KOPPER_DRI2 and the layer's stand-ins for
    # the features zink needs for OpenGL 3+ (BOTTLE_FAKE_ZINK; steam-arm64 sets all three),
    # the bottle's shim (guest/present-layer/bottle_kopper.c) preloaded into the program that
    # starts it and linked on the library path, as steam-arm64 does for Steam, and that program
    # setting LIBGL_KOPPER_DISABLE=true first, as Steam does for its web views.
    # It tries the layer's stand-ins from the fewest up and keeps the first set that gives an
    # OpenGL core profile and bottle-gltest's 3.3 core window drawn with shaders, saving it to
    # ~/.config/steamos-bottle/steam-gpu-fake for steam-arm64. Everything it sees goes to
    # steam-gpu-check.txt there (and into Save Logs).
    # shellcheck disable=SC2016  # runs in the VM
    vsh_for 300 bash -c '
      export DISPLAY=:1
      command -v glxinfo >/dev/null || { echo "  glxinfo is missing: choose Bottle > Update the Bottle first"; exit 2; }
      C=~/.config/steamos-bottle; mkdir -p "$C"; D="$C/steam-gpu-check.txt"
      echo "== $(date) bottle steam-gpu on: check" > "$D"
      now="$(glxinfo -B 2>/dev/null | sed -n "s/^OpenGL renderer string: //p")"
      echo "  now:  ${now:-no OpenGL?}"
      { echo "== the Mac GPU as Vulkan reports it (vulkaninfo)"
        command -v vulkaninfo >/dev/null || echo "(no vulkaninfo)"
        vulkaninfo 2>/dev/null | grep -E "deviceName|VK_EXT_(provoking_vertex|transform_feedback|shader_object|custom_border_color|line_rasterization|extended_dynamic_state3)[ :]|^[[:space:]]+(geometryShader|tessellationShader|depthClamp|dualSrcBlend|fillModeNonSolid|shaderClipDistance|shaderCullDistance|shaderInt64|shaderInt16|sampleRateShading|independentBlend|imageCubeArray|logicOp|multiViewport|vertexPipelineStoresAndAtomics|fragmentStoresAndAtomics|textureCompressionBC|provokingVertexLast|transformFeedback)[[:space:]]*="
      } >> "$D" 2>&1
      shim="$(mktemp -d)"; trap "rm -rf $shim" EXIT
      ln -s /usr/local/lib64/libbottle_kopper.so "$shim/libGLX_mesa.so.0"
      ln -s /usr/local/lib64/libbottle_kopper.so "$shim/libEGL_mesa.so.0"
      zink() { env LIBGL_KOPPER_DRI2=1 MESA_LOADER_DRIVER_OVERRIDE=zink BOTTLE_FAKE_ZINK="$fz" BOTTLE_PRESENT_DEBUG=1 \
                   LD_LIBRARY_PATH="$shim" LD_PRELOAD=/usr/local/lib64/libbottle_kopper.so \
                   bash -c "export LIBGL_KOPPER_DISABLE=true; exec \"\$@\"" _ "$@"; }
      fz=0
      out="$(zink timeout 30 glxinfo -B 2>&1)"
      r="$(printf "%s\n" "$out" | sed -n "s/^OpenGL renderer string: //p")"
      echo "  zink: ${r:-did not start}"
      { echo "== zink without stand-ins"; printf "%s\n" "$out"; } >> "$D"
      case "$r" in
        *zink*Venus*|*zink*Apple*) ;;   # zink on the Mac GPU (not on llvmpipe)
        *) printf "%s\n" "$out" | grep -iE "error|fail|zink|vulkan|kopper" | head -6 | sed "s/^/    /"; exit 1 ;;
      esac
      for fz in geometryShader geometryShader,depthClamp,dualSrcBlend,independentBlend,fillModeNonSolid 1; do
        echo "  the layer'"'"'s stand-ins for zink: $fz"
        echo "== stand-ins: $fz" >> "$D"
        out="$(zink timeout 30 glxinfo -B 2>&1)"
        printf "%s\n" "$out" >> "$D"
        v="$(printf "%s\n" "$out" | sed -n "s/^OpenGL core profile version string: //p")"
        echo "    OpenGL core profile: ${v:-none}"
        [ -n "$v" ] || continue
        ok=1
        # Not glxgears here: it draws GL_QUADS, which zink (believing in geometry shaders now)
        # turns into a geometry shader the Mac GPU cannot run (it crashed, Oct 9 11:37). Steam
        # draws triangles; bottle-gltest draws a textured triangle with shaders, as it does.
        if [ ! -x /usr/local/bin/bottle-gltest ]; then
          echo "    bottle-gltest isn'"'"'t in the VM (it couldn'"'"'t be built): nothing to check with"
          echo "(no bottle-gltest)" >> "$D"; ok=0
        fi
        if [ "$ok" = 1 ] && [ -x /usr/local/bin/bottle-gltest ]; then
          for t in glx egl; do
            res="$(zink timeout 20 /usr/local/bin/bottle-gltest "$t" argb core 2>&1)"
            printf "%s\n" "$res" | head -40 | sed "s/^/  gltest $t: /" >> "$D"
            rr="$(printf "%s\n" "$res" | sed -n "s/^renderer: //p")"
            rs="$(printf "%s\n" "$res" | sed -n "s/^RESULT: //p")"
            echo "    transparent window, OpenGL 3.3 core, $t: ${rs:-no result}"
            case "$t:$rs:$rr" in
              *:shows*:*zink*Venus*|*:shows*:*zink*Apple*) ;;
              glx:*) ok=0 ;;
              egl:*) echo "      (not through EGL: Big Picture may stay black if Steam draws through EGL)" ;;
            esac
          done
        fi
        if [ "$ok" = 1 ]; then
          echo "$fz" > "$C/steam-gpu-fake"
          echo "== chosen: $fz" >> "$D"
          echo "  using these stand-ins: $fz"
          exit 0
        fi
      done
      echo "== none worked" >> "$D"
      exit 1' || rc=$?
    if (( rc != 0 )); then
      log_export >/dev/null 2>&1 || true
      die "OpenGL on the Mac's GPU doesn't work in this VM yet (above); Steam stays as it is. The details are saved with the logs (Bottle > Save Logs)."
    fi
    vsh bash -c 'mkdir -p ~/.config/steamos-bottle && echo zink > ~/.config/steamos-bottle/steam-gpu'
    # from here on Ctrl-C puts it back (Steam isn't left on a mode that wasn't checked)
    trap 'steam_gpu_back "Stopped before the check finished."' INT
    info "Restarting Steam with its interface on the Mac's GPU…"
  elif [[ "$want" == off ]]; then
    vsh bash -c 'rm -f ~/.config/steamos-bottle/steam-gpu'
    info "Restarting Steam with its interface on the VM's processors…"
  else
    die "usage: bottle steam-gpu [on|off]"
  fi
  desktop_start >/dev/null
  steam_stop
  since="$(vsh date '+%Y-%m-%d %H:%M:%S')"
  steam_start "$debug"
  [[ "$want" == on ]] || { info "Done."; return 0; }
  # Big Picture must really show: else straight back, keeping the attempt's log.
  info "Checking that Big Picture shows on the Mac's GPU. Leave this running: the screen can stay"
  info "black for up to a minute, and if it doesn't work Steam goes back as it was by itself."
  rc=0
  steam_screen_shows "$since" || rc=$?
  trap - INT
  case "$rc" in
    0) ;;
    3) steam_gpu_back "Steam's interface couldn't start OpenGL on the Mac's GPU." ;;
    *) steam_gpu_back "Big Picture didn't show on the Mac's GPU." ;;
  esac
  local renderer
  renderer="$(steam_ui_renderer "$since")"
  case "$renderer" in
    *zink*|*Venus*|*Apple*)
      info "Done: Big Picture draws on the Mac's GPU ($renderer)." ;;
    "")
      info "Done: Big Picture shows with its interface on the Mac's GPU." ;;
    *)
      warn "Big Picture shows, but Steam's web views report $renderer, which is the VM's processors."
      info "It may not be smoother. Steam's log is kept in the VM: Bottle > Save Logs." ;;
  esac
  info "Back to the VM's processors any time: bottle steam-gpu off"
}

# Steam back on the VM's processors after a GPU attempt that didn't work ($1 says why), keeping
# that attempt's log for Save Logs.
steam_gpu_back() {
  trap - INT
  # a check still running (Ctrl-C during it): end it, its ssh (which ends the check in the VM)
  # and its timer (which would otherwise fire later at process numbers that may be reused)
  if [[ -n "${VSH_FOR_PID:-}" ]]; then
    pkill -P "$VSH_FOR_PID" 2>/dev/null || true
    kill "$VSH_FOR_PID" 2>/dev/null || true
    if [[ -n "${VSH_FOR_TIMER:-}" ]]; then
      pkill -P "$VSH_FOR_TIMER" 2>/dev/null || true
      kill "$VSH_FOR_TIMER" 2>/dev/null || true
    fi
    VSH_FOR_PID='' VSH_FOR_TIMER=''
  fi
  warn "$1 Going back to the VM's processors…"
  vsh bash -c 'cp ~/.config/steamos-bottle/steam.log ~/.config/steamos-bottle/steam-gpu-failed.log 2>/dev/null; rm -f ~/.config/steamos-bottle/steam-gpu'
  steam_stop
  steam_start "$debug"
  log_export >/dev/null 2>&1 || true
  die "Steam is back as it was. The GPU attempt's logs are saved with the logs (Bottle > Save Logs)."
}

# Steam's Big Picture window is up and not all black (a look at the VM's screen with xwd): waits
# up to 90 s for the window, then up to 30 s for something on it. Ends early with status 3 when
# Steam's web helper can't get OpenGL (its log says so twice after $1, Steam's start time; it
# retries every 10 s, so this takes about 20 s). No xwd: can't tell (yes).
steam_screen_shows() {
  # shellcheck disable=SC2016  # runs in the VM
  vsh_for 200 bash -c '
    export DISPLAY=:1
    since="$1"; W=~/.local/share/Steam/logs/webhelper.txt
    gl_failed() {
      [ -f "$W" ] || return 1
      [ "$(awk -v s="$since" "substr(\$0, 2, 19) >= s && /failed to initialize GL thread/" "$W" | wc -l)" -ge 2 ]
    }
    # What Steam and its web helper run with (settings, OpenGL libraries, the shim log), into
    # steam-gpu-diag.txt for Save Logs; the main points here.
    snapshot() {
      D=~/.config/steamos-bottle/steam-gpu-diag.txt
      { echo "== $(date) $1"
        for p in $(pgrep -x steam) $(pgrep -x steamwebhelper); do
          t="$(tr "\0" " " < /proc/$p/cmdline 2>/dev/null | grep -o -- "--type=[a-z-]*" | head -1)"
          echo "-- $(cat /proc/$p/comm 2>/dev/null) $p ${t:-(main)}"
          tr "\0" "\n" < /proc/$p/environ 2>/dev/null \
            | grep -E "^(LD_LIBRARY_PATH|LD_PRELOAD|MESA_|LIBGL_|__GLX|__EGL|SDL_|GALLIUM|BOTTLE_)" | sed "s/^/   env /"
          grep -oE "/[^ ]*(libGL|libEGL|libOpenGL|libgallium|bottle_kopper|SDL)[^ ]*" /proc/$p/maps 2>/dev/null \
            | sort -u | sed "s/^/   lib /"
        done
        echo "-- kopper.log"; tail -30 ~/.cache/steamos-bottle/kopper.log 2>/dev/null
      } > "$D" 2>&1
      m="$(pgrep -x steamwebhelper | while read -r p; do
             tr "\0" " " < /proc/$p/cmdline 2>/dev/null | grep -q -- "--type=" || { echo "$p"; break; }; done)"
      if [ -n "$m" ]; then
        k="$(tr "\0" "\n" < /proc/$m/environ 2>/dev/null | sed -n "s/^LIBGL_KOPPER_DISABLE=//p")"
        z="$(tr "\0" "\n" < /proc/$m/environ 2>/dev/null | sed -n "s/^MESA_LOADER_DRIVER_OVERRIDE=//p")"
        echo "  Steam web helper runs with LIBGL_KOPPER_DISABLE=${k:-unset}, MESA_LOADER_DRIVER_OVERRIDE=${z:-unset}"
        grep -q bottle_kopper /proc/$m/maps 2>/dev/null && echo "  the shim is loaded in it" || echo "  the shim is not loaded in it"
      else
        echo "  (the Steam web helper was not running at that moment)"
      fi
      n="$(grep -c "starts steamwebhelper" ~/.cache/steamos-bottle/kopper.log 2>/dev/null)"
      echo "  the shim saw Steam start its web helper ${n:-0} times (kopper.log)"
    }
    command -v xwd >/dev/null || exit 0
    for _ in $(seq 1 90); do
      gl_failed && { snapshot "web helper: no OpenGL"; exit 3; }
      wmctrl -l 2>/dev/null | grep -q "Steam Big Picture Mode$" && break
      sleep 1
    done
    for _ in $(seq 1 15); do
      sleep 2
      gl_failed && { snapshot "web helper: no OpenGL"; exit 3; }
      xwd -root -silent 2>/dev/null | python3 -c "
import sys
d = sys.stdin.buffer.read()
if len(d) < 100: sys.exit(1)
hdr = int.from_bytes(d[0:4], \"big\"); w = int.from_bytes(d[16:20], \"big\"); h = int.from_bytes(d[20:24], \"big\")
bpp = max(3, int.from_bytes(d[44:48], \"big\") // 8)
bpl = int.from_bytes(d[48:52], \"big\"); nc = int.from_bytes(d[76:80], \"big\"); px = d[hdr + nc * 12:]
lit = tot = 0
for y in range(0, h, 24):
    for x in range(0, w, 24):
        o = y * bpl + x * bpp
        if o + 3 > len(px): continue
        tot += 1; lit += (px[o] + px[o + 1] + px[o + 2]) > 24
sys.exit(0 if tot and lit * 50 > tot else 1)   # over 2% of the screen not black
" && exit 0
    done
    snapshot "Big Picture black"
    exit 1' _ "$1"
}

# What Steam's web views draw with since $1 (Steam's start time), from Steam's GPU report: e.g.
# "ANGLE (Mesa, zink Vulkan 1.3(Virtio-GPU Venus (Apple M4 Max) …)". Empty if not there yet.
steam_ui_renderer() {
  # shellcheck disable=SC2016  # runs in the VM
  vsh bash -c 'awk -v s="$1" "substr(\$0, 2, 19) >= s" ~/.local/share/Steam/logs/webhelper_gpu.txt 2>/dev/null \
    | grep -F "[ GL_RENDERER ]:" | tail -1 | sed "s/.*GL_RENDERER \]: //"' _ "$1" 2>/dev/null || true
}

# Which build of a game runs (bottle-steamplay in the VM keeps the choice; Steam applies it, and
# downloads that build, from its next start, so this restarts Steam when no game is running).
cmd_version() {
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  # (the kit's copy, so a newer one works before Steam's next start installs it in the VM)
  local sp="$KIT_DIR/guest/bottle-steamplay"
  if [[ $# -eq 0 ]]; then
    if [[ -f "$sp" ]]; then vsh python3 - status < "$sp"; else vsh bottle-steamplay status; fi
    return
  fi
  [[ $# -eq 2 && ( "$2" == linux || "$2" == windows ) ]] || die "usage: bottle version GAME linux|windows"
  if [[ -f "$sp" ]]; then vsh python3 - version "$1" "$2" < "$sp" || return 1
  else vsh bottle-steamplay version "$1" "$2" || return 1; fi
  if [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    info "A game is running: this applies at Steam's next start (Bottle > Restart Steam after you quit it)."
    return 0
  fi
  info "Restarting Steam so it takes this up…"
  steam_stop
  desktop_start >/dev/null
  steam_start 0
  awake_start
}

