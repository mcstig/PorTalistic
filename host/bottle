  steam_stop >/dev/null 2>&1 || true
  steam_start >/dev/null 2>&1 || true
  if (( n == 1 )); then
    title="Steam restarted for $names"
  else
    title="Steam restarted for $n new games"
  fi
  text="It had installed the Linux version, which can't run on this Mac. Steam now uses the Windows version, so Play works. It may download the game again."
  vm_notice 0 75 "$title" "$text"
}
