# ---- the VM's memory ----
# Everything the VM touches is memory on the Mac (krunkit's), and Linux in the VM fills free
# memory with file cache: an 18 GB VM grew to 18 GB on the Mac within minutes of an open-world
# game, next to the game's GPU memory (also in the Mac's memory). On a 36 GB Mac that pushed
# macOS into 21 GB of swap and The Witcher 3 from ~55 to ~15 fps after two minutes (Oct 9).
# A smaller VM caps that and leaves the Mac room: a third of the Mac's memory from 24 GB (8-16 GB),
# half below (2-8 GB: 2 GB on a 4 GB Mac, 4 on 8, 8 on 16). The VM's zram swap (as big as its
# memory, compressed) stretches a small VM: Steam's own client and pages take about 2.5 GB.
vm_memory_gb() { echo $(( $(limactl list --format '{{.Memory}}' "$VM_NAME" 2>/dev/null || echo 0) / 1073741824 )); }
mac_memory_gb() { echo $(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 )); }
MAC_MEMORY_MIN_GB=4
memory_suggested_gb() {
  local t s
  t="$(mac_memory_gb)"
  if (( t >= 24 )); then
    s=$(( t / 3 )); (( s > 16 )) && s=16
  else
    s=$(( t / 2 )); (( s > 8 )) && s=8
  fi
  (( s < 2 )) && s=2
  echo "$s"
}
# what macOS keeps at least, whatever the VM is given (bottle memory)
mac_memory_reserve_gb() { if (( $(mac_memory_gb) >= 16 )); then echo 6; else echo 2; fi; }

cmd_memory() {
  local want="${1:-}" cur total
  need_vm
  cur="$(vm_memory_gb)"
  total="$(mac_memory_gb)"
  if [[ -z "$want" ]]; then
    echo "The VM has ${cur} GB of this Mac's ${total} GB. Suggested for games: $(memory_suggested_gb) GB (bottle memory $(memory_suggested_gb))."
    return 0
  fi
  [[ "$want" =~ ^[0-9]+$ ]] || die "usage: bottle memory [GB]"
  (( want >= 2 )) || die "Steam needs at least 2 GB in the VM."
  (( want <= total - $(mac_memory_reserve_gb) )) || die "That leaves macOS less than $(mac_memory_reserve_gb) GB of this Mac's ${total} GB."
  if (( want == cur )); then
    info "The VM already has ${want} GB."
    return 0
  fi
  if [[ "$(vm_status)" == Running ]] \
     && [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    die "A game is running. Quit it first (this restarts the VM)."
  fi
  info "Giving the VM ${want} GB instead of ${cur} GB (it restarts: a minute or two)…"
  audio_stop
  awake_stop
  if [[ "$(vm_status)" == Running ]]; then
    steam_stop
    info "Stopping the VM…"
    vm_stop >/dev/null 2>&1 || vm_stop --force >/dev/null 2>&1 || true
  fi
  limactl edit "$VM_NAME" --memory "$want" </dev/null || die "Lima couldn't change the VM's memory (see above). Start it again with: bottle start"
  info "Starting the VM…"
  vm_start || die "The VM didn't start (see above). Try: bottle start"
  update_if_behind "then Steam starts" || true
  desktop_start >/dev/null
  steam_start "$debug"
  audio_start
  awake_start
  info "The VM now has $(vm_memory_gb) GB."
}

# ---- keep the Mac awake while Steam is busy ----
# A sleeping Mac freezes the VM, and with it a download or a game. While the VM runs, a loop
# asks it every minute what Steam is doing (bottle-busy) and holds macOS awake to match:
# a game running = no system or display sleep; a download = no system sleep (the display may
# still turn off); idle = the Mac sleeps as usual. Closing a MacBook's lid still sleeps it.
AWAKE_PIDFILE="$STATE_DIR/awake.pid"
awake_running() { [[ -f "$AWAKE_PIDFILE" ]] && kill -0 "$(cat "$AWAKE_PIDFILE" 2>/dev/null)" 2>/dev/null; }
awake_start() {  # never fails the calling command
  [[ "${BOTTLE_AWAKE:-1}" == 0 ]] && return 0
  # a watcher started before the bottle command last changed runs the old code: start it anew
  if awake_running && [[ "$KIT_DIR/host/bottle" -nt "$AWAKE_PIDFILE" ]]; then awake_stop; fi
  # one that hasn't gone round its loop for 5 minutes is stuck (Oct 10: it stopped answering
  # logs/.export-now after 21:51 and nothing restarted it): start it anew
  if awake_running && [[ -f "$STATE_DIR/awake.beat" && -z "$(find "$STATE_DIR/awake.beat" -mmin -5 2>/dev/null)" ]]; then
    echo "$(date '+%F %T') the watcher hasn't gone round for 5 minutes: restarting it" >> "$STATE_DIR/awake.log"
    awake_stop
  fi
  awake_running && return 0
  mkdir -p "$STATE_DIR"
  nohup bash "$KIT_DIR/host/bottle" _awake </dev/null >>"$STATE_DIR/awake.log" 2>&1 &
  echo $! > "$AWAKE_PIDFILE"
  disown 2>/dev/null || true
}
awake_stop() {
  if awake_running; then kill "$(cat "$AWAKE_PIDFILE")" 2>/dev/null || true; fi
  rm -f "$AWAKE_PIDFILE"
  return 0
}
# While a game runs: what bottle perf shows, every 30 s, into the kit's logs/game-perf.log
# (kept under ~4 MB: the older half goes to game-perf.log.1), so a slow or stuttering game can
# be looked into afterwards without anyone running anything. BOTTLE_PERF_LOG=0 turns it off.
# The energy mode in use (System Settings > Battery > Energy Mode). pmset's powermode: 0 Automatic,
# 1 Low Power, 2 High Power; Macs without High Power Mode have only lowpowermode (0/1).
power_now() {
  local m
  m="$(pmset -g 2>/dev/null | awk '$1 == "powermode" {print $2; exit}')"
  case "$m" in 0) echo Automatic; return 0 ;; 1) echo "Low Power"; return 0 ;; 2) echo "High Power"; return 0 ;; esac
  m="$(pmset -g 2>/dev/null | awk '$1 == "lowpowermode" {print $2; exit}')"
  case "$m" in 1) echo "Low Power" ;; 0) echo Automatic ;; *) echo "?" ;; esac
}

perf_sample() {
  [[ "${BOTTLE_PERF_LOG:-1}" == 0 ]] && return 0
  local f="$LOGS_DIR/game-perf.log" n
  mkdir -p "$LOGS_DIR" 2>/dev/null || return 0
  n="$(wc -c < "$f" 2>/dev/null || echo 0)"
  if (( n > 4000000 )); then mv -f "$f" "$f.1" 2>/dev/null || true; fi
  { echo "######## $(date '+%F %T')"; ( cmd_perf ) 2>&1; } >> "$f" 2>/dev/null || true
}

# ---- the kit's own tests in the VM (guest/tests/NAME.sh) ----
selftest_run() {  # $1 = test name; output into logs/selftest-NAME-<time>.txt
  local name="$1" out
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ && -f "$KIT_DIR/guest/tests/$name.sh" ]] || { warn "no such test: $name"; return 1; }
  mkdir -p "$LOGS_DIR"
  out="$LOGS_DIR/selftest-$name-$(date +%Y%m%d-%H%M%S).txt"
  { echo "== selftest $name, $(date)"
    # the tests folder goes into the VM afresh (binaries the test needs live next to it)
    # (macOS has no timeout(1); vsh_for can't take the archive on its input)
    COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$KIT_DIR/guest/tests" --exclude .DS_Store -czf - . | vsh bash -c \
      'rm -rf ~/.cache/steamos-bottle/tests && mkdir -p ~/.cache/steamos-bottle/tests && tar -C ~/.cache/steamos-bottle/tests -xzf -' \
      || echo "(copying the tests into the VM failed)"
    local rc=0
    vsh_for "${BOTTLE_SELFTEST_SECS:-2400}" bash -c "cd ~/.cache/steamos-bottle/tests && bash ./$name.sh" 2>&1 || rc=$?
    echo "== done $(date) (rc $rc)"
  } > "$out" 2>&1
  info "Test result: $out"
}

cmd_selftest() {
  need_vm
  [[ -n "${1:-}" ]] || { ls "$KIT_DIR/guest/tests"/*.sh 2>/dev/null | sed 's#.*/##; s#\.sh$##'; return 0; }
  selftest_run "$1"
}

# Type-checks the app's Swift code in host/swift-check/ (a copy of host/Portalistic with the
# changes to try) without building or replacing the app: whoever works on the app from outside
# (no Mac compiler there) puts the files there and a file logs/.swift-check; the verdict goes to
# logs/swift-check-<time>.txt. Nice'd, so a game running meanwhile hardly notices.
swift_check() {
  local dir="$KIT_DIR/host/swift-check" out f
  local -a srcs=()
  mkdir -p "$LOGS_DIR"
  out="$LOGS_DIR/swift-check-$(date +%Y%m%d-%H%M%S).txt"
  [[ -d "$dir" ]] || { echo "== no $dir" > "$out"; return 0; }
  while IFS= read -r -d '' f; do srcs+=("$f"); done < <(find "$dir" -name '*.swift' -print0)
  { echo "== swift check, $(date), ${#srcs[@]} files, $(swiftc --version 2>&1 | head -1)"
    if nice -n 15 swiftc -typecheck -parse-as-library -module-name Portalistic \
         -target "$(uname -m)-apple-macosx13.0" "${srcs[@]}" 2>&1; then echo "== OK"; else echo "== FAILED"; fi
  } > "$out" 2>&1
}

# Runs one of the kit's Mac-side tests (host/tests/NAME.sh) on macOS, in the background, with a
# time limit (BOTTLE_HOSTTEST_SECS, default 2400 s); the output goes to
# logs/hosttest-NAME-<time>.txt. Michael agreed (Oct 11) that whoever works on the kit from
# outside may start these through the watcher (a file logs/.host-test holding NAME), so checks
# on the Mac need no typing. Only scripts in the kit's host/tests/.
host_test_run() {
  local name="$1" out p w rc=0
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ && -f "$KIT_DIR/host/tests/$name.sh" ]] || return 1
  mkdir -p "$LOGS_DIR"
  out="$LOGS_DIR/hosttest-$name-$(date +%Y%m%d-%H%M%S).txt"
  { echo "== host test $name, $(date)"
    ( cd "$KIT_DIR/host/tests" && BOTTLE_KIT_DIR="$KIT_DIR" exec bash "./$name.sh" ) </dev/null 2>&1 &
    p=$!
    ( sleep "${BOTTLE_HOSTTEST_SECS:-2400}"; kill "$p" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
    w=$!
    wait "$p" || rc=$?
    kill "$w" 2>/dev/null || true
    echo "== done $(date) (rc $rc)"
  } > "$out" 2>&1
}

awake_loop() {
  local state last="" flags cpid="" me="$KIT_DIR/host/bottle" born t
  # (the pid file only if it's still this watcher's: bash runs this trap only once the sleep in
  # progress ends, and by then a new watcher may have written its own; Oct 12, the move to
  # ~/Documents/Projects/PORTALISTIC: the old watcher's late exit removed the new one's)
  trap '[[ -n "$cpid" ]] && kill "$cpid" 2>/dev/null; [[ "$(cat "$AWAKE_PIDFILE" 2>/dev/null)" == "$$" ]] && rm -f "$AWAKE_PIDFILE"; exit 0' TERM INT
  born="$(stat -f %m "$me" 2>/dev/null || echo 0)"
  echo "$(date '+%F %T') watching the VM (pid $$)"
  while pgrep -x krunkit >/dev/null; do
    touch "$STATE_DIR/awake.beat" 2>/dev/null || true   # alive (awake_start restarts a stuck one)
    # the bottle command changed (a kit update): carry on in the new one (same pid)
    if [[ "$(stat -f %m "$me" 2>/dev/null || echo 0)" != "$born" ]]; then
      # Only into a complete, readable new version: a copy can still be landing, or come without
      # its execute bit for a moment (Oct 10, 21:52: "Permission denied", and the watcher was gone
      # until Steam was restarted). Through bash, so the execute bit doesn't matter; if the file
      # isn't whole yet, this round goes on in the old code and the next one tries again.
      sleep 2
      if bash -n "$me" 2>/dev/null; then
        [[ -n "$cpid" ]] && { kill "$cpid" 2>/dev/null || true; }
        echo "$(date '+%F %T') the bottle command changed: the watcher restarts in it"
        touch "$AWAKE_PIDFILE" 2>/dev/null || true   # (newer than the command: awake_start keeps it)
        exec bash "$me" _awake
      fi
      echo "$(date '+%F %T') the bottle command changed but doesn't read as whole yet: trying again next round"
    fi
    # logs asked for from outside (a file logs/.export-now in the kit, e.g. by whoever is
    # helping look into a problem): saved like Bottle > Save Logs, in the background
    if [[ -f "$LOGS_DIR/.export-now" ]]; then
      rm -f "$LOGS_DIR/.export-now"
      echo "$(date '+%F %T') logs asked for: saving them to $LOGS_DIR"
      ( log_export >/dev/null 2>&1 || true ) &
    fi
    # app code to check without building it (files in host/swift-check/, a file logs/.swift-check
    # asks): the compiler's verdict lands in logs/, the app you have stays as it is
    if [[ -f "$LOGS_DIR/.swift-check" ]]; then
      rm -f "$LOGS_DIR/.swift-check"
      echo "$(date '+%F %T') app code check asked for"
      ( swift_check >/dev/null 2>&1 || true ) &
    fi
    # a Mac-side kit test asked for from outside (logs/.host-test holds its name, host/tests/)
    t="$(head -c 64 "$LOGS_DIR/.host-test" 2>/dev/null | tr -cd 'a-z0-9-' || true)"
    if [[ -n "$t" ]]; then
      rm -f "$LOGS_DIR/.host-test"
      echo "$(date '+%F %T') Mac test asked for: $t"
      ( host_test_run "$t" >/dev/null 2>&1 || true ) &
    fi
    # (with a time limit: a VM that doesn't answer mustn't stop the watcher)
    state="$(vsh_for 40 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1 || true)"
    disk_guard "$state" || true   # the Mac's free space (see disk_guard)
    # a kit test asked for from outside (logs/.selftest holds its name): not while a game runs,
    # unless the test says it may ("# (selftest: may run during a game)", e.g. a screenshot)
    # (|| true: this script stops on any failing command, and no file is the usual case; the
    # first version of this line stopped the watcher at 00:22 on Oct 11)
    t="$(head -c 64 "$LOGS_DIR/.selftest" 2>/dev/null | tr -cd 'a-z0-9-' || true)"
    if [[ -n "$t" && ( "$state" != game || -n "$(grep -l "selftest: may run during a game" "$KIT_DIR/guest/tests/$t.sh" 2>/dev/null)" ) ]]; then
      rm -f "$LOGS_DIR/.selftest"
      echo "$(date '+%F %T') test asked for: $t"
      ( selftest_run "$t" >/dev/null 2>&1 || true ) &
    fi
    case "$state" in
      game)     flags="-di" ;;
      download) flags="-i" ;;
      *)        state=idle; flags="" ;;
    esac
    if [[ "$state" != "$last" ]]; then
      [[ -n "$cpid" ]] && { kill "$cpid" 2>/dev/null || true; }
      cpid=""
      if [[ -n "$flags" ]]; then
        caffeinate "$flags" -w $$ &   # holds macOS awake until killed or this loop ends
        cpid=$!
      fi
      echo "$(date '+%F %T') Steam: $state${flags:+ (keeping the Mac awake: caffeinate $flags)}"
      # A game just ended (closed, crashed or quit by itself): save the logs into the kit's logs/
      # now, as Bottle > Save Logs does, so nobody has to remember to (the game's own
      # log is replaced at its next start). In the background: ~30 s, the watcher carries on.
      # BOTTLE_GAME_LOGS=0 turns it off.
      if [[ "$last" == game && "${BOTTLE_GAME_LOGS:-1}" != 0 ]]; then
        echo "$(date '+%F %T') the game ended: saving the logs to $LOGS_DIR"
        ( log_export >/dev/null 2>&1 || true ) &
      fi
      last="$state"
    fi
    if [[ "$state" == game ]]; then
      perf_sample
      sleep "${BOTTLE_PERF_EVERY:-30}"
    else
      sleep "${BOTTLE_AWAKE_EVERY:-60}"
    fi
  done
  [[ -n "$cpid" ]] && { kill "$cpid" 2>/dev/null || true; }
  echo "$(date '+%F %T') the VM stopped"
  rm -f "$AWAKE_PIDFILE"
}

# ---- x86 memory ordering in hardware (guest/tso: bottle-tso and its kernel module) ----
cmd_tso() {
  local what="${1:-status}" rc=0 f
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  case "$what" in
    status|"")
      vsh_for 60 bash -c 'if command -v bottle-tso >/dev/null; then bottle-tso status; else echo "The VM needs: bottle update"; fi'
      return 0 ;;
    on|off) ;;
    *) die "usage: bottle tso [on | off | status]" ;;
  esac
  if [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    die "A game is running. Quit it first (this restarts Steam)."
  fi
  update_if_behind "then the x86 ordering" || true
  vsh_for 30 bash -c 'command -v bottle-tso >/dev/null' || cmd_update --now
  # Steam goes down for the test (it switches the ordering off and on) and comes back with the
  # result: games then get FEX_TSOENABLED=0 or not (steam-arm64 asks bottle-tso check).
  steam_stop
  mkdir -p "$LOGS_DIR"
  f="$LOGS_DIR/tso-$(date +%Y%m%d-%H%M%S).log"
  if [[ "$what" == on ]]; then
    info "Testing x86 memory ordering in hardware (the first time it builds a small kernel module: a minute or two)…"
    vsh sudo /usr/local/bin/bottle-tso on 2>&1 | tee "$f" || rc=$?
    vsh_for 30 bash -c 'cat /var/lib/steamos-bottle/tso.log 2>/dev/null' >> "$f" 2>/dev/null || true
  else
    vsh sudo /usr/local/bin/bottle-tso off 2>&1 | tee "$f" || rc=$?
  fi
  steam_start "$debug"
  if [[ "$what" == on ]]; then
    if (( rc == 0 )); then
      info "On. Games started from now on run their x86 code without FEX's own ordering. (Log: logs/${f##*/})"
    else
      warn "It stays off; FEX keeps its own ordering. The details are in logs/${f##*/}."
    fi
  fi
  return 0
}

# ---- a frame-rate cap for games ----
# A game that keeps the Mac's GPU fully busy makes a MacBook hot within a couple of minutes, and
# macOS then slows the chip down: The Witcher 3 went from 57 to 33 fps, with hitches, each time
# (Oct 9). A cap a little under what the game reaches at first keeps the GPU from running flat
# out: steadier frames, a cooler Mac. It's DXVK's own limiter (DXVK_FRAME_RATE, in steam.env),
# so it covers every Direct3D 8-11 game; one game alone: DXVK_FRAME_RATE=45 %command% in its
# Steam launch options.
cmd_fps() {
  local v="${1:-}"
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  case "$v" in
    "")
      # shellcheck disable=SC2016  # runs in the VM
      vsh_for 30 bash -c 'v=$(sed -n "s/^DXVK_FRAME_RATE=//p" ~/.config/steamos-bottle/steam.env 2>/dev/null | tr -d "'"'"'\""); if [ -n "$v" ]; then echo "Games are capped at $v fps (bottle fps off removes it)."; else echo "No frame-rate cap (bottle fps 45 sets one)."; fi'
      return 0 ;;
    off|0) cmd_env -u DXVK_FRAME_RATE >/dev/null ;;
    *)
      [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 20 && v <= 240 )) || die "usage: bottle fps [N | off]   (N from 20 to 240)"
      cmd_env "DXVK_FRAME_RATE=$v" >/dev/null ;;
  esac
  if [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    info "Saved. It applies from the next game start after Steam restarts (Bottle > Restart Steam once the game is closed)."
    return 0
  fi
  update_if_behind "then Steam restarts" || true
  steam_stop
  steam_start "$debug"
  if [[ "$v" == off || "$v" == 0 ]]; then info "No frame-rate cap now."; else info "Games are capped at $v fps."; fi
}

cmd_audio() {
  case "${1:-status}" in
    on)  audio_start ;;
    off) audio_stop; info "Sound on the Mac is off (bottle audio on to turn it back on)." ;;
    status)
      if [[ -n "$(audio_pid)" ]]; then
        echo "Sound on the Mac: on; $(tail -n 1 "$STATE_DIR/audio.log" 2>/dev/null | cut -c10-)"
      else
        echo "Sound on the Mac: off (bottle audio on)"
      fi ;;
    *) die "usage: bottle audio [on | off | status]" ;;
  esac
}

cmd_gputrace() {
  local stamp dir trace sch n=0 xpath
  xcrun --find xctrace >/dev/null 2>&1 || die "needs Xcode's xctrace (Xcode, not just the command line tools)"
  pgrep -n krunkit >/dev/null || die "The VM isn't running."
  stamp="$(date +%H%M%S)"
  dir="$HOME/Desktop/bottle-gputrace-$stamp"
  trace="$dir/gpu.trace"
  mkdir -p "$dir"
  info "Recording 3 s of GPU activity: keep playing (moving) in the game…"
  # --no-prompt skips the "all processes" privacy question; older xctrace lacks it, so retry without.
  if ! xcrun xctrace record --template 'Metal System Trace' --all-processes --time-limit 3s \
        --output "$trace" --no-prompt >"$dir/record.log" 2>&1 \
     && ! { rm -rf "$trace"; xcrun xctrace record --template 'Metal System Trace' --all-processes \
              --time-limit 3s --output "$trace" >>"$dir/record.log" 2>&1; }; then
    cat "$dir/record.log" >&2
    echo "Templates on this Mac:" >&2
    xcrun xctrace list templates 2>/dev/null | grep -iE 'metal|gpu|game' >&2 || true
    die "recording failed (see above)"
  fi
  info "Exporting the GPU tables (a minute or two)…"
  xcrun xctrace export --input "$trace" --toc >"$dir/toc.xml" 2>>"$dir/record.log" || die "export failed: $dir/record.log"
  # Every table whose schema mentions the GPU, Metal or encoders / command buffers.
  for sch in $(grep -oE 'schema="[^"]+"' "$dir/toc.xml" | cut -d'"' -f2 | sort -u \
               | grep -iE 'gpu|metal|encoder|command-buffer|display'); do
    xpath="/trace-toc/run[@number=\"1\"]/data/table[@schema=\"$sch\"]"
    if xcrun xctrace export --input "$trace" --xpath "$xpath" >"$dir/$sch.xml" 2>>"$dir/record.log"; then
      n=$((n + 1))
    else
      rm -f "$dir/$sch.xml"
    fi
  done
  (cd "$HOME/Desktop" && zip -qr "bottle-gputrace-$stamp.zip" "bottle-gputrace-$stamp" -x "*/gpu.trace/*")
  # a copy in the kit's logs/, where Claude reads it without an attachment
  mkdir -p "$LOGS_DIR" && cp -f "$HOME/Desktop/bottle-gputrace-$stamp.zip" "$LOGS_DIR/" 2>/dev/null || true
  # what else was running on the GPU and how hot the Mac was, for the same moment
  { echo "== $(date '+%F %T')"; ( cmd_perf ) 2>&1; } > "$LOGS_DIR/bottle-gputrace-$stamp-perf.txt" 2>/dev/null || true
  info "$n tables exported: ~/Desktop/bottle-gputrace-$stamp.zip (a copy is in the logs folder)"
  echo "(The full recording is $trace; it opens in Instruments.)"
}

cmd_env_mac() {
  local op=list key="" val="" line
  case "${1:-}" in
    "") ;;
    -u|--unset) op="unset"; key="${2:-}" ;;
    *=*) op="set"; key="${1%%=*}"; val="${1#*=}" ;;
    *) die "usage: bottle env --mac [KEY=VALUE | -u KEY]" ;;
  esac
  if [[ "$op" != list && ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then die "not a valid setting name: '$key'"; fi
  mkdir -p "$STATE_DIR"; touch "$HOST_ENV"
  if [[ "$op" != list ]]; then
    { grep -v "^$key=" "$HOST_ENV" || true; } > "$HOST_ENV.new"
    [[ "$op" == set ]] && printf '%s=%s\n' "$key" "$val" >> "$HOST_ENV.new"
    mv -f "$HOST_ENV.new" "$HOST_ENV"
  fi
  echo "Settings for the VM on the Mac ($HOST_ENV):"
  if grep -qE '^[A-Za-z_]' "$HOST_ENV"; then sed 's/^/  /' "$HOST_ENV"; else echo "  (none)"; fi
  [[ "$op" == list ]] || info "Applies the next time the VM starts: bottle restart (add --debug for logs)"
}

cmd_env() {
  local op=list key="" val=""
  if [[ "${1:-}" == --mac ]]; then shift; cmd_env_mac "$@"; return; fi
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  case "${1:-}" in
    "") ;;
    -u|--unset) op="unset"; key="${2:-}" ;;
    *=*) op="set"; key="${1%%=*}"; val="${1#*=}" ;;
    *) die "usage: bottle env [KEY=VALUE | -u KEY]" ;;
  esac
  if [[ "$op" != list && ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then die "not a valid setting name: '$key'"; fi
  # shellcheck disable=SC2016  # runs in the VM
  vsh bash -c '
    F=~/.config/steamos-bottle/steam.env; mkdir -p "${F%/*}"; touch "$F"
    op=$1 key=$2 val=$3
    if [ "$op" != list ]; then
      grep -v "^$key=" "$F" > "$F.new" || true
      [ "$op" = set ] && printf "%s=%s\n" "$key" "${val@Q}" >> "$F.new"  # @Q: quoted for sourcing
      mv -f "$F.new" "$F"
    fi
    echo "Settings for Steam and games (~/.config/steamos-bottle/steam.env):"
    grep -vE "^[[:space:]]*(#|$)" "$F" | sed "s/^/  /" || echo "  (none)"' _ "$op" "$key" "$val"
  [[ "$op" == list ]] || info "Applies the next time Steam starts: bottle steam (add --debug for logs)"
}

cmd_update() {
  local avail
  need_vm
  [[ "$(vm_status)" == Running ]] || vm_start
  # A full disk makes everything below fail halfway (and Steam crash): say so first.
  avail="$(vsh_for 60 df -Pk / 2>/dev/null | awk 'NR == 2 {print int($4 / 1048576)}')"
  if [[ -n "$avail" ]] && (( avail < 2 )); then
    die "The VM's disk is full (${avail} GB free). Make room first: bottle disk grow   (or see: bottle disk)"
  fi
  # The update restarts the screen server, which unplugs the virtual controllers: a running
  # game can freeze on that (Devil May Cry 5 does). So not while a game runs.
  if [[ "${1:-}" != --now ]] && [[ "$(vsh_for 30 bash -c 'command -v bottle-busy >/dev/null && bottle-busy || echo idle' 2>/dev/null | tail -n 1)" == game ]]; then
    die "A game is running. Quit it first (updating would unplug its controller), or: bottle update --now"
  fi
  info "Copying the kit into the VM…"
  # COPYFILE_DISABLE: no macOS ._ metadata files in the archive.
  COPYFILE_DISABLE=1 tar -C "$KIT_DIR" --exclude __pycache__ --exclude .DS_Store -czf - guest \
    | vsh bash -c 'K=~/.cache/steamos-bottle/kit; rm -rf "$K"; mkdir -p "$K"; tar --warning=no-unknown-keyword -xzf - -C "$K"'
  info "Updating the VM (asks nothing; takes a minute or two)…"
  vsh bash -c 'sudo bash ~/.cache/steamos-bottle/kit/guest/update-guest.sh'
  # what's installed now (update_if_behind compares with it)
  vsh bash -c 'mkdir -p ~/.cache/steamos-bottle && cat > ~/.cache/steamos-bottle/kit-stamp' <<<"$(kit_stamp)" || true
  if [[ "${BOTTLE_FROM_APP:-}" == 1 ]]; then
    info "Done. If Steam's launcher changed, choose Bottle > Restart Steam."
  else
    info "Done. Restart Steam to pick up launcher changes: bottle steam"
  fi
}

# The VM's own programs, built once in this VM for the kit (guest/prebuild.sh,
# guest/build-recipes.sh): guest/prebuilt/aarch64 and its MANIFEST (which sources each came from).
cmd_prebuild() {
  local new="$KIT_DIR/guest/prebuilt/aarch64.new" dest="$KIT_DIR/guest/prebuilt/aarch64"
  need_vm
  [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
  info "Building the VM's programs in the VM (build tools install the first time)…"
  # shellcheck disable=SC2016  # runs in the VM
  COPYFILE_DISABLE=1 tar -C "$KIT_DIR" --exclude __pycache__ --exclude .DS_Store --exclude guest/tests \
      --exclude guest/prebuilt -czf - guest \
    | vsh bash -c 'rm -rf /tmp/pb-kit && mkdir -p /tmp/pb-kit && tar -xzf - -C /tmp/pb-kit && sudo -n bash /tmp/pb-kit/guest/prebuild.sh /tmp/pb-out' \
    || die "The build in the VM failed (see above)."
  rm -rf "$new"
  mkdir -p "$new"
  # shellcheck disable=SC2016
  vsh bash -c 'tar -C /tmp/pb-out -cf - .; s=$?; sudo -n rm -rf /tmp/pb-kit /tmp/pb-out; exit $s' | tar -C "$new" -xf - \
    || die "Couldn't copy the builds out of the VM."
  [[ -s "$new/MANIFEST" ]] || die "The VM made no builds."
  rm -rf "$dest"
  mv "$new" "$dest"
  info "Ready-made builds in guest/prebuilt/aarch64 ($(du -sh "$dest" | cut -f1)): $(awk '{printf "%s ", $1}' "$dest/MANIFEST")"
}

cmd_install() {
  local bin
  if command -v brew >/dev/null; then bin="$(brew --prefix)/bin"; else bin="$HOME/.local/bin"; fi
  mkdir -p "$bin"
  ln -sfn "$KIT_DIR/host/bottle" "$bin/bottle"
  chmod +x "$KIT_DIR/host/bottle" "$KIT_DIR/host/"*.sh 2>/dev/null || true
  info "Installed: $bin/bottle -> $KIT_DIR/host/bottle"
  case ":$PATH:" in *":$bin:"*) ;; *) warn "$bin isn't on your PATH; add it, or run $bin/bottle" ;; esac
  echo "Keep the kit folder where it is ($KIT_DIR): the command runs from it."
}

debug=0
cmd="${1:-help}"
[[ $# -gt 0 ]] && shift
for a in "$@"; do [[ "$a" == --debug ]] && debug=1; done

case "$cmd" in
  start)        cmd_window ;;
  stop)
    need_vm
    audio_stop
    awake_stop
    if [[ "$(vm_status)" == Running ]]; then steam_stop; info "Stopping the VM…"; vm_stop; fi
    info "Stopped."
    ;;
  restart)
    need_vm
    if [[ "$(vm_status)" == Running ]]; then steam_stop; vm_stop; fi
    cmd_window
    ;;
  steam)
    need_vm
    [[ "$(vm_status)" == Running ]] || die "The VM isn't running. Use: bottle start"
    # Steam (and a game still open, even just its launcher or an error box) goes first, so the
    # update isn't put off for a "running" game this restart is about to quit anyway (Oct 10,
    # 23:53: The Witcher 3's launcher stayed open and the vkd3d-proton update waited)
    steam_stop
    update_if_behind "then Steam starts" || true
    desktop_start >/dev/null
    steam_start "$debug"
    awake_start
    ;;
  vnc)          need_vm; desktop_start >/dev/null; audio_start; awake_start; vnc_open "$@" ;;
  audio)        cmd_audio "$@" ;;
  window|app)   cmd_window ;;
  xcode)        cmd_xcode ;;
  _up)          cmd_up ;;            # the app: start whatever isn't running
  _rebuild)     cmd_rebuild_app ;;   # the app: build its new version and reopen it
  _lib-mounts)  lib_mounts_apply ;;  # setup-host.sh: the game folders, before Lima starts the VM
  disk)         cmd_disk "$@" ;;
  memory)       cmd_memory "$@" ;;
  steam-url)    cmd_steam_url "$@" ;;
  settings)     cmd_steam_url steam://open/settings ;;
  wm)           cmd_wm "$@" ;;
  repair-fex)   cmd_repair_fex "$@" ;;
  anticheat)    cmd_anticheat ;;
  library)      cmd_library "$@" ;;
  ui)           cmd_ui "$@" ;;
  steam-gpu)    cmd_steam_gpu "$@" ;;
  play)         cmd_play "$@" ;;
  version)      cmd_version "$@" ;;
  _awake)       awake_loop ;;   # the background keep-awake loop (awake_start)
  status)       cmd_status ;;
  log)          cmd_log "$@" ;;
  perf)         cmd_perf ;;
  tso)          cmd_tso "$@" ;;
  fps)          cmd_fps "$@" ;;
  env)          cmd_env "$@" ;;
  gputrace)     cmd_gputrace ;;
  update)       cmd_update "$@" ;;
  shell)        need_vm; exec limactl shell "$VM_NAME" ;;
  selftest)     cmd_selftest "$@" ;;
  install)      cmd_install ;;
  prebuild)     cmd_prebuild ;;
  setup)        cmd_setup "$@" ;;
  app-update)   cmd_app_update "$@" ;;
  kosmickrisp)  exec "$KIT_DIR/host/kosmickrisp.sh" "$@" ;;
  help|-h|--help) sed -n '2,/^# Written/p' "$src" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (bottle help)" ;;
esac
