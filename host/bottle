# ---- the first launch on a Mac: Portalistic's Linux system (bottle setup) ----
# A Mac without the VM gets Portalistic's ready-made Linux image (host/build-image.sh made it;
# host/image.env says where it is, how big, and its checksum). Lima makes the VM from it; then the
# VM starts as it always does, and its first start brings it up to this kit (for its new user)
# and installs Steam. The VM: its share of the Mac's memory (memory_suggested_gb: 4 GB on an 8 GB
# Mac, 8 GB on a 16 GB one), its performance cores, a
# 20 GB disk (Linux, Steam, Proton) that takes Mac space only as it fills, no Mac folders shared but the game folder
# ~/Games/Portalistic (bottle library). Downloads resume where they stopped.
#   bottle setup [IMAGE]   IMAGE: a local image file instead of the download (development)
IMAGE_ENV="$KIT_DIR/host/image.env"
VM_DISK_GB="${BOTTLE_VM_DISK_GB:-25}"   # Linux, Steam, Proton and its runtimes (games go in game folders; see vm_disk_guard); 20 until Oct 23; it grows when low
mac_perf_cores() {
  local n all
  n="$(sysctl -n hw.perflevel0.physicalcpu 2>/dev/null || sysctl -n hw.physicalcpu 2>/dev/null || echo 4)"
  all="$(sysctl -n hw.ncpu 2>/dev/null || echo "$n")"
  (( n < 4 )) && n=4
  (( n > all )) && n=$all   # (never more than the Mac has)
  echo "$n"
}
# A file from the image's release, with its progress every few seconds: $1 = URL, $2 = file,
# $3/$4 = bytes before this file / all bytes (for the percentage of the whole download).
setup_fetch() {
  local url="$1" out="$2" before="$3" total="$4" p have
  curl -fL --retry 5 --retry-delay 3 --connect-timeout 20 -C - -s -S -o "$out" "$url" &
  p=$!
  while kill -0 "$p" 2>/dev/null; do
    sleep 3
    have=$(( before + $(stat -f %z "$out" 2>/dev/null || echo 0) ))
    printf '  %s of %s GB (%d%%)\n' "$(awk -v b="$have" 'BEGIN {printf "%.1f", b / 1e9}')" \
      "$(awk -v b="$total" 'BEGIN {printf "%.1f", b / 1e9}')" $(( have * 100 / (total > 0 ? total : 1) ))
  done
  wait "$p"
}
