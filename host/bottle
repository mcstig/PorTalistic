        { [ -d "/mnt/portalistic/$pmn/steamapps" ] || [ -d "/mnt/portalistic-folders/$pmn" ]; } || continue
        grep -q "\"/mnt/portalistic/$pmn\"" "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" 2>/dev/null && continue
        printf 'libmissing\t%s\n' "$pmn"
      done
    fi
  fi
fi
