        PM_NOTICED="$PM_NOTICED $a@$b "
        echo "$(date '+%F %T') $e starts without a finished Wine prefix: telling the player"
        vm_notice 0 120 "Setting up $e for the first time" "Windows games need a one-time setup before they open. It can take several minutes, and the game starts by itself when it's done."
      fi
