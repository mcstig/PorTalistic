  libs_guard "$state" "$lines" && return 0   # (Steam just restarted for a game folder: this round is done)
  [[ "${BOTTLE_PLAYMAP:-1}" != 0 ]] || return 0
  grep -q '^pending' <<<"$lines" || return 0
  [[ "$state" != game ]] || return 0
  up="$(grep '^playmap' <<<"$lines" | head -n 1 | cut -f2 || true)"
  [[ "$up" =~ ^[0-9]+$ ]] || return 0
