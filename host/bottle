  # is listed again after 30 minutes at the earliest (the lines above may be a round old)
  fresh="$(vsh_for 20 bash -c 'pgrep -f "[r]eaper SteamLaunch AppId=|[w]ineserver" >/dev/null 2>&1 && exit 0; bottle-steamplay pending --mark 2>/dev/null' 2>/dev/null || true)"
  while IFS=$'\t' read -r kind a b; do
    [[ "$kind" == pending && "$a" =~ ^[0-9]+$ && -n "$b" ]] || continue
    list+=("$b")
  done <<<"$fresh"
  n="${#list[@]}"
