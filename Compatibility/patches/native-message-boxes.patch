new file mode 100644
index 0000000..0f507dc
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_alert.m
@@ -0,0 +1,428 @@
+/*
+ * MACDRV Cocoa alerts, which Windows message boxes are shown as
+ *
+ * Copyright 2026 Michael Stoian
+ *
