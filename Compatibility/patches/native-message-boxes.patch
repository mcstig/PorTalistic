diff --git a/dlls/winemac.drv/msgbox.c b/dlls/winemac.drv/msgbox.c
new file mode 100644
index 0000000..a5ba88c
--- /dev/null
+++ b/dlls/winemac.drv/msgbox.c
@@ -0,0 +1,294 @@
+/*
+ * MACDRV message boxes shown as native alerts
+ *
+ * Copyright 2026 Michael Stoian
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * user32 builds every message box as a dialog, then offers it to the driver
+ * with WM_WINE_NATIVE_MSGBOX before showing it.  Taking it means showing an
+ * NSAlert with the dialog's caption, text and buttons, and answering 1; user32
+ * then keeps the dialog hidden but runs its modal loop as usual.  The button
+ * the user picks comes back as an ALERT_RESPONSE event on this thread, and is
+ * posted to the dialog as the WM_COMMAND a click on that button would have
+ * sent.  So the owner is disabled, MB_TASKMODAL is honoured and MessageBox
+ * returns exactly as it always did; only what's on screen changes.  When the
+ * dialog ends some other way (EndDialog from the program, DestroyWindow) the
+ * alert is taken down with it.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "macdrv.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+
+/* The static control holding the message: dlls/user32/resources.h. */
+#define MSGBOX_IDTEXT 0xffff
+
+/* Set by user32 on a message box whose dialog must stay hidden, and taken off
+   here if the alert can't be shown after all.  Must match dlls/user32/msgbox.c. */
+static const WCHAR native_msgbox_propW[] =
+    {'_','_','w','i','n','e','_','n','a','t','i','v','e','_','m','s','g','b','o','x',0};
+
+/* The order user32 lays message box buttons out in, left to right.  An alert
+   puts the first button it is given rightmost, as the primary action, which
+   is where macOS wants Yes and OK: to the right of No and Cancel. */
+static const UINT button_order[] =
+    { IDYES, IDNO, IDOK, IDABORT, IDRETRY, IDCANCEL, IDIGNORE, IDTRYAGAIN, IDCONTINUE };
+
+struct native_msgbox
+{
+    struct list     entry;
+    HWND            hwnd;
+    macdrv_alert    alert;
+};
+
+static struct list native_msgboxes = LIST_INIT(native_msgboxes);
+static pthread_mutex_t native_msgboxes_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+
+/* "&Yes" as "Yes", and "&&" as "&".  Chinese and Japanese translations put the
+   mnemonic after the label instead, as a trailing "(&Y)"; that goes entirely. */
+static INT strip_mnemonic(WCHAR *text, INT len)
+{
+    INT i, j;
+
+    for (i = 0; i + 3 < len; i++)
+    {
+        if (text[i] == '(' && text[i + 1] == '&' && text[i + 2] != '&' && text[i + 3] == ')')
+        {
+            INT start = i, end = i + 4;
+
+            while (start > 0 && text[start - 1] == ' ') start--;
+            memmove(text + start, text + end, (len - end) * sizeof(WCHAR));
+            len -= end - start;
+            break;
+        }
+    }
+
+    for (i = j = 0; i < len; i++)
+    {
+        if (text[i] == '&' && ++i == len) break;
+        text[j++] = text[i];
+    }
+
+    return j;
+}
+
+
+/* A window's text as a CFString.  Not limited to a title's length: a message
+   box's text can run to a stack trace. */
+static CFStringRef copy_window_text(HWND hwnd, BOOL strip_mnemonics)
+{
+    static const INT max_len = 0x8000;
+    CFStringRef ret;
+    WCHAR *text;
+    INT len;
+
+    if (!(text = malloc(max_len * sizeof(WCHAR)))) return NULL;
+
+    len = NtUserInternalGetWindowText(hwnd, text, max_len);
+    if (strip_mnemonics) len = strip_mnemonic(text, len);
+    ret = CFStringCreateWithCharacters(NULL, (const UniChar *)text, len);
+
+    free(text);
+    return ret;
+}
+
+
+/* Takes a message box off the list.  Whoever gets it back owns its alert. */
+static struct native_msgbox *remove_native_msgbox(HWND hwnd, macdrv_alert alert)
+{
+    struct native_msgbox *msgbox, *found = NULL;
+
+    pthread_mutex_lock(&native_msgboxes_mutex);
+    LIST_FOR_EACH_ENTRY(msgbox, &native_msgboxes, struct native_msgbox, entry)
+    {
+        if (msgbox->hwnd == hwnd && (!alert || msgbox->alert == alert))
+        {
+            list_remove(&msgbox->entry);
+            found = msgbox;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&native_msgboxes_mutex);
+
+    return found;
+}
+
+
+/***********************************************************************
+ *              macdrv_native_msgbox
+ *
+ * Handler for WM_WINE_NATIVE_MSGBOX.  Everything shown is read back from the
+ * dialog user32 has just built rather than recomputed, so its translations
+ * come along, and so does anything that changed it first, such as a CBT hook
+ * relabelling the buttons.  Returns 1 if an alert is on its way.
+ */
+LRESULT macdrv_native_msgbox(HWND hwnd, UINT style)
+{
+    HWND child, text_hwnd = 0, buttons[ARRAY_SIZE(button_order)] = { 0 };
+    int ids[ARRAY_SIZE(button_order)];
+    int count = 0, default_index = -1, cancel_id = 0, alert_style;
+    CFStringRef caption = NULL, text = NULL;
+    struct macdrv_thread_data *thread_data;
+    struct native_msgbox *msgbox = NULL;
+    CFMutableArrayRef titles;
+    LRESULT ret = 0;
+    UINT i;
+
+    /* Help keeps the box open and sends WM_HELP, which only the dialog can do. */
+    if (!use_native_message_boxes || (style & MB_HELP)) return 0;
+
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child;
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        UINT id = NtUserGetWindowLongPtrW(child, GWLP_ID);
+
+        /* user32 destroys the buttons a style doesn't use, and hides Help. */
+        if (!(NtUserGetWindowLongW(child, GWL_STYLE) & WS_VISIBLE)) continue;
+
+        if (id == MSGBOX_IDTEXT) text_hwnd = child;
+        for (i = 0; i < ARRAY_SIZE(button_order); i++)
+            if (id == button_order[i]) buttons[i] = child;
+    }
+
+    if (!(titles = CFArrayCreateMutable(NULL, ARRAY_SIZE(button_order), &kCFTypeArrayCallBacks)))
+        return 0;
+
+    for (i = 0; i < ARRAY_SIZE(button_order); i++)
+    {
+        CFStringRef title;
+
+        if (!buttons[i]) continue;
+        if (!(title = copy_window_text(buttons[i], TRUE))) goto done;
+        CFArrayAppendValue(titles, title);
+        CFRelease(title);
+
+        if ((NtUserGetWindowLongW(buttons[i], GWL_STYLE) & BS_TYPEMASK) == BS_DEFPUSHBUTTON)
+            default_index = count;
+        if (button_order[i] == IDCANCEL) cancel_id = IDCANCEL;
+        ids[count++] = button_order[i];
+    }
+
+    /* A box with nothing to press could never be closed: leave it to the dialog. */
+    if (!count) goto done;
+    if (default_index < 0) default_index = 0;
+    /* Escape answers a lone OK, as it does on Windows; with no Cancel and more
+       than one button it does nothing. */
+    if (!cancel_id && count == 1 && ids[0] == IDOK) cancel_id = IDOK;
+
+    switch (style & MB_ICONMASK)
+    {
+    case MB_ICONHAND:           alert_style = ALERT_STYLE_CRITICAL; break;
+    case MB_ICONEXCLAMATION:    alert_style = ALERT_STYLE_WARNING; break;
+    default:                    alert_style = ALERT_STYLE_INFORMATIONAL; break;
+    }
+
+    caption = copy_window_text(hwnd, FALSE);
+    if (text_hwnd) text = copy_window_text(text_hwnd, FALSE);
+
+    if (!(msgbox = malloc(sizeof(*msgbox)))) goto done;
+
+    /* The answer comes back through this thread's event queue, so it needs one
+       even if the program hasn't opened a window of its own yet. */
+    thread_data = macdrv_init_thread_data();
+
+    msgbox->hwnd = hwnd;
+    msgbox->alert = macdrv_create_alert(thread_data->queue, hwnd, alert_style, caption, text,
+                                        titles, ids, default_index, cancel_id);
+    if (!msgbox->alert) goto done;
+
+    pthread_mutex_lock(&native_msgboxes_mutex);
+    list_add_tail(&native_msgboxes, &msgbox->entry);
+    pthread_mutex_unlock(&native_msgboxes_mutex);
+
+    TRACE("showing %p as an alert: %s, %d button(s), default %d, cancel %d\n", hwnd,
+          debugstr_cf(caption), count, default_index, cancel_id);
+    msgbox = NULL;
+    ret = 1;
+
+done:
+    free(msgbox);
+    if (caption) CFRelease(caption);
+    if (text) CFRelease(text);
+    CFRelease(titles);
+    return ret;
+}
+
+
+/***********************************************************************
+ *              macdrv_alert_response
+ *
+ * Handler for ALERT_RESPONSE events: the user answered an alert, or it
+ * couldn't be shown and the dialog has to be shown instead.
+ */
+void macdrv_alert_response(const macdrv_event *event)
+{
+    HWND hwnd = event->alert_response.hwnd;
+    int response = event->alert_response.response;
+    struct native_msgbox *msgbox;
+
+    /* Not listed any more: the dialog was ended some other way, which already
+       dismissed the alert. */
+    if (!(msgbox = remove_native_msgbox(hwnd, event->alert_response.alert))) return;
+
+    if (response)
+    {
+        TRACE("%p answered with %d\n", hwnd, response);
+        NtUserPostMessage(hwnd, WM_COMMAND, MAKEWPARAM(response, BN_CLICKED), 0);
+    }
+    else
+    {
+        WARN("%p couldn't be shown as an alert; showing the dialog instead\n", hwnd);
+        NtUserRemoveProp(hwnd, native_msgbox_propW);
+        NtUserShowWindow(hwnd, SW_SHOWNORMAL);
+    }
+
+    macdrv_release_alert(msgbox->alert);
+    free(msgbox);
+}
+
+
+/***********************************************************************
+ *              macdrv_native_msgbox_ended
+ *
+ * A message box's dialog has ended: user32 says so when EndDialog hides it,
+ * and it is called for every window destroyed besides.  One the program
+ * ended itself, from a timer or with a WM_CLOSE, takes its alert with it,
+ * and an answer still on its way for it is ignored.
+ */
+void macdrv_native_msgbox_ended(HWND hwnd)
+{
+    struct native_msgbox *msgbox;
+
+    if (!(msgbox = remove_native_msgbox(hwnd, NULL))) return;
+
+    TRACE("%p ended with its alert still up; dismissing it\n", hwnd);
+    macdrv_release_alert(msgbox->alert);
+    free(msgbox);
+}
