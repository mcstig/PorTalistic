+/* Message boxes presented by the display driver.
+ *
+ * The dialog is still built, initialised and run exactly as before: it is what
+ * disables the owner, what MB_TASKMODAL's window list hangs off, what EndDialog
+ * ends and what MessageBox's return value comes from.  Once it is ready it is
+ * offered to the driver, and a driver that can show the message box its own way
+ * (the Mac driver shows it as an NSAlert) answers nonzero.  The dialog then
+ * stays hidden, and the driver posts WM_COMMAND for the button that was
+ * pressed, which ends it like a click would.  Any other driver, or the Mac
+ * driver with UseNativeMessageBoxes=n, answers 0 and nothing changes.
+ *
+ * The message is in the range reserved for the USER driver, so it goes to the
+ * driver's WindowMessage entry point rather than to MSGBOX_DlgProc.  wparam is
+ * the MB_* style and lparam 0 to offer the message box, lparam 1 to say it has
+ * ended.  Both values must match dlls/winemac.drv/macdrv.h and
+ * dlls/winemac.drv/msgbox.c.
+ */
+#define WM_WINE_NATIVE_MSGBOX (WM_WINE_FIRST_DRIVER_MSG + 0xfe0)
+static const char native_msgbox_prop[] = "__wine_native_msgbox";
+
+static void MSGBOX_OfferToDriver( HWND hwnd, const MSGBOXPARAMSW *lpmb )
+{
+    DWORD_PTR accepted = 0;
+
+    /* The Help button keeps the box open and sends WM_HELP, which only the
+     * dialog itself can do. */
+    if (lpmb->dwStyle & MB_HELP) return;
+
+    /* SendMessageTimeout rather than SendMessage: a same-thread SendMessage can
+     * be handed straight to the window procedure without the driver seeing it. */
+    if (!SendMessageTimeoutW( hwnd, WM_WINE_NATIVE_MSGBOX, lpmb->dwStyle, 0, SMTO_NORMAL, 0, &accepted ) ||
+        !accepted)
+        return;
+
+    TRACE_(msgbox)("%p is being shown by the display driver\n", hwnd);
+    SetPropA( hwnd, native_msgbox_prop, (HANDLE)1 );
+}
+
 struct ThreadWindows
 {
     UINT numHandles;
