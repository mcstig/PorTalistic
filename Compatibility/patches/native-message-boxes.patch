+#import <AppKit/AppKit.h>
+#include "macdrv_cocoa.h"
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import "cocoa_window.h"
+
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+
+
+/* Past this, a message goes in a scrolling view.  The alert's own label grows
+   without limit, and a stack trace would push the buttons off the screen. */
+static const NSUInteger WineAlertLongTextLength = 1000;
+static const NSUInteger WineAlertLongTextLines = 20;
+
+
+/* Windows line endings as the alert expects them, without the blank lines
+   message boxes tend to end with. */
+static NSString* WineAlertCleanText(NSString* string)
+{
+    if (!string) return @"";
+    string = [string stringByReplacingOccurrencesOfString:@"\r\n" withString:@"\n"];
+    string = [string stringByReplacingOccurrencesOfString:@"\r" withString:@"\n"];
+    return [string stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+}
+
+static BOOL WineAlertTextIsLong(NSString* string)
+{
+    __block NSUInteger lines = 0;
+
+    if ([string length] > WineAlertLongTextLength) return YES;
+
+    [string enumerateLinesUsingBlock:^(NSString* line, BOOL* stop){
+        if (++lines > WineAlertLongTextLines) *stop = YES;
+    }];
+
+    return lines > WineAlertLongTextLines;
+}
+
+static NSView* WineAlertScrollingText(NSString* string)
+{
+    NSScrollView* scrollView = [[[NSScrollView alloc] initWithFrame:NSMakeRect(0, 0, 420, 240)] autorelease];
+    NSTextView* textView;
+    NSSize size;
+
+    scrollView.hasVerticalScroller = YES;
+    scrollView.autohidesScrollers = YES;
+    scrollView.borderType = NSBezelBorder;
+    size = [scrollView contentSize];
+
+    textView = [[[NSTextView alloc] initWithFrame:NSMakeRect(0, 0, size.width, size.height)] autorelease];
+    textView.minSize = NSMakeSize(0, size.height);
+    textView.maxSize = NSMakeSize(CGFLOAT_MAX, CGFLOAT_MAX);
+    textView.verticallyResizable = YES;
+    textView.horizontallyResizable = NO;
+    textView.autoresizingMask = NSViewWidthSizable;
+    textView.textContainer.widthTracksTextView = YES;
+    textView.editable = NO;
+    textView.selectable = YES;
+    textView.string = string;
+    textView.font = [NSFont systemFontOfSize:[NSFont smallSystemFontSize]];
+    textView.textColor = [NSColor labelColor];
+
+    scrollView.documentView = textView;
+    return scrollView;
+}
+
+
+@interface WineAlert : NSObject
+{
+    WineEventQueue* queue;
+    void* hwnd;
+    int style;
+    NSString* caption;
+    NSString* text;
+    NSArray* buttonTitles;
+    NSArray* buttonIDs;
+    NSInteger defaultIndex;
+    int cancelID;
+
+    NSAlert* alert;
+    id keyMonitor;
+    NSInteger attentionRequest;
+    BOOL finished;
+}
+
+    - (id) initWithQueue:(WineEventQueue*)inQueue hwnd:(void*)inHwnd style:(int)inStyle
+                 caption:(NSString*)inCaption text:(NSString*)inText
+            buttonTitles:(NSArray*)inButtonTitles buttonIDs:(NSArray*)inButtonIDs
+            defaultIndex:(NSInteger)inDefaultIndex cancelID:(int)inCancelID;
+
+    - (void) show;
+    - (void) dismiss;
+
+@end
+
+
+@implementation WineAlert
+
+    - (id) initWithQueue:(WineEventQueue*)inQueue hwnd:(void*)inHwnd style:(int)inStyle
+                 caption:(NSString*)inCaption text:(NSString*)inText
+            buttonTitles:(NSArray*)inButtonTitles buttonIDs:(NSArray*)inButtonIDs
+            defaultIndex:(NSInteger)inDefaultIndex cancelID:(int)inCancelID
+    {
+        self = [super init];
+        if (self)
+        {
+            queue = [inQueue retain];
+            hwnd = inHwnd;
+            style = inStyle;
+            caption = [inCaption copy];
+            text = [inText copy];
+            buttonTitles = [inButtonTitles copy];
+            buttonIDs = [inButtonIDs copy];
+            defaultIndex = inDefaultIndex;
+            cancelID = inCancelID;
+        }
+        return self;
+    }
+
+    - (void) dealloc
+    {
+        [alert release];
+        [queue release];
+        [caption release];
+        [text release];
+        [buttonTitles release];
+        [buttonIDs release];
+        [super dealloc];
+    }
+
+    /* The screen the game is on, not necessarily the one with the menu bar. */
+    - (NSScreen*) targetScreen
+    {
+        NSScreen* screen = [[[WineApplicationController sharedController] frontWineWindow] screen];
+        return screen ? screen : [[NSScreen screens] firstObject];
+    }
+
+    /* Above anything Wine puts a window at, and it puts some high: a topmost
+       window goes above the Dock, a fullscreen one above the menu bar and the
+       status items (one more if it is topmost too), and one on a captured
+       display above the shield. Wine re-levels its windows every time the app
+       is activated, so aim above where they can go, not just where they are. */
+    - (NSInteger) windowLevelFor:(NSWindow*)window
+    {
+        NSInteger level = NSStatusWindowLevel + 3;
+        NSWindow* other;
+
+        if ([[WineApplicationController sharedController] areDisplaysCaptured])
+            level = MAX(level, CGShieldingWindowLevel() + 3);
+
+        for (other in [NSApp windows])
+        {
+            if (other != window && [other isVisible] && [other level] >= level)
+                level = [other level] + 1;
+        }
+
+        return level;
+    }
+
+    - (void) show
+    {
+        WineApplicationController* controller = [WineApplicationController sharedController];
+        NSString* headline = WineAlertCleanText(caption);
+        NSString* body = WineAlertCleanText(text);
+        NSWindow* window;
+        NSRect visible, frame;
+        NSUInteger i;
+
+        if (finished) return;
+
+        @try
+        {
+            alert = [[NSAlert alloc] init];
+
+            switch (style)
+            {
+                case ALERT_STYLE_CRITICAL:  alert.alertStyle = NSAlertStyleCritical; break;
+                case ALERT_STYLE_WARNING:   alert.alertStyle = NSAlertStyleWarning; break;
+                default:                    alert.alertStyle = NSAlertStyleInformational; break;
+            }
+
+            /* The caption is the headline, as in any Mac alert, and the message goes
+               under it. A box with no caption has only the message to lead with. */
+            if (WineAlertTextIsLong(body))
+            {
+                alert.accessoryView = WineAlertScrollingText(body);
+                body = @"";
+            }
+            else if (![headline length])
+            {
+                headline = body;
+                body = @"";
+            }
+            alert.messageText = headline;
+            alert.informativeText = body;
+
+            /* The first button is rightmost, and the default is whichever one the
+               message box made default, not necessarily the first. Escape is handled
+               below, so that it can answer OK where Windows would. */
+            for (i = 0; i < [buttonTitles count]; i++)
+            {
+                NSButton* button = [alert addButtonWithTitle:buttonTitles[i]];
+                button.tag = [buttonIDs[i] integerValue];
+                button.target = self;
+                button.action = @selector(buttonPressed:);
+                button.keyEquivalent = ((NSInteger)i == defaultIndex) ? @"\r" : @"";
+            }
+
+            [alert layout];
+            window = [alert window];
+            window.releasedWhenClosed = NO;
+            window.collectionBehavior |= NSWindowCollectionBehaviorMoveToActiveSpace |
+                                         NSWindowCollectionBehaviorFullScreenAuxiliary;
+            window.level = [self windowLevelFor:window];
+            /* It floats that high only while we are active; on deactivation it
+               hides, as any alert does, rather than covering other apps. */
+            window.hidesOnDeactivate = YES;
+            /* Mouse moves go to the key window. Taking them is what lets Wine see
+               the pointer is over something that isn't a Windows window, and show
+               it: a game that hid the cursor would otherwise leave it hidden here. */
+            window.acceptsMouseMovedEvents = YES;
+
+            /* Centred across and a little above centre, where AppKit puts an alert,
+               but on the game's screen. */
+            visible = [[self targetScreen] visibleFrame];
+            frame = [window frame];
+            frame.origin.x = NSMidX(visible) - NSWidth(frame) / 2;
+            frame.origin.y = NSMinY(visible) + (NSHeight(visible) - NSHeight(frame)) * 2 / 3;
+            [window setFrameOrigin:frame.origin];
+
+            keyMonitor = [[NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown
+                                                                handler:^NSEvent*(NSEvent* event){
+                return [self handleKeyDown:event] ? nil : event;
+            }] retain];
+
+            /* What showing any Windows window does. If macOS won't bring us forward,
+               bounce in the Dock until the user does: the program is waiting on this. */
+            [controller transformProcessToForeground:YES];
+            if ([NSApp isHidden])
+                [NSApp unhide:nil];
+            [controller tryToActivateIgnoringOtherApps:YES];
+            [window makeKeyAndOrderFront:nil];
+            attentionRequest = [NSApp requestUserAttention:NSCriticalRequest];
+        }
+        @catch (id e)
+        {
+            ERR(@"Couldn't show a message box as an alert, so the dialog will be shown: %@\n", e);
+            [self finishWithResponse:0];
+        }
+    }
+
+    - (BOOL) handleKeyDown:(NSEvent*)event
+    {
+        NSEventModifierFlags modifiers;
+        NSString* characters;
+
+        if (finished || [event window] != [alert window]) return NO;
+
+        /* A key held down since before the alert came up repeats into it. That is the
+           game's key, perhaps the very Escape or Return that brought the box up, and
+           it must not answer it. */
+        if ([event isARepeat]) return YES;
+
+        modifiers = [event modifierFlags] & (NSEventModifierFlagShift | NSEventModifierFlagControl |
+                                             NSEventModifierFlagOption | NSEventModifierFlagCommand);
+        characters = [event charactersIgnoringModifiers];
+
+        /* Escape, and Command-period, answer Cancel if there is one and OK if that's
+           the only button. Otherwise nothing, as on Windows. */
+        if ((!modifiers && [event keyCode] == kVK_Escape) ||
+            (modifiers == NSEventModifierFlagCommand && [characters isEqualToString:@"."]))
+        {
+            if (cancelID)
+                [self finishWithResponse:cancelID];
+            else
+                NSBeep();
+            return YES;
+        }
+
+        /* Command-C copies the whole message, as Control-C does on Windows. Useful
+           for passing on an error nobody could otherwise select. */
+        if (modifiers == NSEventModifierFlagCommand && [[characters lowercaseString] isEqualToString:@"c"])
+        {
+            NSString* title = WineAlertCleanText(caption);
+            NSString* message = WineAlertCleanText(text);
+            NSPasteboard* pasteboard = [NSPasteboard generalPasteboard];
+
+            if ([title length])
+                message = [NSString stringWithFormat:@"%@\n\n%@", title, message];
+            [pasteboard clearContents];
+            [pasteboard setString:message forType:NSPasteboardTypeString];
+            return YES;
+        }
+
+        return NO;
+    }
+
+    - (void) buttonPressed:(id)sender
+    {
+        [self finishWithResponse:(int)[sender tag]];
+    }
+
+    - (void) closeWindow
+    {
+        if (keyMonitor)
+        {
+            [NSEvent removeMonitor:keyMonitor];
+            [keyMonitor release];
+            keyMonitor = nil;
+        }
+
+        if (attentionRequest)
+        {
+            [NSApp cancelUserAttentionRequest:attentionRequest];
+            attentionRequest = 0;
+        }
+
+        /* Closed rather than ordered out: the application controller keeps a list
+           of windows that have been key, and only forgets one when it closes. */
+        [[alert window] close];
+    }
+
+    /* 0 for response means the alert couldn't be shown. The answer is queued
+       before the window closes, so the dialog ends ahead of the focus changes
+       the closing causes, and Windows gives focus back the way it always does. */
+    - (void) finishWithResponse:(int)response
+    {
+        macdrv_event* event;
+
+        if (finished) return;
+        finished = YES;
+
+        event = macdrv_create_event(ALERT_RESPONSE, nil);
+        event->alert_response.alert = (macdrv_alert)self;
+        event->alert_response.hwnd = hwnd;
+        event->alert_response.response = response;
+        [queue postEvent:event];
+        macdrv_release_event(event);
+
+        [self closeWindow];
+    }
+
+    - (void) dismiss
+    {
+        if (finished) return;
+        finished = YES;
+        [self closeWindow];
+    }
+
+@end
+
+
+/***********************************************************************
+ *              macdrv_create_alert
+ *
+ * Show a Windows message box as an alert, without waiting for it. The
+ * button the user picks comes back as an ALERT_RESPONSE event on queue,
+ * carrying its entry from button_ids. The caller owns the result and gives
+ * it back, answered or not, with macdrv_release_alert.
+ */
+macdrv_alert macdrv_create_alert(macdrv_event_queue queue, void *hwnd, int style,
+                                 CFStringRef caption, CFStringRef text,
+                                 CFArrayRef button_titles, const int *button_ids,
+                                 int default_button, int cancel_id)
+{
+@autoreleasepool
+{
+    NSMutableArray* ids = [NSMutableArray array];
+    WineAlert* alert;
+    macdrv_alert a;
+    CFIndex i;
+
+    for (i = 0; i < CFArrayGetCount(button_titles); i++)
+        [ids addObject:[NSNumber numberWithInt:button_ids[i]]];
+
+    alert = [[WineAlert alloc] initWithQueue:(WineEventQueue*)queue hwnd:hwnd style:style
+                                     caption:(NSString*)caption text:(NSString*)text
+                                buttonTitles:(NSArray*)button_titles buttonIDs:ids
+                                defaultIndex:default_button cancelID:cancel_id];
+    if (!alert) return NULL;
+
+    /* The block holds the pointer, not a reference: the caller's reference keeps
+       it alive until macdrv_release_alert, whose block runs after this one. */
+    a = (macdrv_alert)alert;
+    OnMainThreadAsync(^{
+        [(WineAlert*)a show];
+    });
+
+    return a;
+}
+}
+
+/***********************************************************************
+ *              macdrv_release_alert
+ *
+ * Dismiss an alert if it is still up, and release it. On the main thread,
+ * where an NSAlert has to be let go of.
+ */
+void macdrv_release_alert(macdrv_alert a)
+{
+    /* The block holds the pointer, not a reference. Holding one would let the
+       block's own release, which can happen on this thread, be the last. */
+    OnMainThreadAsync(^{
+        WineAlert* alert = (WineAlert*)a;
+        [alert dismiss];
+        [alert release];
+    });
+}
